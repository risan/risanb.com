{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "risanb-stats",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-22",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "risanb-stats-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
