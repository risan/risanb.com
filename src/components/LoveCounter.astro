---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<div class="love-counter-widget" data-slug={slug}>
  <button
    type="button"
    class="post-meta-pill love-button"
    aria-label="Love this post"
    title="Send some love!"
  >
    <span class="love-icon-wrapper" aria-hidden="true">
      <svg class="love-heart-svg" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
        <path
          d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"
        ></path>
      </svg>
    </span>
    <span class="love-count-badge" aria-live="polite">0</span>
    <span class="love-burst-container" aria-hidden="true"></span>
  </button>
</div>

<script>
  import { fetchStats, postStatsEvent } from '../lib/stats-api';

  const MAX_LIKES_PER_USER = 10;
  const SYNC_DELAY_MS = 600;
  const CONFETTI_COLORS = ['#c8502e', '#e07a5f', '#f5b842', '#3d6b5e', '#dfd8cc', '#ffffff'];

  const widget = document.querySelector<HTMLElement>('.love-counter-widget[data-slug]');
  const button = widget?.querySelector<HTMLButtonElement>('.love-button');
  const countEl = widget?.querySelector<HTMLElement>('.love-count-badge');
  const burstEl = widget?.querySelector<HTMLElement>('.love-burst-container');
  const slug = widget?.dataset.slug;

  let audioContext: AudioContext | null = null;

  function playTone(frequency: number, delay: number, peakGain: number, length: number, glideTo?: number) {
    try {
      audioContext ??= new AudioContext();
      audioContext.resume().catch(() => {});

      const start = audioContext.currentTime + delay;
      const oscillator = audioContext.createOscillator();
      const gain = audioContext.createGain();

      oscillator.type = 'triangle';
      oscillator.frequency.setValueAtTime(frequency, start);

      if (glideTo) {
        oscillator.frequency.exponentialRampToValueAtTime(glideTo, start + 0.12);
      }

      gain.gain.setValueAtTime(0.001, start);
      gain.gain.exponentialRampToValueAtTime(peakGain, start + 0.015);
      gain.gain.exponentialRampToValueAtTime(0.001, start + length);
      oscillator.connect(gain);
      gain.connect(audioContext.destination);
      oscillator.start(start);
      oscillator.stop(start + length + 0.01);
    } catch {}
  }

  const playLoveSound = () => playTone(880, 0, 0.08, 0.35, 1318.51);

  const playLockedSound = () => {
    playTone(370, 0, 0.06, 0.075);
    playTone(277.18, 0.09, 0.06, 0.075);
  };

  const playMaxSound = () => {
    [523.25, 659.25, 783.99, 1046.5].forEach((frequency, i) => {
      playTone(frequency, i * 0.055, 0.07, 0.28);
    });
  };

  function initLoveCounter(
    slug: string,
    button: HTMLButtonElement,
    countEl: HTMLElement,
    burstEl: HTMLElement,
  ) {
    const userLikesKey = `likes_given:${slug}`;
    let userLikes = 0;

    try {
      userLikes = parseInt(localStorage.getItem(userLikesKey) ?? '', 10) || 0;
    } catch {}

    // The shown count is what the server last confirmed, plus likes not yet confirmed.
    let serverLikes = 0;
    let unsentLikes = 0;
    let inFlightLikes = 0;
    let syncTimer: number | undefined;
    let burstTimer: number | undefined;

    const renderCount = () => {
      countEl.textContent = (serverLikes + unsentLikes + inFlightLikes).toLocaleString('en-US');
    };

    if (userLikes > 0) {
      button.classList.add('has-loved');
    }

    void fetchStats(slug).then((stats) => {
      if (typeof stats?.likes === 'number') {
        serverLikes = Math.max(serverLikes, stats.likes);
        renderCount();
      }
    });

    async function syncLikes(keepalive = false) {
      clearTimeout(syncTimer);

      if (unsentLikes === 0) {
        return;
      }

      const count = unsentLikes;
      unsentLikes = 0;
      inFlightLikes += count;

      const stats = await postStatsEvent('likes', { slug, count }, { keepalive });

      inFlightLikes -= count;

      if (typeof stats?.likes === 'number') {
        serverLikes = stats.likes;
      }

      renderCount();
    }

    // The debounce can still be pending when the reader leaves the page.
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'hidden') {
        void syncLikes(true);
      }
    });

    const restartAnimation = (className: 'is-bouncing' | 'is-shaking') => {
      button.classList.remove('is-bouncing', 'is-shaking');
      void button.offsetWidth;
      button.classList.add(className);
    };

    const showBurst = (particles: HTMLElement[], lifetimeMs: number) => {
      clearTimeout(burstTimer);
      burstEl.replaceChildren(...particles);
      burstTimer = window.setTimeout(() => burstEl.replaceChildren(), lifetimeMs);
    };

    const createParticle = (className: string, text = '') => {
      const particle = document.createElement('span');
      particle.className = className;
      particle.textContent = text;

      return particle;
    };

    const showMaxBurst = () => {
      const words = ['MAX!', 'MAX', 'MAX! ✨', 'MAX', 'MAX!'];

      showBurst(
        words.map((word, i) => {
          const particle = createParticle('max-word-particle', word);
          const angle = (i / words.length) * 2 * Math.PI - Math.PI / 2 + (Math.random() * 0.3 - 0.15);
          const distance = 32 + Math.random() * 24;

          particle.style.setProperty('--dx', `${Math.cos(angle) * distance}px`);
          particle.style.setProperty('--dy', `${Math.sin(angle) * distance}px`);
          particle.style.setProperty('--color', 'var(--accent, #c8502e)');
          particle.style.setProperty('--rot', `${Math.floor((Math.random() - 0.5) * 36)}deg`);

          return particle;
        }),
        850,
      );
    };

    const showLoveBurst = () => {
      const particleCount = 14;
      const particles = Array.from({ length: particleCount }, (_, i) => {
        const particle = createParticle('firework-particle');
        const angle = (i / particleCount) * 2 * Math.PI + (Math.random() * 0.4 - 0.2);
        const distance = 26 + Math.random() * 34;

        particle.style.setProperty('--dx', `${Math.cos(angle) * distance}px`);
        // Slight upward bias.
        particle.style.setProperty('--dy', `${Math.sin(angle) * distance - 8}px`);
        particle.style.setProperty(
          '--color',
          CONFETTI_COLORS[Math.floor(Math.random() * CONFETTI_COLORS.length)]!,
        );
        particle.style.setProperty('--size', `${4 + Math.random() * 4}px`);
        particle.style.setProperty('--rot', `${Math.floor(Math.random() * 360)}deg`);

        return particle;
      });

      showBurst([createParticle('love-floater', '+1'), ...particles], 750);
    };

    button.addEventListener('click', (event) => {
      event.preventDefault();

      if (userLikes >= MAX_LIKES_PER_USER) {
        restartAnimation('is-shaking');
        showMaxBurst();
        playLockedSound();

        return;
      }

      userLikes++;
      unsentLikes++;

      try {
        localStorage.setItem(userLikesKey, String(userLikes));
      } catch {}

      renderCount();
      button.classList.add('has-loved');

      if (userLikes >= MAX_LIKES_PER_USER) {
        restartAnimation('is-shaking');
        showMaxBurst();
        playMaxSound();
      } else {
        restartAnimation('is-bouncing');
        showLoveBurst();
        playLoveSound();
      }

      // Batch rapid taps into a single request.
      clearTimeout(syncTimer);
      syncTimer = window.setTimeout(() => void syncLikes(), SYNC_DELAY_MS);
    });
  }

  if (button && countEl && burstEl && slug) {
    initLoveCounter(slug, button, countEl, burstEl);
  }
</script>

<style>
  .love-counter-widget {
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
  }

  .love-button {
    position: relative;
    gap: 6px;
  }

  .love-button:hover {
    transform: translateY(-1px);
  }

  .love-button:hover .love-count-badge {
    color: var(--accent);
  }

  .love-button:active {
    transform: scale(0.96);
  }

  .love-icon-wrapper {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .love-heart-svg {
    fill: var(--ink-muted);
    opacity: 0.55;
    transition:
      fill 0.2s ease,
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .love-button:hover .love-heart-svg {
    fill: var(--accent);
    opacity: 1;
    transform: scale(1.1);
  }

  .love-button.has-loved .love-heart-svg {
    fill: var(--accent);
    opacity: 1;
  }

  .love-button.is-bouncing .love-icon-wrapper {
    animation: heart-bounce 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .love-button.is-shaking {
    animation: button-shake 0.35s ease;
  }

  .love-button.is-shaking .love-icon-wrapper {
    animation: icon-shake 0.4s ease;
  }

  @keyframes icon-shake {
    0%,
    100% {
      transform: translateX(0) rotate(0);
    }
    20% {
      transform: translateX(-4px) rotate(-14deg);
    }
    40% {
      transform: translateX(4px) rotate(14deg);
    }
    60% {
      transform: translateX(-3px) rotate(-8deg);
    }
    80% {
      transform: translateX(3px) rotate(8deg);
    }
  }

  @keyframes heart-bounce {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(1.45) rotate(-10deg);
    }
    70% {
      transform: scale(0.9) rotate(4deg);
    }
    100% {
      transform: scale(1) rotate(0deg);
    }
  }

  @keyframes button-shake {
    0%,
    100% {
      transform: translateX(0);
    }
    25% {
      transform: translateX(-4px);
    }
    75% {
      transform: translateX(4px);
    }
  }

  .love-count-badge {
    font-variant-numeric: tabular-nums;
    font-size: 0.8125rem;
    color: var(--ink);
  }

  .love-burst-container {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: visible;
  }

  /* The particles are created from the script, so they carry no scoping attribute. */
  :global(.max-word-particle) {
    position: absolute;
    top: 50%;
    left: 16px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 800;
    color: var(--color, var(--accent));
    transform: translate(-50%, -50%);
    pointer-events: none;
    white-space: nowrap;
    z-index: 10;
    animation: max-word-burst 0.8s cubic-bezier(0.12, 0.8, 0.32, 1) forwards;
  }

  @keyframes max-word-burst {
    0% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(0.6) rotate(0deg);
    }
    45% {
      opacity: 1;
      transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(1.15)
        rotate(var(--rot));
    }
    100% {
      opacity: 0;
      transform: translate(calc(-50% + var(--dx) * 1.3), calc(-50% + var(--dy) * 1.3 - 8px))
        scale(0.85) rotate(calc(var(--rot) * 1.4));
    }
  }

  :global(.love-floater) {
    position: absolute;
    top: 50%;
    left: 16px;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--accent);
    transform: translate(-50%, -50%);
    animation: float-up-fade 0.65s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  @keyframes float-up-fade {
    0% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(0.8);
    }
    50% {
      opacity: 1;
      transform: translate(-50%, -150%) scale(1.2);
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -230%) scale(0.9);
    }
  }

  :global(.firework-particle) {
    position: absolute;
    top: 50%;
    left: 16px;
    width: var(--size, 6px);
    height: var(--size, 6px);
    background-color: var(--color, var(--accent));
    border-radius: 50%;
    transform: translate(-50%, -50%);
    animation: particle-burst 0.65s cubic-bezier(0.12, 0.8, 0.32, 1) forwards;
  }

  @keyframes particle-burst {
    0% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(0.5) rotate(0deg);
    }
    50% {
      opacity: 1;
      transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(1.2)
        rotate(var(--rot));
    }
    100% {
      opacity: 0;
      transform: translate(calc(-50% + var(--dx) * 1.2), calc(-50% + var(--dy) * 1.2 + 8px))
        scale(0) rotate(calc(var(--rot) * 1.5));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .love-button.is-bouncing .love-icon-wrapper,
    .love-button.is-shaking,
    .love-button.is-shaking .love-icon-wrapper,
    :global(.max-word-particle),
    :global(.love-floater),
    :global(.firework-particle) {
      animation: none !important;
    }
  }
</style>
