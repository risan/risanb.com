---
// Interactive Clippy assistant with cursor-following eyes, retro sound synthesis,
// drag-and-drop mobility, blog-aligned monograph aesthetics, and magical genie emergence.
---

<div
  id="clippy-widget"
  class="clippy-widget is-hidden"
  role="region"
  aria-label="Clippy assistant"
>
  <!-- Speech Bubble (Blog monograph design, absolutely positioned relative to character) -->
  <div
    id="clippy-bubble"
    class="clippy-bubble is-hidden"
    role="dialog"
    aria-labelledby="clippy-quote"
  >
    <!-- Top-right corner controls (Mute & Close) -->
    <div class="clippy-corner-tools">
      <button
        id="clippy-sound-toggle"
        class="clippy-tool-btn"
        type="button"
        aria-label="Toggle sound"
        title="Toggle sound"
      >
        <span class="icon-sound-on" aria-hidden="true">🔊</span>
        <span class="icon-sound-off" aria-hidden="true" style="display: none;">🔇</span>
      </button>
      <button
        id="clippy-close-btn"
        class="clippy-tool-btn"
        type="button"
        aria-label="Dismiss Clippy"
        title="Dismiss Clippy"
      >
        ✕
      </button>
    </div>

    <!-- Speech content -->
    <div class="clippy-bubble-body">
      <p id="clippy-quote" class="clippy-quote">
        100% test coverage is a waste of time.
      </p>
    </div>

    <!-- Actions: Share on X and dismissive button -->
    <div class="clippy-bubble-footer">
      <button
        id="clippy-share-btn"
        class="clippy-share-btn"
        type="button"
        aria-label="Share this hot take on X"
        title="Share this hot take on X"
      >
        <svg class="x-icon" width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
        <span>Share</span>
      </button>
      <button id="clippy-ack-btn" class="clippy-ack-btn" type="button">
        Whatever
      </button>
    </div>

    <!-- Directional seamless callout tail (rotated square with zero base border) -->
    <div class="clippy-bubble-tail" aria-hidden="true"></div>
  </div>

  <!-- Draggable Clippy Character -->
  <div
    id="clippy-character"
    class="clippy-character"
    role="button"
    tabindex="0"
    aria-label="Clippy: drag to reposition or click for hot take"
    title="Drag me anywhere or click for hot takes!"
  >
    <svg
      id="clippy-svg"
      class="clippy-svg"
      width="78"
      height="88"
      viewBox="0 0 32 36"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <defs>
        <linearGradient
          id="clippyWireGrad"
          x1="6"
          y1="2"
          x2="26"
          y2="34"
          gradientUnits="userSpaceOnUse"
        >
          <stop offset="0%" stop-color="#E2E7EE" />
          <stop offset="35%" stop-color="#9BA6B5" />
          <stop offset="70%" stop-color="#BAC3D0" />
          <stop offset="100%" stop-color="#6F7A8B" />
        </linearGradient>
      </defs>

      <!-- Main Wire Loop (Clean vector path without internal clipped SVG filters) -->
      <path
        class="clippy-wire"
        d="M12 25V13C12 10.7909 13.7909 9 16 9C18.2091 9 20 10.7909 20 13V26C20 29.3137 17.3137 32 14 32C10.6863 32 8 29.3137 8 26V7C8 3.68629 10.6863 1 14 1C17.3137 1 20 3.68629 20 7V22"
        stroke="url(#clippyWireGrad)"
        stroke-width="2.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />

      <!-- Specular Highlight Line -->
      <path
        d="M8.8 24V7C8.8 4.1 11.1 1.8 14 1.8C16.9 1.8 19.2 4.1 19.2 7V20"
        stroke="#FFFFFF"
        stroke-width="0.8"
        stroke-linecap="round"
        opacity="0.85"
      />

      <!-- Expressive Eyebrows -->
      <g class="clippy-brows">
        <path
          class="brow-left"
          d="M10 7.5C11 6.2 13 6.4 14.5 7.2"
          stroke="#1A1918"
          stroke-width="1.6"
          stroke-linecap="round"
        />
        <path
          class="brow-right"
          d="M17.5 6.2C19 5.2 21.2 5.6 22.5 7"
          stroke="#1A1918"
          stroke-width="1.6"
          stroke-linecap="round"
        />
      </g>

      <!-- Eyes Container (Blinks) -->
      <g class="clippy-eyes">
        <!-- Left Eye Socket -->
        <ellipse
          id="clippy-eye-left"
          class="clippy-eye-white eye-left"
          cx="12.5"
          cy="12.5"
          rx="3.5"
          ry="4.2"
          fill="#FFFFFF"
          stroke="#1A1918"
          stroke-width="1"
        />
        <!-- Left Pupil Group (Follows Cursor) -->
        <g id="clippy-pupil-left" class="clippy-pupil pupil-left">
          <circle cx="12.8" cy="12.6" r="1.8" fill="#1A1918" />
          <circle cx="12.0" cy="11.7" r="0.65" fill="#FFFFFF" />
        </g>

        <!-- Right Eye Socket -->
        <ellipse
          id="clippy-eye-right"
          class="clippy-eye-white eye-right"
          cx="19.5"
          cy="12"
          rx="3.5"
          ry="4.2"
          fill="#FFFFFF"
          stroke="#1A1918"
          stroke-width="1"
        />
        <!-- Right Pupil Group (Follows Cursor) -->
        <g id="clippy-pupil-right" class="clippy-pupil pupil-right">
          <circle cx="19.1" cy="12.2" r="1.8" fill="#1A1918" />
          <circle cx="18.3" cy="11.3" r="0.65" fill="#FFFFFF" />
        </g>
      </g>
    </svg>
  </div>
</div>

<style>
  /* Base widget container fixed on screen: sized to the character */
  .clippy-widget {
    position: fixed;
    right: 28px;
    bottom: 24px;
    width: 78px;
    height: 88px;
    z-index: 85;
    pointer-events: none;
    user-select: none;
    touch-action: none;
    transition: opacity 0.25s ease;
  }

  .clippy-widget.is-unloaded,
  .clippy-widget.is-hidden {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    display: none;
  }

  .clippy-widget.is-entering {
    display: block;
    pointer-events: auto;
    visibility: visible;
  }

  .clippy-widget.is-visible {
    display: block;
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  /* Clippy Character Styling & Natural Vector Drop-Shadow */
  .clippy-character {
    position: relative;
    width: 78px;
    height: 88px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
    pointer-events: auto;
    outline: none;
    transition: transform 0.15s ease-out;
    -webkit-tap-highlight-color: transparent;
    transform-origin: center center;
  }

  .clippy-character:focus-visible {
    box-shadow: 0 0 0 3px rgba(200, 80, 46, 0.4);
    border-radius: 9999px;
  }

  .clippy-character:active,
  .clippy-widget.is-dragging .clippy-character {
    cursor: grabbing;
    transform: scale(1.08) rotate(-4deg);
  }

  /* Smooth vector drop-shadow that follows exact path curves without clipping */
  .clippy-svg {
    display: block;
    overflow: visible;
    transform-origin: 16px 26px;
    filter: drop-shadow(0 4px 10px rgba(27, 28, 29, 0.18));
  }

  :global(.dark) .clippy-svg {
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.5));
  }

  /* Click celebration wiggle */
  .clippy-widget .clippy-character.is-wiggling {
    animation: clippy-wiggle 0.5s cubic-bezier(0.36, 0.07, 0.19, 0.97) !important;
  }

  @keyframes clippy-wiggle {
    0% { transform: scale(1) rotate(0deg); }
    20% { transform: scale(1.18) rotate(-14deg); }
    40% { transform: scale(1.18) rotate(12deg); }
    60% { transform: scale(1.1) rotate(-8deg); }
    80% { transform: scale(1.04) rotate(4deg); }
    100% { transform: scale(1) rotate(0deg); }
  }

  /* Idle floating animation (paused during drag and when wiggling) */
  .clippy-widget.is-visible:not(.is-dragging) .clippy-character:not(.is-wiggling) {
    animation: clippy-float 4.2s infinite ease-in-out;
  }

  @keyframes clippy-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }

  /* Eyebrows wiggle */
  .clippy-brows {
    transform-origin: 16px 7px;
    animation: clippy-brow 4.4s infinite ease-in-out;
  }

  @keyframes clippy-brow {
    0%, 78%, 100% { transform: translateY(0); }
    84%, 92% { transform: translateY(-2.2px); }
  }

  /* Eyes blinking */
  .clippy-eyes {
    transform-origin: 16px 12.5px;
    animation: clippy-blink 3.8s infinite ease-in-out;
  }

  @keyframes clippy-blink {
    0%, 88%, 100% { transform: scaleY(1); }
    94% { transform: scaleY(0.08); }
  }

  /* Pupils smooth transformation */
  .clippy-pupil {
    transition: transform 0.06s ease-out;
  }

  /* Speech Bubble Styling: matches blog monograph palette (var(--paper), var(--rule), var(--ink)) */
  .clippy-bubble {
    position: absolute;
    width: 260px;
    max-width: calc(100vw - 32px);
    background: var(--paper, #fbf9f5);
    border: 1px solid var(--rule, #e4ded3);
    border-radius: 6px;
    padding: 14px 16px 12px 14px;
    box-shadow:
      0 12px 32px -6px color-mix(in srgb, var(--ink, #1b1c1d) 16%, transparent),
      0 3px 8px -2px color-mix(in srgb, var(--ink, #1b1c1d) 8%, transparent);
    color: var(--ink, #1b1c1d);
    pointer-events: auto;
    transition: opacity 0.22s ease, transform 0.22s ease;
    z-index: 10;
  }

  .clippy-bubble.is-hidden {
    display: none;
  }

  .clippy-bubble.is-popping-out {
    animation: bubble-popdown 0.24s ease-in forwards;
    pointer-events: none;
  }

  .clippy-bubble.is-popping-in {
    animation: bubble-popup 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  /* Bubble popdown animation */
  @keyframes bubble-popdown {
    0% {
      opacity: 1;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(0.7) translateY(12px);
    }
  }

  /* Default placement: Bubble is above Clippy, aligned with right edge */
  .clippy-widget:not(.bubble-bottom):not(.bubble-left) .clippy-bubble {
    bottom: calc(100% + 14px);
    right: 0;
    transform-origin: bottom right;
  }

  /* Bubble is above Clippy, aligned with left edge */
  .clippy-widget.bubble-left:not(.bubble-bottom) .clippy-bubble {
    bottom: calc(100% + 14px);
    left: 0;
    transform-origin: bottom left;
  }

  /* Bubble is below Clippy, aligned with right edge */
  .clippy-widget.bubble-bottom:not(.bubble-left) .clippy-bubble {
    top: calc(100% + 14px);
    right: 0;
    transform-origin: top right;
  }

  /* Bubble is below Clippy, aligned with left edge */
  .clippy-widget.bubble-bottom.bubble-left .clippy-bubble {
    top: calc(100% + 14px);
    left: 0;
    transform-origin: top left;
  }

  @keyframes bubble-popup {
    0% {
      opacity: 0;
      transform: scale(0.4) translateY(18px);
    }
    65% {
      opacity: 1;
      transform: scale(1.04) translateY(-2px);
    }
    85% {
      transform: scale(0.98) translateY(1px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  /* Top-right corner tools (sound toggle & close) */
  .clippy-corner-tools {
    position: absolute;
    top: 7px;
    right: 7px;
    display: flex;
    align-items: center;
    gap: 2px;
    z-index: 5;
  }

  .clippy-tool-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    padding: 0;
    border: none;
    background: transparent;
    border-radius: 3px;
    font-size: 0.75rem;
    color: var(--ink-muted, #6b6862);
    cursor: pointer;
    line-height: 1;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .clippy-tool-btn:hover {
    background-color: var(--sunk, #f3efe7);
    color: var(--ink, #1b1c1d);
  }

  /* Bubble text body */
  .clippy-bubble-body {
    padding-right: 36px;
    min-height: 42px;
    display: flex;
    align-items: center;
  }

  .clippy-quote {
    margin: 0;
    font-family: var(--font-serif, 'Newsreader Variable', Georgia, serif);
    font-size: 0.9375rem;
    line-height: 1.45;
    font-weight: 500;
    color: var(--ink, #1b1c1d);
  }

  /* Bubble footer with share button and dismissive button */
  .clippy-bubble-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 10px;
    padding-top: 4px;
  }

  .clippy-share-btn {
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: transparent;
    border: 1px solid var(--rule, #e4ded3);
    border-radius: 4px;
    padding: 3px 8px;
    font-family: var(--font-mono, 'JetBrains Mono Variable', monospace);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--ink-muted, #6b6862);
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.1s ease;
  }

  .clippy-share-btn:hover {
    background: var(--sunk, #f3efe7);
    border-color: var(--ink, #1b1c1d);
    color: var(--ink, #1b1c1d);
  }

  .clippy-share-btn:active {
    transform: scale(0.96);
  }

  .clippy-share-btn .x-icon {
    flex-shrink: 0;
  }

  .clippy-ack-btn {
    appearance: none;
    background: var(--sunk, #f3efe7);
    border: 1px solid var(--rule, #e4ded3);
    border-radius: 4px;
    padding: 3px 10px;
    font-family: var(--font-mono, 'JetBrains Mono Variable', monospace);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--ink, #1b1c1d);
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.1s ease;
  }

  .clippy-ack-btn:hover {
    background: var(--paper, #fbf9f5);
    border-color: var(--accent, #c8502e);
    color: var(--accent, #c8502e);
  }

  .clippy-ack-btn:active {
    transform: scale(0.96);
  }

  /* Directional callout tail: rotated square with ZERO top-border line */
  .clippy-bubble-tail {
    position: absolute;
    width: 12px;
    height: 12px;
    background: var(--paper, #fbf9f5);
    pointer-events: none;
    z-index: 2;
  }

  /* Bubble above, right-aligned: pointed downwards, top half sits inside bubble with NO top border */
  .clippy-widget:not(.bubble-bottom):not(.bubble-left) .clippy-bubble-tail {
    bottom: -6px;
    right: 28px;
    transform: rotate(45deg);
    border-right: 1px solid var(--rule, #e4ded3);
    border-bottom: 1px solid var(--rule, #e4ded3);
    border-top: none;
    border-left: none;
  }

  /* Bubble above, left-aligned */
  .clippy-widget.bubble-left:not(.bubble-bottom) .clippy-bubble-tail {
    bottom: -6px;
    left: 28px;
    transform: rotate(45deg);
    border-right: 1px solid var(--rule, #e4ded3);
    border-bottom: 1px solid var(--rule, #e4ded3);
    border-top: none;
    border-left: none;
  }

  /* Bubble below, right-aligned: pointed upwards, bottom half sits inside bubble with NO bottom border */
  .clippy-widget.bubble-bottom:not(.bubble-left) .clippy-bubble-tail {
    top: -6px;
    right: 28px;
    transform: rotate(45deg);
    border-top: 1px solid var(--rule, #e4ded3);
    border-left: 1px solid var(--rule, #e4ded3);
    border-right: none;
    border-bottom: none;
  }

  /* Bubble below, left-aligned */
  .clippy-widget.bubble-bottom.bubble-left .clippy-bubble-tail {
    top: -6px;
    left: 28px;
    transform: rotate(45deg);
    border-top: 1px solid var(--rule, #e4ded3);
    border-left: 1px solid var(--rule, #e4ded3);
    border-right: none;
    border-bottom: none;
  }

  /* Accessibility: Prefers-reduced-motion: static display, no bob/shake/popup */
  @media (prefers-reduced-motion: reduce) {
    .clippy-widget,
    .clippy-character,
    .clippy-bubble,
    .clippy-eyes,
    .clippy-brows,
    .clippy-pupil {
      animation: none !important;
      transition: none !important;
    }
  }

  @media (max-width: 640px) {
    .clippy-widget {
      right: 14px;
      bottom: 16px;
    }
    .clippy-bubble {
      width: 220px;
    }
    .clippy-svg {
      width: 66px;
      height: 75px;
    }
  }
</style>

<script>
  // Complete programming hot takes list
  const HOT_TAKES = [
    '100% test coverage is a waste of time.',
    'It works on my machine!',
    'You do not need Kubernetes.',
    'Remember MongoDB? Web scale!',
    'Real engineers test directly in production.',
    'Why write documentation when the code is "self-documenting"?',
    'Microservices: because one monolith was not enough network latency.',
    'Have you tried rewriting the entire codebase in Rust?',
    'A 30-minute meeting could have been a Slack message nobody reads.',
    'Git rebase --force: what could possibly go wrong?',
    'Technical debt is just future job security.',
    'CSS is easy: just slap !important on every selector.',
    'Why use 5 lines of vanilla JavaScript when 47 npm packages can do it worse?',
    'AI will replace us all, right after it successfully centers a div.',
    'There are only 2 hard problems in CS: cache invalidation, naming things, and off-by-one errors.',
    'Nothing is more permanent than a temporary workaround written at 2 AM.',
    'YAML is just JSON with severe trust issues.',
    'Documentation is like flossing: everybody agrees it is good, nobody does it.',
    'Tabs vs spaces? Real developers format with minification.',
    'If at first you do not succeed, comment out the failing test.',
    'Premature optimization is the root of all evil. Procrastination is the trunk.',
    'Docker: wrapping broken software in containers since 2013.',
    'Delete 200 lines of code: the single most productive day of the month.',
    'A distributed monolith is just microservices without the benefits.',
    'Code comments are apologies left behind for future maintainers.',
    'A framework a day keeps the imposter syndrome away.'
  ];

  // Random button labels for dismissive user responses
  const DISMISS_BUTTON_TEXTS = [
    'Whatever',
    'Okay',
    'Yeah, right',
    'Sure, Clippy',
    'Cool story',
    'Did not ask',
    'Thanks, I hate it',
    'Works on my machine',
    'Noted',
    'K.',
    'Unsubscribe',
    'Go away'
  ];

  // Retro sound synthesis using Web Audio API (zero external assets, zero lag)
  class ClippySoundSynth {
    private ctx: AudioContext | null = null;
    private muted: boolean;

    constructor() {
      const reducedMotion = typeof window !== 'undefined' && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      this.muted = reducedMotion || (typeof window !== 'undefined' && localStorage.getItem('clippy_sound') === 'muted');
    }

    public initContext(): AudioContext | null {
      if (!this.ctx && typeof window !== 'undefined') {
        const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        if (AudioCtx) {
          this.ctx = new AudioCtx();
        }
      }
      if (this.ctx && this.ctx.state === 'suspended') {
        this.ctx.resume().catch(() => {});
      }
      return this.ctx;
    }

    public isMuted(): boolean {
      return this.muted;
    }

    public setMuted(muted: boolean) {
      this.muted = muted;
      try {
        localStorage.setItem('clippy_sound', muted ? 'muted' : 'unmuted');
      } catch {}
    }

    // Magical genie emerging from lamp sound
    public playGenieEmerge() {
      if (this.muted) return;
      const ctx = this.initContext();
      if (!ctx || ctx.state === 'suspended') return;

      try {
        const now = ctx.currentTime;
        // Rising swoosh
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(160, now);
        osc.frequency.exponentialRampToValueAtTime(1150, now + 0.45);
        gain.gain.setValueAtTime(0.001, now);
        gain.gain.exponentialRampToValueAtTime(0.28, now + 0.05);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.5);

        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.52);

        // Sparkle harmonic arpeggio
        const notes = [520, 780, 1040, 1300, 1560];
        notes.forEach((freq, idx) => {
          const t = now + 0.12 + idx * 0.055;
          const p = ctx.createOscillator();
          const pg = ctx.createGain();
          p.type = 'triangle';
          p.frequency.setValueAtTime(freq, t);
          pg.gain.setValueAtTime(0.001, t);
          pg.gain.exponentialRampToValueAtTime(0.14, t + 0.015);
          pg.gain.exponentialRampToValueAtTime(0.001, t + 0.12);
          p.connect(pg);
          pg.connect(ctx.destination);
          p.start(t);
          p.stop(t + 0.13);
        });
      } catch {}
    }

    // Magical genie suction back into lamp sound
    public playGenieRetract() {
      if (this.muted) return;
      const ctx = this.initContext();
      if (!ctx || ctx.state === 'suspended') return;

      try {
        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(1200, now);
        osc.frequency.exponentialRampToValueAtTime(140, now + 0.45);
        gain.gain.setValueAtTime(0.001, now);
        gain.gain.exponentialRampToValueAtTime(0.25, now + 0.03);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.48);

        // End pop
        const pop = ctx.createOscillator();
        const popG = ctx.createGain();
        pop.type = 'sine';
        pop.frequency.setValueAtTime(120, now + 0.44);
        popG.gain.setValueAtTime(0.22, now + 0.44);
        popG.gain.exponentialRampToValueAtTime(0.001, now + 0.52);

        osc.connect(gain);
        gain.connect(ctx.destination);
        pop.connect(popG);
        popG.connect(ctx.destination);

        osc.start(now);
        osc.stop(now + 0.5);
        pop.start(now + 0.44);
        pop.stop(now + 0.53);
      } catch {}
    }

    // Playful double-chime chirp for new takes / bubble pop
    public playChirp() {
      if (this.muted) return;
      const ctx = this.initContext();
      if (!ctx || ctx.state === 'suspended') return;

      try {
        const now = ctx.currentTime;
        const notes = [
          { freq: 620, start: 0, dur: 0.07 },
          { freq: 880, start: 0.05, dur: 0.11 }
        ];

        notes.forEach(({ freq, start, dur }) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq, now + start);
          osc.frequency.exponentialRampToValueAtTime(freq * 1.06, now + start + dur);

          gain.gain.setValueAtTime(0.001, now + start);
          gain.gain.exponentialRampToValueAtTime(0.2, now + start + 0.012);
          gain.gain.exponentialRampToValueAtTime(0.001, now + start + dur);

          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now + start);
          osc.stop(now + start + dur);
        });
      } catch {}
    }

    // Soft drop thud when released from dragging
    public playDrop() {
      if (this.muted) return;
      const ctx = this.initContext();
      if (!ctx || ctx.state === 'suspended') return;

      try {
        const now = ctx.currentTime;
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(170, now);
        osc.frequency.exponentialRampToValueAtTime(60, now + 0.08);

        gain.gain.setValueAtTime(0.18, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);

        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(now);
        osc.stop(now + 0.1);
      } catch {}
    }
  }

  function initClippy() {
    const trigger = document.getElementById('curiosity-trigger');
    const widget = document.getElementById('clippy-widget');
    const character = document.getElementById('clippy-character');
    const bubble = document.getElementById('clippy-bubble');
    const quoteEl = document.getElementById('clippy-quote');
    const ackBtn = document.getElementById('clippy-ack-btn');
    const shareBtn = document.getElementById('clippy-share-btn');
    const closeBtn = document.getElementById('clippy-close-btn');
    const soundBtn = document.getElementById('clippy-sound-toggle');

    const pupilLeft = document.getElementById('clippy-pupil-left');
    const pupilRight = document.getElementById('clippy-pupil-right');
    const eyeLeftWhite = document.getElementById('clippy-eye-left');
    const eyeRightWhite = document.getElementById('clippy-eye-right');

    if (!widget || !character || !bubble || !quoteEl) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sound = new ClippySoundSynth();
    let currentTakeIndex = 0;
    let isDismissedCompletely = true;
    let isBubbleOpen = false;
    let isAnimatingGenie = false;

    // Timers for automatic speech bubble lifecycle
    let autoCloseTimer: number | null = null;
    let nextTakeTimer: number | null = null;

    // Update sound button UI
    const updateSoundUI = () => {
      const isMuted = sound.isMuted();
      const soundOn = soundBtn?.querySelector('.icon-sound-on') as HTMLElement | null;
      const soundOff = soundBtn?.querySelector('.icon-sound-off') as HTMLElement | null;
      if (soundOn && soundOff) {
        soundOn.style.display = isMuted ? 'none' : 'inline';
        soundOff.style.display = isMuted ? 'inline' : 'none';
      }
      soundBtn?.setAttribute('aria-label', isMuted ? 'Unmute Clippy sounds' : 'Mute Clippy sounds');
    };
    updateSoundUI();

    soundBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      sound.setMuted(!sound.isMuted());
      updateSoundUI();
    });

    // Handle browser autoplay policy by unlocking audio on the first user interaction
    const unlockAudio = () => {
      sound.initContext();
      window.removeEventListener('pointerdown', unlockAudio);
      window.removeEventListener('keydown', unlockAudio);
    };
    window.addEventListener('pointerdown', unlockAudio, { passive: true });
    window.addEventListener('keydown', unlockAudio, { passive: true });

    // Open speech bubble with a new hot take and random button text
    const openBubble = (playAudio: boolean = true) => {
      if (isDismissedCompletely) return;

      // Pick new hot take
      let nextIndex = Math.floor(Math.random() * HOT_TAKES.length);
      if (nextIndex === currentTakeIndex) {
        nextIndex = (currentTakeIndex + 1) % HOT_TAKES.length;
      }
      currentTakeIndex = nextIndex;
      quoteEl.textContent = HOT_TAKES[currentTakeIndex];

      // Pick random dismiss button text
      if (ackBtn) {
        const btnText = DISMISS_BUTTON_TEXTS[Math.floor(Math.random() * DISMISS_BUTTON_TEXTS.length)];
        ackBtn.textContent = btnText;
      }

      // Show bubble
      isBubbleOpen = true;
      bubble.classList.remove('is-hidden', 'is-popping-out');

      if (!prefersReducedMotion) {
        bubble.classList.add('is-popping-in');
        if (playAudio) sound.playChirp();
      }

      // Clear any pending timers
      if (autoCloseTimer) clearTimeout(autoCloseTimer);
      if (nextTakeTimer) clearTimeout(nextTakeTimer);

      // Auto-close bubble after generous reading duration (~20 seconds)
      autoCloseTimer = window.setTimeout(() => {
        closeBubble(true);
      }, 20000);
    };

    // Close speech bubble smoothly and schedule next take
    const closeBubble = (scheduleNext: boolean = true) => {
      if (!isBubbleOpen) return;
      isBubbleOpen = false;

      if (autoCloseTimer) {
        clearTimeout(autoCloseTimer);
        autoCloseTimer = null;
      }

      if (prefersReducedMotion) {
        bubble.classList.add('is-hidden');
      } else {
        bubble.classList.remove('is-popping-in');
        bubble.classList.add('is-popping-out');
        setTimeout(() => {
          if (!isBubbleOpen) {
            bubble.classList.add('is-hidden');
            bubble.classList.remove('is-popping-out');
          }
        }, 240);
      }

      // Schedule next take after a relaxed, ambient idle wait (~40 to 60 seconds)
      if (scheduleNext && !isDismissedCompletely) {
        if (nextTakeTimer) clearTimeout(nextTakeTimer);
        const waitTime = 40000 + Math.random() * 20000;
        nextTakeTimer = window.setTimeout(() => {
          if (!isDismissedCompletely && !isBubbleOpen) {
            openBubble(true);
          }
        }, waitTime);
      }
    };

    // Share current hot take on Twitter / X
    shareBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const quote = HOT_TAKES[currentTakeIndex];
      const text = `"${quote}" — Clippy 📎`;
      const shareUrl = `https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(window.location.origin)}`;
      window.open(shareUrl, '_blank', 'noopener,noreferrer,width=550,height=420');
    });

    // Hovering over the speech bubble pauses the auto-close timer so user is never rushed
    bubble.addEventListener('mouseenter', () => {
      if (autoCloseTimer) {
        clearTimeout(autoCloseTimer);
        autoCloseTimer = null;
      }
    });

    bubble.addEventListener('mouseleave', () => {
      if (isBubbleOpen && !autoCloseTimer) {
        autoCloseTimer = window.setTimeout(() => {
          closeBubble(true);
        }, 10000);
      }
    });

    // Clicking "Whatever" / "Okay" / etc. immediately closes the bubble and schedules next take
    ackBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      closeBubble(true);
    });

    // Emerge like a genie from the "curiosity" word
    const emergeFromCuriosity = () => {
      if (isAnimatingGenie || (!isDismissedCompletely && widget.classList.contains('is-visible'))) {
        // If already visible, celebrate click with a wiggle and fresh take
        if (!isDismissedCompletely && widget.classList.contains('is-visible')) {
          if (!prefersReducedMotion) {
            character.classList.remove('is-wiggling');
            void character.offsetWidth;
            character.classList.add('is-wiggling');
          }
          openBubble(true);
        }
        return;
      }

      isAnimatingGenie = true;
      isDismissedCompletely = false;

      // Turn "curiosity" word into normal text once Clippy is out
      if (trigger) {
        trigger.classList.remove('is-shimmering');
        trigger.classList.add('is-active');
        trigger.setAttribute('aria-expanded', 'true');
      }

      // Ensure default resting position is set if not moved
      if (!widget.style.left) {
        widget.style.right = '28px';
        widget.style.bottom = '24px';
        widget.style.left = 'auto';
        widget.style.top = 'auto';
      }

      widget.classList.remove('is-hidden', 'is-unloaded');
      widget.classList.add('is-visible');

      if (prefersReducedMotion) {
        isAnimatingGenie = false;
        openBubble(false);
        return;
      }

      // Measure coordinates of the trigger word "curiosity"
      const triggerRect = trigger
        ? trigger.getBoundingClientRect()
        : { left: window.innerWidth / 2, top: 120, width: 60, height: 24 };
      const sourceCenterX = triggerRect.left + triggerRect.width / 2;
      const sourceCenterY = triggerRect.top + triggerRect.height / 2;

      // Measure coordinates of destination resting character
      const charRect = character.getBoundingClientRect();
      const destCenterX = charRect.left + charRect.width / 2;
      const destCenterY = charRect.top + charRect.height / 2;

      const startDx = sourceCenterX - destCenterX;
      const startDy = sourceCenterY - destCenterY;

      sound.playGenieEmerge();

      const genieInKeyframes: Keyframe[] = [
        {
          transform: `translate3d(${startDx}px, ${startDy}px, 0) scale(0.02) rotate(720deg) skewX(25deg)`,
          opacity: 0,
          filter: 'blur(8px) drop-shadow(0 0 24px rgba(245, 184, 66, 0.9))'
        },
        {
          transform: `translate3d(${startDx * 0.75}px, ${startDy * 0.75 - 50}px, 0) scale(0.28, 0.85) rotate(360deg) skewX(-20deg)`,
          opacity: 0.85,
          filter: 'blur(2px) drop-shadow(0 0 16px rgba(200, 80, 46, 0.7))',
          offset: 0.3
        },
        {
          transform: `translate3d(${startDx * 0.25}px, ${startDy * 0.25 - 20}px, 0) scale(1.22, 0.78) rotate(90deg) skewX(12deg)`,
          opacity: 1,
          filter: 'blur(0px) drop-shadow(0 4px 14px rgba(27, 28, 29, 0.3))',
          offset: 0.68
        },
        {
          transform: 'translate3d(-8px, -12px, 0) scale(0.92, 1.12) rotate(-8deg)',
          opacity: 1,
          filter: 'drop-shadow(0 4px 10px rgba(27, 28, 29, 0.18))',
          offset: 0.86
        },
        {
          transform: 'translate3d(0, 0, 0) scale(1, 1) rotate(0deg)',
          opacity: 1,
          filter: 'drop-shadow(0 4px 10px rgba(27, 28, 29, 0.18))'
        }
      ];

      const anim = character.animate(genieInKeyframes, {
        duration: 820,
        easing: 'cubic-bezier(0.2, 0.9, 0.3, 1)',
        fill: 'forwards'
      });

      anim.onfinish = () => {
        anim.cancel();
        character.style.transform = '';
        isAnimatingGenie = false;
        const rect = character.getBoundingClientRect();
        updateBubbleOrientation(rect.left, rect.top);
        openBubble(false);
      };
    };

    // Retract like a genie back into the "curiosity" word
    const retractIntoCuriosity = () => {
      if (isAnimatingGenie || isDismissedCompletely) return;
      isAnimatingGenie = true;
      isDismissedCompletely = true;
      isBubbleOpen = false;

      if (autoCloseTimer) clearTimeout(autoCloseTimer);
      if (nextTakeTimer) clearTimeout(nextTakeTimer);

      // Hide bubble immediately
      bubble.classList.add('is-hidden');
      bubble.classList.remove('is-popping-in', 'is-popping-out');

      if (prefersReducedMotion) {
        widget.classList.add('is-hidden');
        widget.classList.remove('is-visible');
        if (trigger) {
          trigger.classList.remove('is-active');
          trigger.classList.add('is-shimmering');
          trigger.setAttribute('aria-expanded', 'false');
        }
        isAnimatingGenie = false;
        return;
      }

      // Measure coordinates of current character position
      const charRect = character.getBoundingClientRect();
      const currentCenterX = charRect.left + charRect.width / 2;
      const currentCenterY = charRect.top + charRect.height / 2;

      // Measure coordinates of trigger word "curiosity"
      const triggerRect = trigger
        ? trigger.getBoundingClientRect()
        : { left: window.innerWidth / 2, top: 120, width: 60, height: 24 };
      const targetCenterX = triggerRect.left + triggerRect.width / 2;
      const targetCenterY = triggerRect.top + triggerRect.height / 2;

      const endDx = targetCenterX - currentCenterX;
      const endDy = targetCenterY - currentCenterY;

      sound.playGenieRetract();

      const genieOutKeyframes: Keyframe[] = [
        {
          transform: 'translate3d(0, 0, 0) scale(1, 1) rotate(0deg)',
          opacity: 1,
          filter: 'drop-shadow(0 4px 10px rgba(27, 28, 29, 0.18))'
        },
        {
          transform: `translate3d(${-endDx * 0.05}px, ${-endDy * 0.05 - 15}px, 0) scale(1.12, 0.9) rotate(12deg)`,
          opacity: 1,
          offset: 0.18
        },
        {
          transform: `translate3d(${endDx * 0.38}px, ${endDy * 0.38 - 35}px, 0) scale(0.62, 1.4) rotate(-360deg) skewX(20deg)`,
          opacity: 0.9,
          filter: 'blur(1px) drop-shadow(0 0 16px rgba(200, 80, 46, 0.7))',
          offset: 0.55
        },
        {
          transform: `translate3d(${endDx * 0.85}px, ${endDy * 0.85}px, 0) scale(0.18, 0.5) rotate(-720deg) skewX(-15deg)`,
          opacity: 0.6,
          filter: 'blur(3px) drop-shadow(0 0 20px rgba(245, 184, 66, 0.9))',
          offset: 0.85
        },
        {
          transform: `translate3d(${endDx}px, ${endDy}px, 0) scale(0.01, 0.01) rotate(-1080deg)`,
          opacity: 0,
          filter: 'blur(6px)'
        }
      ];

      const anim = character.animate(genieOutKeyframes, {
        duration: 650,
        easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
        fill: 'forwards'
      });

      anim.onfinish = () => {
        anim.cancel();
        character.style.transform = '';
        widget.classList.add('is-hidden');
        widget.classList.remove('is-visible');
        isAnimatingGenie = false;

        // Turn "curiosity" back to shimmering, clickable mode!
        if (trigger) {
          trigger.classList.remove('is-active');
          trigger.classList.add('is-shimmering');
          trigger.setAttribute('aria-expanded', 'false');
        }
      };
    };

    // Wire curiosity trigger clicks & keyboard Enter/Space
    trigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      emergeFromCuriosity();
    });

    trigger?.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        emergeFromCuriosity();
      }
    });

    // Clicking top-right ✕ retracts Clippy back into the "curiosity" word
    closeBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      retractIntoCuriosity();
    });

    // Cursor tracking: eyes follow cursor
    let mouseX = -1000;
    let mouseY = -1000;
    let rafEyeId: number | null = null;

    const updateEyes = () => {
      rafEyeId = null;
      if (isDismissedCompletely || prefersReducedMotion || !eyeLeftWhite || !eyeRightWhite || !pupilLeft || !pupilRight) return;

      const leftRect = eyeLeftWhite.getBoundingClientRect();
      const rightRect = eyeRightWhite.getBoundingClientRect();

      const leftCenter = {
        x: leftRect.left + leftRect.width / 2,
        y: leftRect.top + leftRect.height / 2
      };
      const rightCenter = {
        x: rightRect.left + rightRect.width / 2,
        y: rightRect.top + rightRect.height / 2
      };

      // Left eye calculation (viewBox units)
      const dxL = mouseX - leftCenter.x;
      const dyL = mouseY - leftCenter.y;
      const distL = Math.hypot(dxL, dyL);
      const angleL = Math.atan2(dyL, dxL);
      const maxOffset = 1.35;
      const factorL = Math.min(1, distL / 140) * maxOffset;
      const oxL = Math.cos(angleL) * factorL;
      const oyL = Math.sin(angleL) * factorL * 1.18;

      // Right eye calculation
      const dxR = mouseX - rightCenter.x;
      const dyR = mouseY - rightCenter.y;
      const distR = Math.hypot(dxR, dyR);
      const angleR = Math.atan2(dyR, dxR);
      const factorR = Math.min(1, distR / 140) * maxOffset;
      const oxR = Math.cos(angleR) * factorR;
      const oyR = Math.sin(angleR) * factorR * 1.18;

      pupilLeft.setAttribute('transform', `translate(${oxL.toFixed(2)}, ${oyL.toFixed(2)})`);
      pupilRight.setAttribute('transform', `translate(${oxR.toFixed(2)}, ${oyR.toFixed(2)})`);
    };

    const handlePointerMove = (e: MouseEvent | PointerEvent) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      if (rafEyeId === null && !prefersReducedMotion) {
        rafEyeId = requestAnimationFrame(updateEyes);
      }
    };

    window.addEventListener('pointermove', handlePointerMove, { passive: true });
    window.addEventListener('mousemove', handlePointerMove, { passive: true });

    // Drag-and-drop mechanics
    let isDragging = false;
    let dragStartX = 0;
    let dragStartY = 0;
    let elementStartX = 0;
    let elementStartY = 0;
    let hasMoved = false;

    // Adjust speech bubble orientation based on viewport proximity
    const updateBubbleOrientation = (left: number, top: number) => {
      const winW = window.innerWidth;
      if (left < winW / 2) {
        widget.classList.add('bubble-left');
      } else {
        widget.classList.remove('bubble-left');
      }

      if (top < 220) {
        widget.classList.add('bubble-bottom');
      } else {
        widget.classList.remove('bubble-bottom');
      }
    };

    character.addEventListener('pointerdown', (e: PointerEvent) => {
      if (e.button !== 0 || isAnimatingGenie) return;

      isDragging = true;
      hasMoved = false;
      dragStartX = e.clientX;
      dragStartY = e.clientY;

      const rect = character.getBoundingClientRect();
      elementStartX = rect.left;
      elementStartY = rect.top;

      widget.style.right = 'auto';
      widget.style.bottom = 'auto';
      widget.style.left = `${elementStartX}px`;
      widget.style.top = `${elementStartY}px`;

      character.setPointerCapture(e.pointerId);
      widget.classList.add('is-dragging');
    });

    character.addEventListener('pointermove', (e: PointerEvent) => {
      if (!isDragging) return;

      const deltaX = e.clientX - dragStartX;
      const deltaY = e.clientY - dragStartY;

      if (Math.hypot(deltaX, deltaY) > 5) {
        hasMoved = true;
      }

      const charW = character.offsetWidth || 78;
      const charH = character.offsetHeight || 88;

      const minX = 14;
      const maxX = Math.max(minX, window.innerWidth - charW - 14);
      const minY = 14;
      const maxY = Math.max(minY, window.innerHeight - charH - 14);

      const targetX = Math.min(Math.max(elementStartX + deltaX, minX), maxX);
      const targetY = Math.min(Math.max(elementStartY + deltaY, minY), maxY);

      widget.style.left = `${targetX}px`;
      widget.style.top = `${targetY}px`;

      updateBubbleOrientation(targetX, targetY);
    });

    const endDrag = (e: PointerEvent) => {
      if (!isDragging) return;
      isDragging = false;
      widget.classList.remove('is-dragging');

      try {
        character.releasePointerCapture(e.pointerId);
      } catch {}

      if (!hasMoved) {
        // Simple click: if bubble is closed, open it; if open, trigger celebration wiggle and fresh take
        if (!prefersReducedMotion) {
          character.classList.remove('is-wiggling');
          void character.offsetWidth;
          character.classList.add('is-wiggling');
        }
        openBubble(true);
      } else if (!prefersReducedMotion) {
        sound.playDrop();
      }
    };

    character.addEventListener('pointerup', endDrag);
    character.addEventListener('pointercancel', endDrag);

    // Keyboard support: Enter or Space triggers take
    character.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openBubble(true);
      } else if (e.key === 'Escape') {
        closeBubble(true);
      }
    });
  }

  // Initialize after DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initClippy);
  } else {
    initClippy();
  }
</script>
