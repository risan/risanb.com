---
// Clippy: a paperclip assistant summoned by the "curiosity" button on the home page.
---

<div id="clippy-widget" class="clippy-widget" role="region" aria-label="Clippy assistant">
  <div id="clippy-bubble" class="clippy-bubble" role="dialog" aria-labelledby="clippy-quote">
    <div class="clippy-corner-tools">
      <button
        id="clippy-sound-toggle"
        class="clippy-tool-btn"
        type="button"
        aria-label="Toggle sound"
        title="Toggle sound"
      >
        <span class="icon-sound-on" aria-hidden="true">🔊</span>
        <span class="icon-sound-off" aria-hidden="true" hidden>🔇</span>
      </button>
      <button
        id="clippy-close-btn"
        class="clippy-tool-btn"
        type="button"
        aria-label="Dismiss Clippy"
        title="Dismiss Clippy"
      >
        ✕
      </button>
    </div>

    <div class="clippy-bubble-body">
      <p id="clippy-quote" class="clippy-quote"></p>
    </div>

    <div class="clippy-bubble-footer">
      <button
        id="clippy-share-btn"
        class="clippy-share-btn"
        type="button"
        aria-label="Share this hot take on X"
        title="Share this hot take on X"
      >
        <svg class="x-icon" width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
        <span>Share</span>
      </button>
      <button id="clippy-ack-btn" class="clippy-ack-btn" type="button">Whatever</button>
    </div>

    <div class="clippy-bubble-tail" aria-hidden="true"></div>
  </div>

  <div
    id="clippy-character"
    class="clippy-character"
    role="button"
    tabindex="0"
    aria-label="Clippy: drag to reposition, click for a hot take, double-click to dance"
    title="Drag me anywhere, click for a hot take"
  >
    <svg
      id="clippy-svg"
      class="clippy-svg"
      width="56"
      height="92"
      viewBox="0 0 60 100"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="clippy-metal" x1="8" y1="0" x2="52" y2="0" gradientUnits="userSpaceOnUse">
          <stop offset="0" stop-color="#c5cdd9" />
          <stop offset="0.22" stop-color="#f5f7fb" />
          <stop offset="0.5" stop-color="#a9b3c2" />
          <stop offset="0.75" stop-color="#e4e9f0" />
          <stop offset="1" stop-color="#8793a5" />
        </linearGradient>
      </defs>

      <g class="clippy-wire" transform="rotate(-8 30 50)">
        <path
          d="M22 64V28a8 8 0 0 1 16 0v52a13 13 0 0 1-26 0V22a18 18 0 0 1 36 0v42"
          stroke="#5b6678"
          stroke-width="7.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M22 64V28a8 8 0 0 1 16 0v52a13 13 0 0 1-26 0V22a18 18 0 0 1 36 0v42"
          stroke="url(#clippy-metal)"
          stroke-width="5.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M22 64V28a8 8 0 0 1 16 0v52a13 13 0 0 1-26 0V22a18 18 0 0 1 36 0v42"
          transform="translate(-1.1 -0.6)"
          stroke="#fff"
          stroke-opacity="0.85"
          stroke-width="1.1"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </g>

      <g class="clippy-eyes">
        <ellipse id="clippy-eye-left" cx="19" cy="36" rx="8.4" ry="9.6" fill="#fff" stroke="#222" stroke-width="1.1" />
        <ellipse id="clippy-eye-right" cx="37" cy="33.5" rx="8.4" ry="9.6" fill="#fff" stroke="#222" stroke-width="1.1" />
        <g id="clippy-pupil-left" class="clippy-pupil">
          <circle cx="19" cy="36.6" r="3.7" fill="#161616" />
          <circle cx="17.8" cy="35.2" r="1.1" fill="#fff" />
        </g>
        <g id="clippy-pupil-right" class="clippy-pupil">
          <circle cx="37" cy="34.1" r="3.7" fill="#161616" />
          <circle cx="35.8" cy="32.7" r="1.1" fill="#fff" />
        </g>
      </g>

      <g id="clippy-brow-left" class="clippy-brow">
        <path d="M11 22.5Q18 16 27 20" stroke="#161616" stroke-width="3.4" stroke-linecap="round" />
      </g>
      <g id="clippy-brow-right" class="clippy-brow">
        <path d="M30.5 17.5Q38 12 46 17" stroke="#161616" stroke-width="3.4" stroke-linecap="round" />
      </g>
    </svg>
  </div>
</div>

<style>
  .clippy-widget {
    position: fixed;
    right: 28px;
    bottom: 24px;
    display: none;
    width: 56px;
    height: 92px;
    z-index: 85;
    user-select: none;
    touch-action: none;
  }

  .clippy-widget.is-out {
    display: block;
  }

  .clippy-character {
    position: relative;
    width: 100%;
    height: 100%;
    cursor: grab;
    outline: none;
    transform-origin: 50% 100%;
    transition: transform 0.15s ease-out;
    -webkit-tap-highlight-color: transparent;
  }

  .clippy-character:focus-visible {
    border-radius: 14px;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent, #c8502e) 45%, transparent);
  }

  .clippy-widget.is-dragging .clippy-character {
    cursor: grabbing;
    transform: translateY(-4px) rotate(-3deg);
  }

  .clippy-svg {
    display: block;
    overflow: visible;
    transform-origin: 50% 96%;
    filter: drop-shadow(0 4px 8px rgba(27, 28, 29, 0.22));
  }

  :global(.dark) .clippy-svg {
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.55));
  }

  .clippy-eyes {
    transform-box: fill-box;
    transform-origin: center;
    animation: clippy-blink 4.2s infinite;
  }

  @keyframes clippy-blink {
    0%,
    92%,
    100% {
      transform: scaleY(1);
    }
    95% {
      transform: scaleY(0.1);
    }
  }

  .clippy-pupil {
    transition: transform 0.12s ease-out;
  }

  .clippy-brow {
    transform-box: fill-box;
    transform-origin: center;
  }

  .clippy-bubble {
    position: absolute;
    width: 280px;
    max-width: calc(100vw - 32px);
    padding: 14px 16px 12px 14px;
    background: var(--paper, #fbf9f5);
    border: 1px solid var(--rule, #e4ded3);
    border-radius: 6px;
    box-shadow:
      0 12px 32px -6px color-mix(in srgb, var(--ink, #1b1c1d) 16%, transparent),
      0 3px 8px -2px color-mix(in srgb, var(--ink, #1b1c1d) 8%, transparent);
    color: var(--ink, #1b1c1d);
    z-index: 10;
    opacity: 0;
    visibility: hidden;
    transform: scale(0.82) translateY(10px);
    transition:
      opacity 0.18s ease,
      transform 0.18s ease,
      visibility 0s linear 0.18s;
  }

  .clippy-bubble.is-open {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.2s ease,
      transform 0.4s cubic-bezier(0.34, 1.45, 0.64, 1);
  }

  .clippy-widget:not(.bubble-bottom):not(.bubble-left) .clippy-bubble {
    bottom: calc(100% + 14px);
    right: 0;
    transform-origin: bottom right;
  }

  .clippy-widget.bubble-left:not(.bubble-bottom) .clippy-bubble {
    bottom: calc(100% + 14px);
    left: 0;
    transform-origin: bottom left;
  }

  .clippy-widget.bubble-bottom:not(.bubble-left) .clippy-bubble {
    top: calc(100% + 14px);
    right: 0;
    transform-origin: top right;
  }

  .clippy-widget.bubble-bottom.bubble-left .clippy-bubble {
    top: calc(100% + 14px);
    left: 0;
    transform-origin: top left;
  }

  .clippy-corner-tools {
    position: absolute;
    top: 7px;
    right: 7px;
    display: flex;
    align-items: center;
    gap: 2px;
    z-index: 5;
  }

  .clippy-tool-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    padding: 0;
    border: none;
    background: transparent;
    border-radius: 3px;
    font-size: 0.75rem;
    color: var(--ink-muted, #6b6862);
    cursor: pointer;
    line-height: 1;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .clippy-tool-btn:hover {
    background-color: var(--sunk, #f3efe7);
    color: var(--ink, #1b1c1d);
  }

  .clippy-bubble-body {
    padding-right: 36px;
    min-height: 42px;
    display: flex;
    align-items: center;
  }

  .clippy-quote {
    margin: 0;
    font-family: var(--font-serif, 'Newsreader Variable', Georgia, serif);
    font-size: 0.9375rem;
    line-height: 1.45;
    font-weight: 500;
    color: var(--ink, #1b1c1d);
  }

  .clippy-bubble-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: 10px;
    padding-top: 4px;
    flex-wrap: wrap;
  }

  .clippy-share-btn,
  .clippy-ack-btn {
    appearance: none;
    border: 1px solid var(--rule, #e4ded3);
    border-radius: 4px;
    padding: 3px 8px;
    font-family: var(--font-mono, 'JetBrains Mono Variable', monospace);
    font-size: 0.6875rem;
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.1s ease;
  }

  .clippy-share-btn:active,
  .clippy-ack-btn:active {
    transform: scale(0.96);
  }

  .clippy-share-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: transparent;
    color: var(--ink-muted, #6b6862);
  }

  .clippy-share-btn:hover {
    background: var(--sunk, #f3efe7);
    border-color: var(--ink, #1b1c1d);
    color: var(--ink, #1b1c1d);
  }

  .clippy-ack-btn {
    background: var(--sunk, #f3efe7);
    color: var(--ink, #1b1c1d);
  }

  .clippy-ack-btn:hover {
    background: var(--paper, #fbf9f5);
    border-color: var(--accent, #c8502e);
    color: var(--accent, #c8502e);
  }

  .clippy-bubble-tail {
    position: absolute;
    width: 12px;
    height: 12px;
    background: var(--paper, #fbf9f5);
    pointer-events: none;
    z-index: 2;
    transform: rotate(45deg);
  }

  .clippy-widget:not(.bubble-bottom) .clippy-bubble-tail {
    bottom: -6px;
    border-right: 1px solid var(--rule, #e4ded3);
    border-bottom: 1px solid var(--rule, #e4ded3);
  }

  .clippy-widget.bubble-bottom .clippy-bubble-tail {
    top: -6px;
    border-top: 1px solid var(--rule, #e4ded3);
    border-left: 1px solid var(--rule, #e4ded3);
  }

  .clippy-widget:not(.bubble-left) .clippy-bubble-tail {
    right: 22px;
  }

  .clippy-widget.bubble-left .clippy-bubble-tail {
    left: 22px;
  }

  @media (prefers-reduced-motion: reduce) {
    .clippy-character,
    .clippy-bubble,
    .clippy-pupil {
      transition: none;
    }

    .clippy-eyes {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .clippy-widget {
      right: 14px;
      bottom: 16px;
    }

    .clippy-bubble {
      width: min(280px, calc(100vw - 28px));
      max-width: calc(100vw - 28px);
    }
  }
</style>

<script>
  const HOT_TAKES = [
    'Most microservices are a monolith with extra network calls.',
    'Code review catches naming debates, not bugs.',
    'The best cache is the query you deleted.',
    'Your feature flag is now permanent. Name it accordingly.',
    'Coverage tells you what ran, not what was checked.',
    'Estimates are promises disguised as guesses.',
    'Every abstraction is a loan. The next reader pays the interest.',
    'If you need a comment to explain it, rename something first.',
    'You don’t have a scaling problem. You have a missing index.',
    'A rewrite bets you understand the system better than the people who built it.',
    'Staging lies, just more politely than your laptop.',
    'Dependencies are code you adopted without reviewing it.',
    'A flaky test is a bug report you keep closing.',
    'Logs nobody reads are just expensive disk space.',
    'Retries without backoff are a denial-of-service you wrote yourself.',
    'The second system is where good taste goes to die.',
    'AI tools made writing code cheap and reviewing it expensive.',
    'Generated code is your code the moment you merge it.',
    'Autocomplete is great at the code you would have written anyway.',
    'Prompting well is mostly writing the spec you were avoiding.',
    'A good commit message outlives the code it describes.',
    'Nobody reads the README until the day they own the repo.',
    'Seniority is mostly knowing which problems to leave unsolved.',
    'The best engineers I know delete more than they add.',
    'Naming is design. Everything else is typing.',
    'A ten-line function with a good name beats a ten-line comment.',
    'Every temporary script outlives the team that wrote it.',
    'A little duplication is cheaper than the wrong abstraction.',
    'The right abstraction usually appears on the third copy, not the first.',
    'A schema is the most durable API you will ever ship.',
    'Migrations are the only code that has to work on the first try.',
    'ORMs are fine until the query plan matters.',
    'Postgres is the answer more often than anyone wants to admit.',
    'Soft deletes are a promise to filter, forever.',
    'SELECT * is a contract with columns you haven’t met yet.',
    'CSS specificity wars are architecture problems in disguise.',
    'Half of frontend performance is shipping less JavaScript.',
    'A spinner is an admission that you could not make it fast.',
    'Most single-page apps would have been fine as pages.',
    'Accessibility is cheap on day one and expensive on day 400.',
    'Dark mode is two design systems, not one.',
    'Most state is server state. Stop copying it into the client.',
    'Most teams adopting Kubernetes needed a bigger VM.',
    'Infrastructure as code is still code. Review it like code.',
    'If deploys are scary, do them more often.',
    'A runbook nobody has tested is fiction.',
    'An alert that needs no action is noise. Delete it.',
    'The incident report matters more than the incident.',
    'A backup you haven’t restored is a hope.',
    'Observability is mostly knowing what to ask before it breaks.',
    'The cloud bill is the only honest architecture diagram.',
    'Mocks test your assumptions, not your system.',
    'Integration tests are slow because they test something real.',
    'Every bug fixed without a test is scheduled to return.',
    'Write the test you wished you had during the last outage.',
    'Tech debt is fine. Debt nobody knows about is the problem.',
    'Deadlines don’t shorten the work. They shorten the testing.',
    'Nobody gets promoted for the outage that didn’t happen.',
    'You learn the most from the system you stay with long enough to regret.',
    'A senior engineer is measured by how fast the next person gets.',
    'Pair programming works best when someone says “I don’t know.”',
    'A 2,000-line review is a rubber stamp with extra steps.',
    'The pull request description is part of the change.',
    'Small pull requests get real reviews. Large ones get approved.',
    'Linters settle style arguments so reviews can have better ones.',
    'Strict types are documentation the compiler reads for you.',
    'Config files are programs nobody tests.',
    'YAML is fine until it becomes a programming language.',
    'Monorepos aren’t the hard part. Ownership is.',
    'An internal platform is a product. Treat its users like customers.',
    'Boring technology is a feature. Spend your novelty budget elsewhere.',
    'Most performance work is deleting something that should never have run.',
    'Clever code gets admired once and cursed for years.',
    'Documentation rots at the speed of the code beside it. Keep it close.',
    'The fastest way to learn a codebase is to fix its smallest bugs.',
    'Error messages are UI. Write them for someone tired.',
    'A queue doesn’t remove load. It postpones the conversation about it.',
    'Idempotency is the cheapest insurance in distributed systems.',
    'Time zones are a database problem you chose to ignore.',
    'AI assistants are fast and confident. Review them like any new hire.',
    'An agent with no tests will happily run the wrong way at full speed.',
    'If the AI wrote it and you can’t explain it, you don’t own it yet.',
    'Readable beats clever, and boring beats readable.',
    'Feature requests are solutions. Ask for the problem.',
    'Every config option is a decision you declined to make.',
    'The most expensive code is the code that almost works.',
    'Delete the dead code. Git remembers it for you.'
  ];

  const DISMISS_LABELS = [
    'Whatever',
    'Okay',
    'Yeah, right',
    'Sure, Clippy',
    'Cool story',
    'Noted',
    'Fair enough',
    'Debatable',
    'Hmm',
    'Go away'
  ];

  const MUTE_STORAGE_KEY = 'clippy_sound';

  class TakeBag {
    private bag: string[] = [];
    private last = '';

    next(): string {
      if (this.bag.length === 0) {
        this.refill();
      }

      const take = this.bag.pop() as string;
      this.last = take;

      return take;
    }

    private refill() {
      this.bag = [...HOT_TAKES];

      for (let i = this.bag.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [this.bag[i], this.bag[j]] = [this.bag[j], this.bag[i]];
      }

      if (this.bag[this.bag.length - 1] === this.last) {
        this.bag.unshift(this.bag.pop() as string);
      }
    }
  }

  interface Tone {
    frequency: number;
    endFrequency?: number;
    delay?: number;
    duration: number;
    volume: number;
    type?: OscillatorType;
  }

  // Short, soft sine and triangle notes with a gentle attack: closer to the
  // Office assistant's small blips than to a game console.
  class ClippySounds {
    private context: AudioContext | null = null;
    private muted = false;

    constructor() {
      try {
        this.muted = localStorage.getItem(MUTE_STORAGE_KEY) === 'muted';
      } catch {
        this.muted = false;
      }
    }

    isMuted() {
      return this.muted;
    }

    setMuted(muted: boolean) {
      this.muted = muted;

      try {
        localStorage.setItem(MUTE_STORAGE_KEY, muted ? 'muted' : 'unmuted');
      } catch {
        // Storage can be blocked; the choice then lasts for this page view only.
      }
    }

    // Browsers only allow audio after a user gesture, so this is called from one.
    unlock() {
      this.getContext();
    }

    summon() {
      this.tone({ frequency: 330, endFrequency: 520, duration: 0.14, volume: 0.09 });
      this.tone({ frequency: 660, delay: 0.11, duration: 0.12, volume: 0.06, type: 'triangle' });
      this.tone({ frequency: 880, delay: 0.19, duration: 0.18, volume: 0.05, type: 'triangle' });
    }

    goodbye() {
      this.tone({ frequency: 660, delay: 0.05, duration: 0.1, volume: 0.06, type: 'triangle' });
      this.tone({ frequency: 494, delay: 0.15, duration: 0.12, volume: 0.06, type: 'triangle' });
      this.tone({ frequency: 392, endFrequency: 260, delay: 0.27, duration: 0.2, volume: 0.07 });
    }

    newTake() {
      this.tone({ frequency: 587, duration: 0.09, volume: 0.07, type: 'triangle' });
      this.tone({ frequency: 784, delay: 0.07, duration: 0.14, volume: 0.07, type: 'triangle' });
    }

    knocks() {
      [0.15, 0.35, 0.55].forEach((delay) => {
        this.tone({ frequency: 240, endFrequency: 130, delay, duration: 0.07, volume: 0.1 });
      });
    }

    drop() {
      this.tone({ frequency: 160, endFrequency: 70, duration: 0.09, volume: 0.1 });
    }

    private getContext(): AudioContext | null {
      if (!this.context) {
        const AudioContextClass =
          window.AudioContext ||
          (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
        this.context = AudioContextClass ? new AudioContextClass() : null;
      }

      if (this.context?.state === 'suspended') {
        this.context.resume().catch(() => {});
      }

      return this.context;
    }

    private tone({ frequency, endFrequency, delay = 0, duration, volume, type = 'sine' }: Tone) {
      const context = this.muted ? null : this.getContext();

      if (!context || context.state !== 'running') {
        return;
      }

      const start = context.currentTime + delay;
      const end = start + duration;
      const oscillator = context.createOscillator();
      const gain = context.createGain();

      oscillator.type = type;
      oscillator.frequency.setValueAtTime(frequency, start);

      if (endFrequency) {
        oscillator.frequency.exponentialRampToValueAtTime(endFrequency, end);
      }

      gain.gain.setValueAtTime(0.0001, start);
      gain.gain.exponentialRampToValueAtTime(volume, start + 0.015);
      gain.gain.exponentialRampToValueAtTime(0.0001, end);

      oscillator.connect(gain);
      gain.connect(context.destination);
      oscillator.start(start);
      oscillator.stop(end + 0.02);
    }
  }

  // Gaze is expressed as -1..1 on each axis, where 1 is the pupil's full travel.
  interface Gaze {
    x: number;
    y: number;
  }

  interface Move {
    duration: number;
    body: Keyframe[];
    brows?: [Keyframe[], Keyframe[]];
    gaze?: Array<[delayMs: number, gaze: Gaze | null]>;
  }

  type MoveName = 'greet' | 'attention' | 'lookAround' | 'think' | 'browRaise' | 'dance' | 'sway' | 'goodbye';

  const pose = (offset: number, y = 0, rotate = 0, scaleX = 1, scaleY = 1): Keyframe => ({
    offset,
    easing: 'ease-in-out',
    transform: `translateY(${y}px) rotate(${rotate}deg) scale(${scaleX}, ${scaleY})`
  });

  // Lift raises both brows; tilt is for the left brow and mirrored on the right,
  // so a positive tilt furrows and a negative one looks worried or surprised.
  const browPair = (lift: number, tilt: number): [Keyframe[], Keyframe[]] => {
    const frames = (angle: number): Keyframe[] => [
      { offset: 0, easing: 'ease-out', transform: 'translateY(0) rotate(0deg)' },
      { offset: 0.2, transform: `translateY(${-lift}px) rotate(${angle}deg)` },
      { offset: 0.8, easing: 'ease-in-out', transform: `translateY(${-lift}px) rotate(${angle}deg)` },
      { offset: 1, transform: 'translateY(0) rotate(0deg)' }
    ];

    return [frames(tilt), frames(-tilt)];
  };

  const danceFrames = (): Keyframe[] => {
    const frames = [pose(0)];

    [1, -1, 1, -1].forEach((side, beat) => {
      const start = beat * 0.24;
      frames.push(
        pose(start + 0.05, 3, side * -6, 1.1, 0.9),
        pose(start + 0.15, -14, side * 8, 0.92, 1.1),
        pose(start + 0.24, 0, side * -4, 1.08, 0.92)
      );
    });

    frames.push(pose(1));

    return frames;
  };

  const MOVES: Record<MoveName, Move> = {
    greet: {
      duration: 1300,
      body: [
        pose(0),
        pose(0.12, 2, 0, 1.06, 0.94),
        pose(0.3, -16, 0, 0.94, 1.08),
        pose(0.44, 0, 0, 1.07, 0.93),
        pose(0.54, 0, -11),
        pose(0.66, 0, 10),
        pose(0.78, 0, -9),
        pose(0.9, 0, 6),
        pose(1)
      ],
      brows: browPair(4, -6)
    },
    attention: {
      duration: 1000,
      body: [
        pose(0),
        pose(0.1, 0, -8, 1.03, 0.97),
        pose(0.2, 3, -3, 1.05, 0.95),
        pose(0.3, 0, -8),
        pose(0.4, 3, -3, 1.05, 0.95),
        pose(0.5, 0, -8),
        pose(0.6, 3, -3, 1.05, 0.95),
        pose(0.8, 0, -6),
        pose(1)
      ],
      brows: browPair(3, -5)
    },
    lookAround: {
      duration: 2600,
      body: [pose(0), pose(0.2, 0, -5), pose(0.45, 0, -5), pose(0.55, 0, 5), pose(0.8, 0, 5), pose(1)],
      gaze: [
        [0, { x: -1, y: 0.2 }],
        [1300, { x: 1, y: 0.1 }],
        [2200, null]
      ]
    },
    think: {
      duration: 900,
      body: [pose(0), pose(0.3, 0, 6, 0.98, 1.02), pose(0.8, 0, 6, 0.98, 1.02), pose(1)],
      brows: browPair(-1.5, 14),
      gaze: [
        [0, { x: -0.7, y: -1 }],
        [800, null]
      ]
    },
    browRaise: {
      duration: 900,
      body: [pose(0), pose(0.3, -3, 0, 0.98, 1.03), pose(1)],
      brows: browPair(4.5, -6)
    },
    dance: {
      duration: 1900,
      body: danceFrames(),
      brows: browPair(3, -6)
    },
    sway: {
      duration: 3000,
      body: [pose(0), pose(0.3, 0, -3), pose(0.7, 0, 3), pose(1)]
    },
    goodbye: {
      duration: 1000,
      body: [
        pose(0),
        pose(0.15, 0, -10),
        pose(0.3, 0, 10),
        pose(0.45, 0, -9),
        pose(0.6, 0, 8),
        pose(0.78, 0, -3),
        pose(1)
      ],
      brows: browPair(3, -5)
    }
  };

  const IDLE_MOVES: MoveName[] = [
    'lookAround',
    'lookAround',
    'lookAround',
    'sway',
    'sway',
    'sway',
    'browRaise',
    'browRaise',
    'browRaise',
    'dance'
  ];

  const ENTER_MS = 900;
  const EXIT_MS = 700;
  const BUBBLE_READING_MS = 20000;
  const MAX_PUPIL_TRAVEL = { x: 3.4, y: 4.2 };

  const easeOutQuad = (t: number) => 1 - (1 - t) * (1 - t);
  const easeInCubic = (t: number) => t * t * t;
  const easeOutBack = (t: number) => 1 + 2.70158 * Math.pow(t - 1, 3) + 1.70158 * Math.pow(t - 1, 2);

  interface Offset {
    dx: number;
    dy: number;
  }

  function squashStretchFrame(offset: number, x: number, y: number, rotate: number, scaleX: number, scaleY: number, height: number, opacity = 1): Keyframe {
    // The character scales around its feet, so shift it to keep its middle on the path.
    const centreShift = ((1 - scaleY) * height) / 2;

    return {
      offset,
      opacity,
      transform: `translate(${x}px, ${y - centreShift}px) rotate(${rotate}deg) scale(${scaleX}, ${scaleY})`
    };
  }

  // A hop from the word to the resting spot: the clip pops out, stretches through the
  // air along an arc, then lands with a squash and a small settle.
  function enterKeyframes(from: Offset, height: number): Keyframe[] {
    const lift = 70;
    const frames: Keyframe[] = [];
    const steps = 10;

    for (let step = 0; step <= steps; step++) {
      const t = step / steps;
      const travelled = easeOutQuad(t);
      const size = Math.max(0.05, easeOutBack(t));
      const stretch = Math.sin(Math.PI * t);

      frames.push(
        squashStretchFrame(
          t * 0.72,
          from.dx * (1 - travelled),
          from.dy * (1 - travelled) - lift * Math.sin(Math.PI * travelled),
          -22 * (1 - t),
          size * (1 - 0.14 * stretch),
          size * (1 + 0.2 * stretch),
          height,
          Math.min(1, t * 6)
        )
      );
    }

    frames.push(
      squashStretchFrame(0.82, 0, 0, 0, 1.16, 0.82, height),
      squashStretchFrame(0.92, 0, 0, 0, 0.96, 1.06, height),
      squashStretchFrame(1, 0, 0, 0, 1, 1, height)
    );

    return frames;
  }

  // The reverse: a small crouch, then a hop back along an arc, shrinking into the word.
  function exitKeyframes(to: Offset, height: number): Keyframe[] {
    const lift = 60;
    const frames: Keyframe[] = [
      squashStretchFrame(0, 0, 0, 0, 1, 1, height),
      squashStretchFrame(0.2, 0, 0, 0, 1.14, 0.84, height)
    ];
    const steps = 10;

    for (let step = 0; step <= steps; step++) {
      const t = step / steps;
      const travelled = easeInCubic(t) * 0.5 + t * 0.5;
      const size = Math.max(0.05, 1 - 0.95 * easeInCubic(t));
      const stretch = Math.sin(Math.PI * t);

      frames.push(
        squashStretchFrame(
          0.2 + t * 0.8,
          to.dx * travelled,
          to.dy * travelled - lift * Math.sin(Math.PI * travelled),
          20 * t,
          size * (1 - 0.14 * stretch),
          size * (1 + 0.2 * stretch),
          height,
          t > 0.8 ? (1 - t) * 5 : 1
        )
      );
    }

    return frames;
  }

  function initClippy() {
    const trigger = document.getElementById('curiosity-trigger');
    const widget = document.getElementById('clippy-widget');
    const character = document.getElementById('clippy-character');
    const svg = document.getElementById('clippy-svg');
    const bubble = document.getElementById('clippy-bubble');
    const quoteElement = document.getElementById('clippy-quote');
    const acknowledgeButton = document.getElementById('clippy-ack-btn');
    const shareButton = document.getElementById('clippy-share-btn');
    const closeButton = document.getElementById('clippy-close-btn');
    const soundButton = document.getElementById('clippy-sound-toggle');
    const eyes = [document.getElementById('clippy-eye-left'), document.getElementById('clippy-eye-right')];
    const pupils = [document.getElementById('clippy-pupil-left'), document.getElementById('clippy-pupil-right')];
    const brows = [document.getElementById('clippy-brow-left'), document.getElementById('clippy-brow-right')];

    if (
      !trigger || !widget || !character || !svg || !bubble || !quoteElement ||
      !acknowledgeButton || !shareButton || !closeButton || !soundButton ||
      eyes.includes(null) || pupils.includes(null) || brows.includes(null)
    ) {
      return;
    }

    const eyeElements = eyes as HTMLElement[];
    const pupilElements = pupils as HTMLElement[];
    const browElements = brows as HTMLElement[];
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const sounds = new ClippySounds();
    const takes = new TakeBag();

    let currentTake = '';
    let isOut = false;
    let isTravelling = false;
    let isDragging = false;
    let isBubbleOpen = false;
    let isIntroPlaying = false;
    let introRun = 0;

    let bodyAnimation: Animation | null = null;
    let browAnimations: Animation[] = [];
    let gazeTimers: number[] = [];
    let gazeOverride: Gaze | null = null;
    let pointer: { x: number; y: number } | null = null;
    let pointerFrame: number | null = null;
    let autoCloseTimer: number | undefined;
    let nextTakeTimer: number | undefined;
    let idleTimer: number | undefined;

    const renderSoundButton = () => {
      const isMuted = sounds.isMuted();
      soundButton.querySelector<HTMLElement>('.icon-sound-on')!.hidden = isMuted;
      soundButton.querySelector<HTMLElement>('.icon-sound-off')!.hidden = !isMuted;
      soundButton.setAttribute('aria-label', isMuted ? 'Unmute Clippy sounds' : 'Mute Clippy sounds');
    };

    renderSoundButton();

    soundButton.addEventListener('click', () => {
      sounds.setMuted(!sounds.isMuted());
      renderSoundButton();
    });

    // Gaze

    const gazeTowards = (eye: HTMLElement): Gaze => {
      if (!pointer) {
        return { x: 0, y: 0.15 };
      }

      const rect = eye.getBoundingClientRect();
      const dx = pointer.x - (rect.left + rect.width / 2);
      const dy = pointer.y - (rect.top + rect.height / 2);
      const distance = Math.hypot(dx, dy) || 1;
      const strength = Math.min(1, distance / 160);

      return { x: (dx / distance) * strength, y: (dy / distance) * strength };
    };

    const renderGaze = () => {
      pointerFrame = null;

      pupilElements.forEach((pupil, index) => {
        const gaze = gazeOverride ?? gazeTowards(eyeElements[index]);
        pupil.style.transform = `translate(${gaze.x * MAX_PUPIL_TRAVEL.x}px, ${gaze.y * MAX_PUPIL_TRAVEL.y}px)`;
      });
    };

    const requestGazeRender = () => {
      if (pointerFrame === null) {
        pointerFrame = requestAnimationFrame(renderGaze);
      }
    };

    const setGazeOverride = (gaze: Gaze | null) => {
      gazeOverride = gaze;
      requestGazeRender();
    };

    const onPointerMove = (event: PointerEvent) => {
      pointer = { x: event.clientX, y: event.clientY };
      requestGazeRender();
    };

    // Body moves: exactly one body animation runs at a time.

    const stopMove = () => {
      bodyAnimation?.cancel();
      bodyAnimation = null;
      browAnimations.forEach((animation) => animation.cancel());
      browAnimations = [];
      gazeTimers.forEach((timer) => clearTimeout(timer));
      gazeTimers = [];
      setGazeOverride(null);
    };

    const startBreathing = () => {
      if (reducedMotion.matches || !isOut || isDragging) {
        return;
      }

      bodyAnimation?.cancel();
      bodyAnimation = svg.animate(
        [
          { transform: 'scale(1, 1)' },
          { transform: 'scale(1.014, 0.982) rotate(0.8deg)' }
        ],
        { duration: 1800, direction: 'alternate', iterations: Infinity, easing: 'ease-in-out' }
      );
    };

    // Resolves true when the move ran to the end, false when something interrupted it.
    const play = async (name: MoveName): Promise<boolean> => {
      stopMove();

      if (reducedMotion.matches) {
        return true;
      }

      const move = MOVES[name];
      const animation = svg.animate(move.body, { duration: move.duration });
      bodyAnimation = animation;

      move.brows?.forEach((frames, index) => {
        browAnimations.push(browElements[index].animate(frames, { duration: move.duration }));
      });
      move.gaze?.forEach(([delay, gaze]) => {
        gazeTimers.push(window.setTimeout(() => setGazeOverride(gaze), delay));
      });

      if (name === 'attention') {
        sounds.knocks();
      }

      try {
        await animation.finished;
      } catch {
        return false;
      }

      if (bodyAnimation === animation) {
        stopMove();
        startBreathing();
      }

      return true;
    };

    // Speech bubble

    const updateBubbleSide = () => {
      const rect = character.getBoundingClientRect();
      widget.classList.toggle('bubble-left', rect.left < window.innerWidth / 2);
      widget.classList.toggle('bubble-bottom', rect.top < 220);
    };

    const pauseAutoClose = () => {
      clearTimeout(autoCloseTimer);
      autoCloseTimer = undefined;
    };

    const openBubble = () => {
      const wasOpen = isBubbleOpen;
      currentTake = takes.next();
      quoteElement.textContent = currentTake;
      acknowledgeButton.textContent = DISMISS_LABELS[Math.floor(Math.random() * DISMISS_LABELS.length)];
      isBubbleOpen = true;
      updateBubbleSide();
      bubble.classList.add('is-open');
      sounds.newTake();

      if (wasOpen && !reducedMotion.matches) {
        bubble.animate(
          [{ transform: 'scale(0.96)' }, { transform: 'scale(1.015)', offset: 0.6 }, { transform: 'scale(1)' }],
          { duration: 320, easing: 'ease-out' }
        );
      }

      pauseAutoClose();
      clearTimeout(nextTakeTimer);
      autoCloseTimer = window.setTimeout(() => closeBubble(), BUBBLE_READING_MS);
    };

    const closeBubble = () => {
      isBubbleOpen = false;
      bubble.classList.remove('is-open');
      pauseAutoClose();
      scheduleNextTake();
    };

    // Takes are staged: a move or two first, then the bubble. Starting a new run
    // invalidates the previous one, so overlapping clicks never double-open.
    const showTake = async (intro: MoveName[]) => {
      const run = ++introRun;
      isIntroPlaying = true;
      clearTimeout(nextTakeTimer);

      for (const name of intro) {
        const completed = await play(name);

        if (run !== introRun || !isOut) {
          return;
        }

        // A drag interrupts the move but still owes the reader a take.
        if (!completed) {
          break;
        }
      }

      isIntroPlaying = false;
      openBubble();

      if (!isDragging) {
        void play('browRaise');
      }
    };

    const scheduleNextTake = () => {
      clearTimeout(nextTakeTimer);

      if (!isOut) {
        return;
      }

      nextTakeTimer = window.setTimeout(
        () => {
          if (isOut && !isBubbleOpen && !isDragging) {
            void showTake(['attention', 'think']);
          }
        },
        40000 + Math.random() * 20000
      );
    };

    // Idle life

    const scheduleIdleMove = () => {
      clearTimeout(idleTimer);

      if (reducedMotion.matches || !isOut) {
        return;
      }

      idleTimer = window.setTimeout(
        () => {
          if (!isTravelling && !isDragging && !isIntroPlaying) {
            void play(IDLE_MOVES[Math.floor(Math.random() * IDLE_MOVES.length)]);
          }

          scheduleIdleMove();
        },
        6000 + Math.random() * 5000
      );
    };

    // Entering and leaving

    const offsetToWord = (): Offset => {
      const word = trigger.getBoundingClientRect();
      const rest = character.getBoundingClientRect();

      return {
        dx: word.left + word.width / 2 - (rest.left + rest.width / 2),
        dy: word.top + word.height / 2 - (rest.top + rest.height / 2)
      };
    };

    const setTriggerExpanded = (expanded: boolean) => {
      trigger.setAttribute('aria-expanded', String(expanded));
    };

    const summon = async () => {
      if (isTravelling) {
        return;
      }

      if (isOut) {
        void showTake(['attention', 'think']);

        return;
      }

      isOut = true;
      isTravelling = true;
      setTriggerExpanded(true);
      widget.classList.add('is-out');
      updateBubbleSide();
      window.addEventListener('pointermove', onPointerMove, { passive: true });

      if (!reducedMotion.matches) {
        sounds.summon();
        const height = character.offsetHeight;

        await character.animate(enterKeyframes(offsetToWord(), height), {
          duration: ENTER_MS,
          easing: 'linear',
          fill: 'backwards'
        }).finished;
      }

      isTravelling = false;
      startBreathing();
      scheduleIdleMove();
      void showTake(['greet', 'think']);
    };

    const dismiss = async () => {
      if (!isOut || isTravelling) {
        return;
      }

      isTravelling = true;
      introRun++;
      isIntroPlaying = false;
      isBubbleOpen = false;
      bubble.classList.remove('is-open');
      pauseAutoClose();
      clearTimeout(nextTakeTimer);
      clearTimeout(idleTimer);

      if (!reducedMotion.matches) {
        sounds.goodbye();
        await play('goodbye');

        await character.animate(exitKeyframes(offsetToWord(), character.offsetHeight), {
          duration: EXIT_MS,
          easing: 'linear',
          fill: 'forwards'
        }).finished;
      }

      const hadFocus = widget.contains(document.activeElement);
      stopMove();
      character.getAnimations().forEach((animation) => animation.cancel());
      widget.classList.remove('is-out');
      window.removeEventListener('pointermove', onPointerMove);
      isOut = false;
      isTravelling = false;
      setTriggerExpanded(false);

      if (hadFocus) {
        trigger.focus();
      }
    };

    trigger.addEventListener('click', () => {
      sounds.unlock();
      void summon();
    });

    closeButton.addEventListener('click', () => void dismiss());
    acknowledgeButton.addEventListener('click', closeBubble);

    shareButton.addEventListener('click', () => {
      const text = `"${currentTake}" — Clippy 📎`;
      const url = `https://twitter.com/intent/tweet?text=${encodeURIComponent(text)}&url=${encodeURIComponent(window.location.origin)}`;
      window.open(url, '_blank', 'noopener,noreferrer,width=550,height=420');
    });

    bubble.addEventListener('mouseenter', pauseAutoClose);
    bubble.addEventListener('mouseleave', () => {
      if (isBubbleOpen && autoCloseTimer === undefined) {
        autoCloseTimer = window.setTimeout(() => closeBubble(), BUBBLE_READING_MS / 2);
      }
    });

    // Dragging

    let dragStart = { pointerX: 0, pointerY: 0, left: 0, top: 0 };
    let hasMoved = false;

    character.addEventListener('pointerdown', (event) => {
      if (event.button !== 0 || isTravelling) {
        return;
      }

      const rect = character.getBoundingClientRect();
      isDragging = true;
      hasMoved = false;
      dragStart = { pointerX: event.clientX, pointerY: event.clientY, left: rect.left, top: rect.top };

      widget.style.right = 'auto';
      widget.style.bottom = 'auto';
      widget.style.left = `${rect.left}px`;
      widget.style.top = `${rect.top}px`;

      character.setPointerCapture(event.pointerId);
      widget.classList.add('is-dragging');
      stopMove();
    });

    character.addEventListener('pointermove', (event) => {
      if (!isDragging) {
        return;
      }

      const deltaX = event.clientX - dragStart.pointerX;
      const deltaY = event.clientY - dragStart.pointerY;
      hasMoved = hasMoved || Math.hypot(deltaX, deltaY) > 5;

      const margin = 14;
      const maxLeft = Math.max(margin, window.innerWidth - character.offsetWidth - margin);
      const maxTop = Math.max(margin, window.innerHeight - character.offsetHeight - margin);
      const left = Math.min(Math.max(dragStart.left + deltaX, margin), maxLeft);
      const top = Math.min(Math.max(dragStart.top + deltaY, margin), maxTop);

      widget.style.left = `${left}px`;
      widget.style.top = `${top}px`;
      updateBubbleSide();
    });

    const endDrag = () => {
      if (!isDragging) {
        return;
      }

      isDragging = false;
      widget.classList.remove('is-dragging');
      startBreathing();

      if (!hasMoved) {
        void showTake(['think']);
      } else {
        sounds.drop();
      }
    };

    character.addEventListener('pointerup', endDrag);
    character.addEventListener('pointercancel', endDrag);

    character.addEventListener('dblclick', () => {
      introRun++;
      isIntroPlaying = false;
      void play('dance');
    });

    widget.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isBubbleOpen) {
        closeBubble();
      } else if ((event.key === 'Enter' || event.key === ' ') && event.target === character) {
        event.preventDefault();
        void showTake(['think']);
      }
    });

  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initClippy);
  } else {
    initClippy();
  }
</script>
