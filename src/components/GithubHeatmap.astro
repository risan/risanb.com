---
import githubData from '../data/github-contributions.json';

interface Props {
  /** Optional custom section class */
  class?: string;
}

const { class: className = '' } = Astro.props;

const { stats, calendar, username } = githubData;

// Format numbers with commas (e.g., 5,639)
const formatNumber = (n: number) => n.toLocaleString('en-US');

// Heatmap dimensions & layout constants
const CELL_SIZE = 10;
const CELL_GAP = 3;
const STEP = CELL_SIZE + CELL_GAP; // 13px per column/row
const X_OFFSET = 30; // space on left for Mon, Wed, Fri labels
const Y_OFFSET = 20; // space on top for Month labels

const weeks = calendar.weeks;
const totalWeeks = weeks.length;
const svgWidth = X_OFFSET + totalWeeks * STEP;
const svgHeight = Y_OFFSET + 7 * STEP;

// Calculate month label positions (first week where a new month appears)
interface MonthLabel {
  name: string;
  x: number;
}
const monthLabels: MonthLabel[] = [];
let lastMonth = -1;
const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

weeks.forEach((week, wIndex) => {
  const firstValidDay = week.contributionDays[0];
  if (firstValidDay) {
    const d = new Date(firstValidDay.date);
    const m = d.getUTCMonth();
    if (m !== lastMonth) {
      // Ensure there is room to print (at least 2 weeks apart from previous label)
      const prev = monthLabels[monthLabels.length - 1];
      const x = X_OFFSET + wIndex * STEP;
      if (!prev || x - prev.x >= 24) {
        monthLabels.push({ name: monthNames[m]!, x });
        lastMonth = m;
      }
    }
  }
});
// Trimmed recent weeks for smaller screens so no horizontal scroll is required (~5 months / 21 weeks)
const MOBILE_WEEKS_COUNT = 21;
const mobileWeeks = weeks.slice(-MOBILE_WEEKS_COUNT);
const mobileStartIndex = totalWeeks - MOBILE_WEEKS_COUNT;
const mobileSvgWidth = X_OFFSET + mobileWeeks.length * STEP;
const mobileMonthLabels: MonthLabel[] = [];
let mobileLastMonth = -1;

mobileWeeks.forEach((week, wIndex) => {
  const firstValidDay = week.contributionDays[0];
  if (firstValidDay) {
    const d = new Date(firstValidDay.date);
    const m = d.getUTCMonth();
    if (m !== mobileLastMonth) {
      const prev = mobileMonthLabels[mobileMonthLabels.length - 1];
      const x = X_OFFSET + wIndex * STEP;
      if (!prev || x - prev.x >= 24) {
        mobileMonthLabels.push({ name: monthNames[m]!, x });
        mobileLastMonth = m;
      }
    }
  }
});
// Quartile color level mappings (0 to 4)
const levelClassMap: Record<string, string> = {
  NONE: 'gh-cell-0',
  FIRST_QUARTILE: 'gh-cell-1',
  SECOND_QUARTILE: 'gh-cell-2',
  THIRD_QUARTILE: 'gh-cell-3',
  FOURTH_QUARTILE: 'gh-cell-4',
};

const formatDate = (dateStr: string) => {
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
};

// Flatten all days to compute advanced statistics
const allDays = weeks.flatMap((w) => w.contributionDays);

// 1. Peak / Busiest day
let peakDay = { count: 0, date: '' };
for (const day of allDays) {
  if (day.contributionCount > peakDay.count) {
    peakDay = { count: day.contributionCount, date: day.date };
  }
}
const peakDateFormatted = peakDay.date ? formatDate(peakDay.date) : '';

// 2. Trailing 7 days (this week)
const last7Days = allDays.slice(-7);
const thisWeekTotal = last7Days.reduce((sum, d) => sum + d.contributionCount, 0);

// 3. Current streak (consecutive days with contributions > 0)
let currentStreak = 0;
for (let i = allDays.length - 1; i >= 0; i--) {
  if (allDays[i]!.contributionCount > 0) {
    currentStreak++;
  } else {
    if (i === allDays.length - 1) continue;
    break;
  }
}

// 4. Daily average for current month
const daysPassedInMonth = Math.max(1, new Date().getUTCDate());
const dailyAvgThisMonth = (stats.thisMonth.contributions / daysPassedInMonth).toFixed(1);

// 5. Account history span
const startYear = 2013;
const currentYear = new Date().getUTCFullYear();
const yearsActive = currentYear - startYear;
---

<section class={`github-activity section-block ${className}`}>
  <div class="activity-header">
    <div>
      <p class="eyebrow">Vanity Metrics</p>
      <h2>{formatNumber(calendar.totalContributions)} contributions in the last year</h2>
    </div>
  </div>

  {/* Stats Cards: This Week, This Month, This Year, All Time */}
  <div class="stats-grid">
    <div class="stat-card">
      <span class="stat-label">This Week</span>
      <span class="stat-value">{formatNumber(thisWeekTotal)}</span>
      <span class="stat-detail">{currentStreak}-day active streak</span>
    </div>

    <div class="stat-card">
      <span class="stat-label">This Month</span>
      <span class="stat-value">{formatNumber(stats.thisMonth.contributions)}</span>
      <span class="stat-detail">~{dailyAvgThisMonth} / day avg</span>
    </div>

    <div class="stat-card">
      <span class="stat-label">This Year</span>
      <span class="stat-value">{formatNumber(stats.thisYear.contributions)}</span>
      <span class="stat-detail">Peak: {peakDay.count} on {peakDateFormatted}</span>
    </div>

    <div class="stat-card">
      <span class="stat-label">All Time</span>
      <span class="stat-value">{formatNumber(stats.allTime.contributions)}</span>
      <span class="stat-detail">{yearsActive} years · since {startYear}</span>
    </div>
  </div>

  {/* Heatmap Card */}
  <div class="heatmap-card">
    <div class="heatmap-scroll" tabindex="0" role="region" aria-label="GitHub contribution calendar">
      {/* Desktop Heatmap (Full 53 Weeks) */}
      <svg
        viewBox={`0 0 ${svgWidth} ${svgHeight}`}
        class="heatmap-svg heatmap-svg--desktop"
        role="img"
        aria-label={`GitHub contribution heatmap for @${username}`}
      >
        {/* Month labels */}
        {
          monthLabels.map((m) => (
            <text x={m.x} y={12} class="label-month">
              {m.name}
            </text>
          ))
        }

        {/* Day of week labels: Mon (1), Wed (3), Fri (5) */}
        <text x={2} y={Y_OFFSET + 1 * STEP + 8} class="label-weekday">
          Mon
        </text>
        <text x={2} y={Y_OFFSET + 3 * STEP + 8} class="label-weekday">
          Wed
        </text>
        <text x={2} y={Y_OFFSET + 5 * STEP + 8} class="label-weekday">
          Fri
        </text>

        {/* Contribution cells */}
        {
          weeks.map((week, wIndex) => {
            const x = X_OFFSET + wIndex * STEP;
            const weekTotal = week.contributionDays.reduce((sum, d) => sum + d.contributionCount, 0);
            const weekMaxLevel = week.contributionDays.reduce((max, d) => {
              const lvlNum = d.contributionLevel === 'FOURTH_QUARTILE' ? 4 :
                             d.contributionLevel === 'THIRD_QUARTILE' ? 3 :
                             d.contributionLevel === 'SECOND_QUARTILE' ? 2 :
                             d.contributionLevel === 'FIRST_QUARTILE' ? 1 : 0;
              return Math.max(max, lvlNum);
            }, 0);
            return (
              <g
                class="heatmap-week"
                data-week-index={wIndex}
                data-total={weekTotal}
                data-max-level={weekMaxLevel}
              >
                {/* Full column hitbox for effortless scrubbing */}
                <rect
                  x={x - 1.5}
                  y={Y_OFFSET}
                  width={STEP}
                  height={7 * STEP}
                  fill="transparent"
                  class="heatmap-column-hitbox"
                  aria-hidden="true"
                />
                {week.contributionDays.map((day) => {
                  const y = Y_OFFSET + day.weekday * STEP;
                  const levelClass = levelClassMap[day.contributionLevel] || 'gh-cell-0';
                  const levelNum = day.contributionLevel === 'FOURTH_QUARTILE' ? 4 :
                                 day.contributionLevel === 'THIRD_QUARTILE' ? 3 :
                                 day.contributionLevel === 'SECOND_QUARTILE' ? 2 :
                                 day.contributionLevel === 'FIRST_QUARTILE' ? 1 : 0;
                  const titleText = `${day.contributionCount} contribution${day.contributionCount === 1 ? '' : 's'} on ${formatDate(day.date)}`;
                  return (
                    <rect
                      x={x}
                      y={y}
                      width={CELL_SIZE}
                      height={CELL_SIZE}
                      rx={2}
                      ry={2}
                      class={`gh-cell ${levelClass}`}
                      data-week={wIndex}
                      data-day={day.weekday}
                      data-date={day.date}
                      data-count={day.contributionCount}
                      data-level={levelNum}
                    >
                      <title>{titleText}</title>
                    </rect>
                  );
                })}
              </g>
            );
          })
        }
      </svg>

      {/* Mobile Heatmap (Trimmed ~5 Months / 21 Weeks - Fits Screen Without Scroll) */}
      <svg
        viewBox={`0 0 ${mobileSvgWidth} ${svgHeight}`}
        class="heatmap-svg heatmap-svg--mobile"
        role="img"
        aria-label={`GitHub contribution heatmap for @${username} (recent activity)`}
      >
        {/* Month labels */}
        {
          mobileMonthLabels.map((m) => (
            <text x={m.x} y={12} class="label-month">
              {m.name}
            </text>
          ))
        }

        {/* Day of week labels: Mon (1), Wed (3), Fri (5) */}
        <text x={2} y={Y_OFFSET + 1 * STEP + 8} class="label-weekday">
          Mon
        </text>
        <text x={2} y={Y_OFFSET + 3 * STEP + 8} class="label-weekday">
          Wed
        </text>
        <text x={2} y={Y_OFFSET + 5 * STEP + 8} class="label-weekday">
          Fri
        </text>

        {/* Contribution cells */}
        {
          mobileWeeks.map((week, mIndex) => {
            const wIndex = mobileStartIndex + mIndex;
            const x = X_OFFSET + mIndex * STEP;
            const weekTotal = week.contributionDays.reduce((sum, d) => sum + d.contributionCount, 0);
            const weekMaxLevel = week.contributionDays.reduce((max, d) => {
              const lvlNum = d.contributionLevel === 'FOURTH_QUARTILE' ? 4 :
                             d.contributionLevel === 'THIRD_QUARTILE' ? 3 :
                             d.contributionLevel === 'SECOND_QUARTILE' ? 2 :
                             d.contributionLevel === 'FIRST_QUARTILE' ? 1 : 0;
              return Math.max(max, lvlNum);
            }, 0);
            return (
              <g
                class="heatmap-week"
                data-week-index={wIndex}
                data-total={weekTotal}
                data-max-level={weekMaxLevel}
              >
                <rect
                  x={x - 1.5}
                  y={Y_OFFSET}
                  width={STEP}
                  height={7 * STEP}
                  fill="transparent"
                  class="heatmap-column-hitbox"
                  aria-hidden="true"
                />
                {week.contributionDays.map((day) => {
                  const y = Y_OFFSET + day.weekday * STEP;
                  const levelClass = levelClassMap[day.contributionLevel] || 'gh-cell-0';
                  const levelNum = day.contributionLevel === 'FOURTH_QUARTILE' ? 4 :
                                 day.contributionLevel === 'THIRD_QUARTILE' ? 3 :
                                 day.contributionLevel === 'SECOND_QUARTILE' ? 2 :
                                 day.contributionLevel === 'FIRST_QUARTILE' ? 1 : 0;
                  const titleText = `${day.contributionCount} contribution${day.contributionCount === 1 ? '' : 's'} on ${formatDate(day.date)}`;
                  return (
                    <rect
                      x={x}
                      y={y}
                      width={CELL_SIZE}
                      height={CELL_SIZE}
                      rx={2}
                      ry={2}
                      class={`gh-cell ${levelClass}`}
                      data-week={wIndex}
                      data-day={day.weekday}
                      data-date={day.date}
                      data-count={day.contributionCount}
                      data-level={levelNum}
                    >
                      <title>{titleText}</title>
                    </rect>
                  );
                })}
              </g>
            );
          })
        }
      </svg>
    </div>

    {/* Actions Toolbar: Both "Synth" and "@risan" placed below heatmap, right above footer */}
    <div class="heatmap-bar">
      <button
        id="heatmap-synth-toggle"
        class="heatmap-sound-btn heatmap-synth-btn"
        type="button"
        aria-expanded="false"
        aria-controls="heatmap-synth-panel"
        aria-label="Toggle contribution tone synthesizer"
        title="Toggle contribution tone synthesizer"
      >
        <svg class="synth-btn-icon synth-icon-on" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" y1="21" x2="4" y2="14"></line>
          <line x1="4" y1="10" x2="4" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12" y2="3"></line>
          <line x1="20" y1="21" x2="20" y2="16"></line>
          <line x1="20" y1="12" x2="20" y2="3"></line>
          <line x1="1" y1="14" x2="7" y2="14"></line>
          <line x1="9" y1="8" x2="15" y2="8"></line>
          <line x1="17" y1="16" x2="23" y2="16"></line>
        </svg>
        <svg class="synth-btn-icon synth-icon-off" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none;">
          <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
          <line x1="23" y1="9" x2="17" y2="15"></line>
          <line x1="17" y1="9" x2="23" y2="15"></line>
        </svg>
        <span class="sound-label">Synth</span>
        <span class="synth-chevron" aria-hidden="true">▾</span>
      </button>

      <a
        href={`https://github.com/${username}`}
        target="_blank"
        rel="noopener noreferrer"
        class="profile-link"
        aria-label={`View @${username} on GitHub`}
      >
        <svg class="github-icon" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        <span>@{username}</span>
        <span class="external-arrow" aria-hidden="true">↗</span>
      </a>
    </div>

    {/* Expandable Synth Console inside heatmap card, below the heatmap & bar */}
    <div
      id="heatmap-synth-panel"
      class="heatmap-synth-panel"
      role="region"
      aria-label="Heatmap Synthesizer Controls"
      hidden
    >
      <div class="synth-panel-header">
        <div class="synth-title-group">
          <span class="synth-title">Tone Synthesizer</span>
          <span class="synth-subtitle">Interactive Sound Engine</span>
        </div>

        <div class="synth-header-controls">
          <button
            type="button"
            id="synth-mute-btn"
            class="synth-mute-toggle"
            aria-pressed="false"
            title="Mute or unmute tone audio"
          >
            <span class="mute-dot" aria-hidden="true"></span>
            <span class="mute-text">Sound ON</span>
          </button>

          <button
            type="button"
            id="synth-test-btn"
            class="synth-header-btn synth-test-btn"
            title="Preview sample note"
          >
            <svg class="play-icon" width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <polygon points="5 3 19 12 5 21 5 3"></polygon>
            </svg>
            <span>Preview</span>
          </button>

          <button
            type="button"
            id="synth-reset-btn"
            class="synth-header-btn synth-reset-btn"
            title="Reset to default settings"
          >
            Reset
          </button>

          <button
            type="button"
            id="synth-close-btn"
            class="synth-close-btn"
            aria-label="Close synthesizer controls"
            title="Close synthesizer panel"
          >
            ✕
          </button>
        </div>
      </div>

      <div class="synth-panel-grid">
        <!-- Col 1: Presets & Waveform -->
        <div class="synth-col synth-col--voice">
          <div class="synth-section">
            <div class="synth-section-label">Presets</div>
            <div class="synth-presets-grid">
              <button type="button" class="synth-preset-chip" data-preset="chimes" title="Soft chiming bell tones">
                <svg class="preset-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
                  <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
                </svg>
                <span>Chimes</span>
              </button>
              <button type="button" class="synth-preset-chip" data-preset="retro" title="Punchy vintage 8-bit square wave">
                <svg class="preset-svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M6 2h2v2H6zm10 0h2v2h-2zM4 6h2v2H4zm14 0h2v2h-2zM2 8h2v8H2zm4 8h2v2H6zm12 0h2v2h-2zm2-8h2v8h-2zM6 8h12v6H6zm2 2h2v2H8zm6 0h2v2h-2z"></path>
                </svg>
                <span>8-Bit</span>
              </button>
              <button type="button" class="synth-preset-chip" data-preset="pad" title="Warm ambient swelling pad with reverb">
                <svg class="preset-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M2 12c3-3 7-3 10 0s7 3 10 0"></path>
                  <path d="M2 6c3-3 7-3 10 0s7 3 10 0" opacity="0.45"></path>
                  <path d="M2 18c3-3 7-3 10 0s7 3 10 0" opacity="0.45"></path>
                </svg>
                <span>Pad</span>
              </button>
              <button type="button" class="synth-preset-chip" data-preset="cosmic" title="Rich buzz with rhythmic canyon echo">
                <svg class="preset-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="3"></circle>
                  <path d="M12 2v3m0 14v3M2 12h3m14 0h3m-3.5-6.5l-2.1 2.1m-8.8 8.8l-2.1 2.1m0-13l2.1 2.1m8.8 8.8l2.1 2.1"></path>
                </svg>
                <span>Cosmic</span>
              </button>
            </div>
          </div>

          <div class="synth-section">
            <div class="synth-section-label">Waveform <span class="synth-param-hint">(Tone Character)</span></div>
            <div class="synth-wave-selector" role="radiogroup" aria-label="Select synthesizer waveform">
              <label class="wave-option">
                <input type="radio" name="synth-wave" value="sine" />
                <span class="wave-pill">
                  <span class="wave-symbol">∿</span>
                  <span class="wave-name">Sin</span>
                </span>
              </label>
              <label class="wave-option">
                <input type="radio" name="synth-wave" value="triangle" checked />
                <span class="wave-pill">
                  <span class="wave-symbol">△</span>
                  <span class="wave-name">Tri</span>
                </span>
              </label>
              <label class="wave-option">
                <input type="radio" name="synth-wave" value="square" />
                <span class="wave-pill">
                  <span class="wave-symbol">⊓</span>
                  <span class="wave-name">Square</span>
                </span>
              </label>
              <label class="wave-option">
                <input type="radio" name="synth-wave" value="sawtooth" />
                <span class="wave-pill">
                  <span class="wave-symbol">⋀</span>
                  <span class="wave-name">Saw</span>
                </span>
              </label>
            </div>
          </div>
        </div>

        <!-- Sliders wrapper: side-by-side columns on mobile, contents on desktop -->
        <div class="synth-sliders-wrapper">
          <!-- Col 2: Envelope Sliders -->
          <div class="synth-col synth-col--envelope">
            <div class="synth-section-label">Envelope <span class="synth-param-hint">(Shape Over Time)</span></div>

            <div class="synth-slider-row">
              <div class="synth-slider-meta">
                <span class="slider-name">Attack</span>
                <span class="slider-helper">Hit speed</span>
                <span id="synth-val-attack" class="slider-value">5ms</span>
              </div>
              <input
                id="synth-slider-attack"
                type="range"
                min="0.002"
                max="0.25"
                step="0.004"
                value="0.005"
                aria-label="Attack time"
              />
            </div>

            <div class="synth-slider-row">
              <div class="synth-slider-meta">
                <span class="slider-name">Decay</span>
                <span class="slider-helper">Fade time</span>
                <span id="synth-val-decay" class="slider-value">0.35s</span>
              </div>
              <input
                id="synth-slider-decay"
                type="range"
                min="0.08"
                max="1.2"
                step="0.02"
                value="0.35"
                aria-label="Decay time"
              />
            </div>

            <div class="synth-slider-row">
              <div class="synth-slider-meta">
                <span class="slider-name">Sustain</span>
                <span class="slider-helper">Hold level</span>
                <span id="synth-val-sustain" class="slider-value">5%</span>
              </div>
              <input
                id="synth-slider-sustain"
                type="range"
                min="0"
                max="0.6"
                step="0.02"
                value="0.05"
                aria-label="Sustain volume"
              />
            </div>
          </div>

          <!-- Col 3: Effects Sliders -->
          <div class="synth-col synth-col--effects">
            <div class="synth-section-label">Effects <span class="synth-param-hint">(Space & Acoustics)</span></div>

            <div class="synth-slider-row">
              <div class="synth-slider-meta">
                <span class="slider-name">Echo</span>
                <span class="slider-helper">Rhythmic delay</span>
                <span id="synth-val-echo" class="slider-value">15%</span>
              </div>
              <input
                id="synth-slider-echo"
                type="range"
                min="0"
                max="0.6"
                step="0.02"
                value="0.15"
                aria-label="Echo delay amount"
              />
            </div>

            <div class="synth-slider-row">
              <div class="synth-slider-meta">
                <span class="slider-name">Reverb</span>
                <span class="slider-helper">Room acoustics</span>
                <span id="synth-val-reverb" class="slider-value">25%</span>
              </div>
              <input
                id="synth-slider-reverb"
                type="range"
                min="0"
                max="1.0"
                step="0.05"
                value="0.25"
                aria-label="Reverb space amount"
              />
            </div>

            <div class="synth-tip-box">
              <span class="synth-tip-dot" aria-hidden="true"></span>
              <span>Hover or scrub heatmap cells to play live tones. Darker cells ring higher harmonics.</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Footer: Explanatory note & Legend (Image #1) */}
    <div class="heatmap-footer">
      <span class="footer-note">
        Verified GitHub activity across public and client repositories. None of this measures code quality.
      </span>
      <div class="heatmap-legend" role="group" aria-label="Activity legend">
        <span class="legend-text">Out of tokens</span>
        <div class="legend-cells" aria-hidden="true">
          <span class="legend-cell gh-cell-0"></span>
          <span class="legend-cell gh-cell-1"></span>
          <span class="legend-cell gh-cell-2"></span>
          <span class="legend-cell gh-cell-3"></span>
          <span class="legend-cell gh-cell-4"></span>
        </div>
        <span class="legend-text">Approaching deadline</span>
      </div>
    </div>
  </div>

  <script>
    // Maintain initial scroll position at the recent right edge
    const scroll = document.querySelector('.heatmap-scroll');
    if (scroll) {
      scroll.scrollLeft = scroll.scrollWidth;
    }

    // Extended pentatonic scale across 5 octaves (zero dissonance, beautiful chime timbre)
    const PENTATONIC = [
      130.81, // C3
      146.83, // D3
      164.81, // E3
      196.00, // G3
      220.00, // A3
      261.63, // C4
      293.66, // D4
      329.63, // E4
      392.00, // G4
      440.00, // A4
      523.25, // C5
      587.33, // D5
      659.25, // E5
      783.99, // G5
      880.00, // A5
      1046.50, // C6
      1174.66, // D6
      1318.51, // E6
      1567.98, // G6
      1760.00, // A6
      2093.00, // C7
      2349.32, // D7
      2637.02  // E7
    ];

    interface SynthConfig {
      muted: boolean;
      preset?: string;
      wave: OscillatorType;
      attack: number;
      decay: number;
      sustain: number;
      echo: number;
      reverb: number;
    }

    const DEFAULT_CONFIG: SynthConfig = {
      muted: false,
      preset: 'chimes',
      wave: 'triangle',
      attack: 0.005,
      decay: 0.35,
      sustain: 0.05,
      echo: 0.15,
      reverb: 0.25,
    };

    const PRESETS: Record<string, Partial<SynthConfig>> = {
      chimes: {
        wave: 'triangle',
        attack: 0.005,
        decay: 0.35,
        sustain: 0.05,
        echo: 0.15,
        reverb: 0.25,
      },
      retro: {
        wave: 'square',
        attack: 0.002,
        decay: 0.15,
        sustain: 0.0,
        echo: 0.0,
        reverb: 0.0,
      },
      pad: {
        wave: 'sine',
        attack: 0.14,
        decay: 0.6,
        sustain: 0.35,
        echo: 0.2,
        reverb: 0.65,
      },
      cosmic: {
        wave: 'sawtooth',
        attack: 0.01,
        decay: 0.45,
        sustain: 0.1,
        echo: 0.45,
        reverb: 0.5,
      },
    };

    class HeatmapSoundEngine {
      private ctx: AudioContext | null = null;
      private masterGain: GainNode | null = null;
      private reverbNode: ConvolverNode | null = null;
      private reverbGain: GainNode | null = null;
      private echoDelay: DelayNode | null = null;
      private echoGain: GainNode | null = null;
      public config: SynthConfig;

      constructor() {
        const reducedMotion = typeof window !== 'undefined' && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let saved: Partial<SynthConfig> = {};
        try {
          const raw = localStorage.getItem('heatmap_synth_config');
          if (raw) saved = JSON.parse(raw);
        } catch {}

        this.config = {
          ...DEFAULT_CONFIG,
          ...saved,
          muted: reducedMotion || saved.muted === true || (typeof window !== 'undefined' && localStorage.getItem('heatmap_sound') === 'muted'),
        };
      }

      public saveConfig() {
        try {
          localStorage.setItem('heatmap_synth_config', JSON.stringify(this.config));
          localStorage.setItem('heatmap_sound', this.config.muted ? 'muted' : 'unmuted');
        } catch {}
      }

      private createReverbImpulse(ctx: AudioContext, duration = 1.4, decay = 2.0): AudioBuffer {
        const sampleRate = ctx.sampleRate;
        const length = Math.floor(sampleRate * duration);
        const buffer = ctx.createBuffer(2, length, sampleRate);
        for (let c = 0; c < 2; c++) {
          const channelData = buffer.getChannelData(c);
          for (let i = 0; i < length; i++) {
            channelData[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / length, decay);
          }
        }
        return buffer;
      }

      public initContext(): AudioContext | null {
        if (!this.ctx && typeof window !== 'undefined') {
          const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
          if (AudioCtx) {
            const ctx = new AudioCtx();
            this.ctx = ctx;

            // Dynamics compressor to prevent clipping
            const compressor = ctx.createDynamicsCompressor();
            compressor.threshold.setValueAtTime(-18, ctx.currentTime);
            compressor.knee.setValueAtTime(12, ctx.currentTime);
            compressor.ratio.setValueAtTime(8, ctx.currentTime);
            compressor.attack.setValueAtTime(0.003, ctx.currentTime);
            compressor.release.setValueAtTime(0.15, ctx.currentTime);
            compressor.connect(ctx.destination);

            // Master Gain
            const masterGain = ctx.createGain();
            masterGain.gain.setValueAtTime(this.config.muted ? 0 : 0.85, ctx.currentTime);
            masterGain.connect(compressor);
            this.masterGain = masterGain;

            // Reverb Convolver & Gain
            try {
              const reverbNode = ctx.createConvolver();
              reverbNode.buffer = this.createReverbImpulse(ctx, 1.4, 2.2);
              const reverbGain = ctx.createGain();
              reverbGain.gain.setValueAtTime(this.config.reverb * 0.7, ctx.currentTime);
              reverbNode.connect(reverbGain);
              reverbGain.connect(masterGain);
              this.reverbNode = reverbNode;
              this.reverbGain = reverbGain;
            } catch {}

            // Echo Delay Loop
            try {
              const echoDelay = ctx.createDelay(1.0);
              echoDelay.delayTime.setValueAtTime(0.18, ctx.currentTime);
              const echoFeedback = ctx.createGain();
              echoFeedback.gain.setValueAtTime(0.35, ctx.currentTime);
              const echoGain = ctx.createGain();
              echoGain.gain.setValueAtTime(this.config.echo, ctx.currentTime);

              echoDelay.connect(echoFeedback);
              echoFeedback.connect(echoDelay);
              echoDelay.connect(echoGain);
              echoGain.connect(masterGain);

              this.echoDelay = echoDelay;
              this.echoGain = echoGain;
            } catch {}
          }
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume().catch(() => {});
        }
        return this.ctx;
      }

      public isMuted(): boolean {
        return this.config.muted;
      }

      public setMuted(muted: boolean) {
        this.config.muted = muted;
        if (this.masterGain && this.ctx) {
          this.masterGain.gain.setValueAtTime(muted ? 0 : 0.85, this.ctx.currentTime);
        }
        this.saveConfig();
      }

      public updateEffectNodes() {
        if (!this.ctx) return;
        const now = this.ctx.currentTime;
        if (this.echoGain) {
          this.echoGain.gain.setValueAtTime(this.config.echo, now);
        }
        if (this.reverbGain) {
          this.reverbGain.gain.setValueAtTime(this.config.reverb * 0.7, now);
        }
      }
      private pendingUnlockNote: { baseFreq: number; level: number } | null = null;

      public getContextState(): AudioContextState | null {
        return this.ctx ? this.ctx.state : null;
      }

      public playTone(baseFreq: number, level = 3) {
        if (this.config.muted) return;
        const ctx = this.initContext();
        if (!ctx || !this.masterGain) return;
        if (ctx.state === 'suspended') {
          this.pendingUnlockNote = { baseFreq, level };
          ctx.resume().then(() => {
            if (ctx.state === 'running' && this.pendingUnlockNote) {
              const note = this.pendingUnlockNote;
              this.pendingUnlockNote = null;
              this.playTone(note.baseFreq, note.level);
            }
          }).catch(() => {});
          return;
        }
        try {
          const now = ctx.currentTime;
          const wave = this.config.wave || 'triangle';

          // Compensate loudness so square/saw isn't piercing
          let scale = 1.0;
          if (wave === 'square') scale = 0.42;
          else if (wave === 'sawtooth') scale = 0.46;
          else if (wave === 'triangle') scale = 0.85;

          const peakVol = (0.04 + (level / 4) * 0.12) * scale;
          const attack = Math.max(0.002, this.config.attack);
          const decay = Math.max(0.06, this.config.decay);
          const sustainVol = Math.max(0.0001, peakVol * this.config.sustain);
          const duration = attack + decay;

          // Main oscillator
          const osc = ctx.createOscillator();
          const noteGain = ctx.createGain();
          osc.type = wave;
          osc.frequency.setValueAtTime(baseFreq, now);

          noteGain.gain.setValueAtTime(0.0001, now);
          noteGain.gain.exponentialRampToValueAtTime(peakVol, now + attack);
          noteGain.gain.exponentialRampToValueAtTime(sustainVol, now + attack + decay * 0.8);
          noteGain.gain.exponentialRampToValueAtTime(0.0001, now + duration);

          osc.connect(noteGain);
          noteGain.connect(this.masterGain);

          // Echo path
          if (this.echoDelay && this.config.echo > 0.01) {
            const sendEcho = ctx.createGain();
            sendEcho.gain.setValueAtTime(this.config.echo, now);
            noteGain.connect(sendEcho);
            sendEcho.connect(this.echoDelay);
          }

          // Reverb path
          if (this.reverbNode && this.config.reverb > 0.01) {
            const sendReverb = ctx.createGain();
            sendReverb.gain.setValueAtTime(this.config.reverb, now);
            noteGain.connect(sendReverb);
            sendReverb.connect(this.reverbNode);
          }

          osc.start(now);
          osc.stop(now + duration + 0.1);

          // Harmonic overtone for triangle/sine chime on high activity
          if ((wave === 'triangle' || wave === 'sine') && level >= 3) {
            const osc2 = ctx.createOscillator();
            const gain2 = ctx.createGain();
            osc2.type = 'sine';
            osc2.frequency.setValueAtTime(baseFreq * 2, now);

            gain2.gain.setValueAtTime(0.0001, now);
            gain2.gain.exponentialRampToValueAtTime(peakVol * 0.25, now + attack);
            gain2.gain.exponentialRampToValueAtTime(0.0001, now + duration * 0.7);

            osc2.connect(gain2);
            gain2.connect(this.masterGain);
            osc2.start(now);
            osc2.stop(now + duration * 0.7 + 0.05);
          }
        } catch {}
      }

      public playNote(weekIndex: number, weekday: number, count: number, level: number) {
        if (this.config.muted || count === 0 || level === 0) return;
        const weekBase = Math.round((weekIndex / 52) * 14);
        const dayOffset = 6 - weekday;
        const noteIndex = Math.min(PENTATONIC.length - 1, Math.max(0, weekBase + dayOffset));
        const baseFreq = PENTATONIC[noteIndex] || 440;
        this.playTone(baseFreq, level);
      }
    }

    function initHeatmapAudio() {
      const sound = new HeatmapSoundEngine();

      const synthToggleBtn = document.getElementById('heatmap-synth-toggle');
      const synthPanel = document.getElementById('heatmap-synth-panel');
      const synthCloseBtn = document.getElementById('synth-close-btn');
      const synthMuteBtn = document.getElementById('synth-mute-btn');
      const testBtn = document.getElementById('synth-test-btn');
      const resetBtn = document.getElementById('synth-reset-btn');

      const sliderAttack = document.getElementById('synth-slider-attack') as HTMLInputElement | null;
      const sliderDecay = document.getElementById('synth-slider-decay') as HTMLInputElement | null;
      const sliderSustain = document.getElementById('synth-slider-sustain') as HTMLInputElement | null;
      const sliderEcho = document.getElementById('synth-slider-echo') as HTMLInputElement | null;
      const sliderReverb = document.getElementById('synth-slider-reverb') as HTMLInputElement | null;

      const valAttack = document.getElementById('synth-val-attack');
      const valDecay = document.getElementById('synth-val-decay');
      const valSustain = document.getElementById('synth-val-sustain');
      const valEcho = document.getElementById('synth-val-echo');
      const valReverb = document.getElementById('synth-val-reverb');

      const presetChips = document.querySelectorAll<HTMLButtonElement>('.synth-preset-chip');
      const waveRadios = document.querySelectorAll<HTMLInputElement>('input[name="synth-wave"]');

      const updateMuteUI = () => {
        const isMuted = sound.isMuted();
        const iconOn = synthToggleBtn?.querySelector('.sound-icon-on') as HTMLElement | null;
        const iconOff = synthToggleBtn?.querySelector('.sound-icon-off') as HTMLElement | null;
        if (iconOn && iconOff) {
          iconOn.style.display = isMuted ? 'none' : 'inline';
          iconOff.style.display = isMuted ? 'inline' : 'none';
        }
        if (synthToggleBtn) {
          synthToggleBtn.classList.toggle('is-muted', isMuted);
          synthToggleBtn.setAttribute('title', isMuted ? 'Heatmap tone audio is muted' : 'Customize heatmap tones (Synthesizer)');
        }
        if (synthMuteBtn) {
          synthMuteBtn.classList.toggle('is-muted', isMuted);
          synthMuteBtn.setAttribute('aria-pressed', isMuted ? 'true' : 'false');
          const muteText = synthMuteBtn.querySelector('.mute-text');
          if (muteText) {
            muteText.textContent = isMuted ? 'Sound MUTED' : 'Sound ON';
          }
        }
      };

      const syncControlsToConfig = (activePresetName?: string) => {
        const cfg = sound.config;

        // Wave radio
        waveRadios.forEach((radio) => {
          radio.checked = radio.value === cfg.wave;
        });

        // Sliders & display values
        if (sliderAttack && valAttack) {
          sliderAttack.value = cfg.attack.toString();
          valAttack.textContent = `${Math.round(cfg.attack * 1000)}ms`;
        }
        if (sliderDecay && valDecay) {
          sliderDecay.value = cfg.decay.toString();
          valDecay.textContent = `${cfg.decay.toFixed(2)}s`;
        }
        if (sliderSustain && valSustain) {
          sliderSustain.value = cfg.sustain.toString();
          valSustain.textContent = `${Math.round(cfg.sustain * 100)}%`;
        }
        if (sliderEcho && valEcho) {
          sliderEcho.value = cfg.echo.toString();
          valEcho.textContent = `${Math.round(cfg.echo * 100)}%`;
        }
        if (sliderReverb && valReverb) {
          sliderReverb.value = cfg.reverb.toString();
          valReverb.textContent = `${Math.round(cfg.reverb * 100)}%`;
        }

        // Preset active state
        presetChips.forEach((chip) => {
          const pName = chip.getAttribute('data-preset');
          chip.classList.toggle('is-active', pName === activePresetName);
        });
      };

      // Initialize UI state
      updateMuteUI();
      syncControlsToConfig(sound.config.preset || 'chimes');

      // Panel toggling
      const togglePanel = (show?: boolean) => {
        if (!synthPanel || !synthToggleBtn) return;
        const shouldShow = typeof show === 'boolean' ? show : synthPanel.hidden;
        synthPanel.hidden = !shouldShow;
        synthToggleBtn.setAttribute('aria-expanded', shouldShow ? 'true' : 'false');
        synthToggleBtn.classList.toggle('is-active', shouldShow);
        if (shouldShow) {
          sound.initContext();
        }
      };

      synthToggleBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        togglePanel();
      });

      synthCloseBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        togglePanel(false);
      });

      synthPanel?.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          togglePanel(false);
          synthToggleBtn?.focus();
        }
      });

      // Mute toggle inside popover
      synthMuteBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        sound.setMuted(!sound.isMuted());
        updateMuteUI();
        if (!sound.isMuted()) {
          sound.initContext();
          sound.playTone(523.25, 3);
        }
      });

      // Quick Presets
      presetChips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const presetName = chip.getAttribute('data-preset');
          if (!presetName || !PRESETS[presetName]) return;
          const patch = PRESETS[presetName];
          Object.assign(sound.config, patch);
          sound.config.preset = presetName;
          sound.saveConfig();
          sound.updateEffectNodes();
          syncControlsToConfig(presetName);
          sound.playTone(523.25, 3);
        });
      });

      // Wave selector
      waveRadios.forEach((radio) => {
        radio.addEventListener('change', () => {
          if (radio.checked) {
            sound.config.wave = radio.value as OscillatorType;
            delete sound.config.preset;
            sound.saveConfig();
            presetChips.forEach((c) => c.classList.remove('is-active'));
            sound.playTone(523.25, 3);
          }
        });
      });

      // Slider binding helper
      const bindSlider = (
        slider: HTMLInputElement | null,
        label: HTMLElement | null,
        formatFn: (val: number) => string,
        onUpdate: (val: number) => void
      ) => {
        if (!slider) return;
        const handleInput = () => {
          const val = parseFloat(slider.value);
          if (label) label.textContent = formatFn(val);
          onUpdate(val);
          delete sound.config.preset;
          presetChips.forEach((c) => c.classList.remove('is-active'));
        };
        slider.addEventListener('input', handleInput);
        slider.addEventListener('change', () => {
          handleInput();
          sound.saveConfig();
          sound.updateEffectNodes();
          sound.playTone(523.25, 3);
        });
      };

      bindSlider(sliderAttack, valAttack, (v) => `${Math.round(v * 1000)}ms`, (v) => (sound.config.attack = v));
      bindSlider(sliderDecay, valDecay, (v) => `${v.toFixed(2)}s`, (v) => (sound.config.decay = v));
      bindSlider(sliderSustain, valSustain, (v) => `${Math.round(v * 100)}%`, (v) => (sound.config.sustain = v));
      bindSlider(sliderEcho, valEcho, (v) => `${Math.round(v * 100)}%`, (v) => {
        sound.config.echo = v;
        sound.updateEffectNodes();
      });
      bindSlider(sliderReverb, valReverb, (v) => `${Math.round(v * 100)}%`, (v) => {
        sound.config.reverb = v;
        sound.updateEffectNodes();
      });

      // Test Preview Note
      testBtn?.addEventListener('click', () => {
        sound.initContext();
        sound.playTone(587.33, 4);
      });

      // Reset defaults
      resetBtn?.addEventListener('click', () => {
        sound.config = { ...DEFAULT_CONFIG, muted: sound.isMuted() };
        sound.saveConfig();
        sound.updateEffectNodes();
        syncControlsToConfig('chimes');
        sound.playTone(523.25, 3);
      });

      // Unlock and warm up audio on initial user interaction (gestures, hover, or scroll)
      const unlockAudio = () => {
        const ctx = sound.initContext();
        if (ctx && ctx.state === 'suspended') {
          ctx.resume().catch(() => {});
        }
      };

      const interactionEvents: (keyof DocumentEventMap)[] = ['pointerdown', 'keydown', 'touchstart', 'click', 'pointermove', 'scroll'];
      interactionEvents.forEach((evt) => {
        document.addEventListener(evt, unlockAudio, { passive: true });
      });

      // Proactively initialize audio when cursor approaches the activity section
      const activitySection = document.querySelector('.github-activity');
      activitySection?.addEventListener('pointerenter', unlockAudio, { passive: true });
      activitySection?.addEventListener('mouseenter', unlockAudio, { passive: true });
      activitySection?.addEventListener('pointermove', unlockAudio, { passive: true });
      activitySection?.addEventListener('pointerdown', unlockAudio, { passive: true });

      // Heatmap cell hover & click handling
      let lastCellKey = '';
      const handleCellTrigger = (target: EventTarget | null) => {
        const cell = (target as Element | null)?.closest?.('.gh-cell');
        if (!cell) return;

        const wIndex = parseInt(cell.getAttribute('data-week') || '-1', 10);
        const dayIndex = parseInt(cell.getAttribute('data-day') || '-1', 10);
        const count = parseInt(cell.getAttribute('data-count') || '0', 10);
        const level = parseInt(cell.getAttribute('data-level') || '0', 10);

        if (wIndex < 0 || dayIndex < 0) return;

        const cellKey = `${wIndex}-${dayIndex}`;
        if (cellKey === lastCellKey) return;

        lastCellKey = cellKey;
        sound.playNote(wIndex, dayIndex, count, level);
      };

      const heatmapScroll = document.querySelector('.heatmap-scroll');
      if (heatmapScroll) {
        heatmapScroll.addEventListener('pointerover', (e: Event) => {
          handleCellTrigger(e.target);
        });
        heatmapScroll.addEventListener('pointermove', (e: Event) => {
          handleCellTrigger(e.target);
        });
        heatmapScroll.addEventListener('pointerdown', (e: Event) => {
          sound.initContext();
          handleCellTrigger(e.target);
        });
        heatmapScroll.addEventListener('click', (e: Event) => {
          sound.initContext();
          handleCellTrigger(e.target);
        });
        heatmapScroll.addEventListener('pointerleave', () => {
          lastCellKey = '';
        });
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeatmapAudio);
    } else {
      initHeatmapAudio();
    }
  </script>
</section>

<style>
  :root {
    --gh-level-0: #dfd8cc;
    --gh-level-1: #f0a389;
    --gh-level-2: #d65d3a;
    --gh-level-3: #a33314;
    --gh-level-4: #5e1906;
  }

  :global(html.dark) {
    --gh-level-0: #222428;
    --gh-level-1: #3d231b;
    --gh-level-2: #733725;
    --gh-level-3: #c05435;
    --gh-level-4: #e06b47;
  }

  .github-activity {
    margin-top: 48px;
  }

  .activity-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .activity-header h2 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.25;
    margin: 4px 0 0;
    color: var(--ink);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0;
  }
  .heatmap-bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    margin-top: 10px;
  }
  .heatmap-sound-btn,
  .profile-link {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 28px;
    box-sizing: border-box;
    padding: 0 10px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    color: var(--ink-muted);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 4px;
    text-decoration: none;
    cursor: pointer;
