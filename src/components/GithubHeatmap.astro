---
import githubData from '../data/github-contributions.json';

interface Props {
  /** Optional custom section class */
  class?: string;
}

const { class: className = '' } = Astro.props;

const { stats, calendar, username } = githubData;

// Format numbers with commas (e.g., 5,639)
const formatNumber = (n: number) => n.toLocaleString('en-US');

// Heatmap dimensions & layout constants
const CELL_SIZE = 10;
const CELL_GAP = 3;
const STEP = CELL_SIZE + CELL_GAP; // 13px per column/row
const X_OFFSET = 30; // space on left for Mon, Wed, Fri labels
const Y_OFFSET = 20; // space on top for Month labels

const weeks = calendar.weeks;
const totalWeeks = weeks.length;
const svgWidth = X_OFFSET + totalWeeks * STEP;
const svgHeight = Y_OFFSET + 7 * STEP;

// Calculate month label positions (first week where a new month appears)
interface MonthLabel {
  name: string;
  x: number;
}
const monthLabels: MonthLabel[] = [];
let lastMonth = -1;
const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

weeks.forEach((week, wIndex) => {
  const firstValidDay = week.contributionDays[0];
  if (firstValidDay) {
    const d = new Date(firstValidDay.date);
    const m = d.getUTCMonth();
    if (m !== lastMonth) {
      // Ensure there is room to print (at least 2 weeks apart from previous label)
      const prev = monthLabels[monthLabels.length - 1];
      const x = X_OFFSET + wIndex * STEP;
      if (!prev || x - prev.x >= 24) {
        monthLabels.push({ name: monthNames[m]!, x });
        lastMonth = m;
      }
    }
  }
});

// Quartile color level mappings (0 to 4)
const levelClassMap: Record<string, string> = {
  NONE: 'gh-cell-0',
  FIRST_QUARTILE: 'gh-cell-1',
  SECOND_QUARTILE: 'gh-cell-2',
  THIRD_QUARTILE: 'gh-cell-3',
  FOURTH_QUARTILE: 'gh-cell-4',
};

const formatDate = (dateStr: string) => {
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
};

// Flatten all days to compute advanced statistics
const allDays = weeks.flatMap((w) => w.contributionDays);

// 1. Peak / Busiest day
let peakDay = { count: 0, date: '' };
for (const day of allDays) {
  if (day.contributionCount > peakDay.count) {
    peakDay = { count: day.contributionCount, date: day.date };
  }
}
const peakDateFormatted = peakDay.date ? formatDate(peakDay.date) : '';

// 2. Trailing 7 days (this week)
const last7Days = allDays.slice(-7);
const thisWeekTotal = last7Days.reduce((sum, d) => sum + d.contributionCount, 0);

// 3. Current streak (consecutive days with contributions > 0)
let currentStreak = 0;
for (let i = allDays.length - 1; i >= 0; i--) {
  if (allDays[i]!.contributionCount > 0) {
    currentStreak++;
  } else {
    if (i === allDays.length - 1) continue;
    break;
  }
}

// 4. Daily average for current month
const daysPassedInMonth = Math.max(1, new Date().getUTCDate());
const dailyAvgThisMonth = (stats.thisMonth.contributions / daysPassedInMonth).toFixed(1);

// 5. Account history span
const startYear = 2013;
const currentYear = new Date().getUTCFullYear();
const yearsActive = currentYear - startYear;
---

<section class={`github-activity section-block ${className}`}>
  <div class="activity-header">
    <div>
      <p class="eyebrow">Vanity Metrics</p>
      <h2>{formatNumber(calendar.totalContributions)} contributions in the last year</h2>
    </div>
    <div class="activity-header-actions">
      <button
        id="heatmap-sound-toggle"
        class="heatmap-sound-btn"
        type="button"
        aria-label="Toggle contribution chime sounds"
        title="Toggle contribution chime sounds"
      >
        <span class="sound-icon sound-icon-on" aria-hidden="true">🔊</span>
        <span class="sound-icon sound-icon-off" aria-hidden="true" style="display: none;">🔇</span>
        <span class="sound-label">Chimes</span>
      </button>
      <a
        href={`https://github.com/${username}`}
        target="_blank"
        rel="noopener noreferrer"
        class="profile-link"
        aria-label={`View @${username} on GitHub`}
      >
        <svg class="github-icon" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>@{username}</span>
        <span class="external-arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>

  {/* Stats Cards: This Week, This Month, This Year, All Time */}
  <div class="stats-grid">
    <div class="stat-card">
      <span class="stat-label">This Week</span>
      <span class="stat-value">{formatNumber(thisWeekTotal)}</span>
      <span class="stat-detail">{currentStreak}-day active streak</span>
    </div>

    <div class="stat-card">
      <span class="stat-label">This Month</span>
      <span class="stat-value">{formatNumber(stats.thisMonth.contributions)}</span>
      <span class="stat-detail">~{dailyAvgThisMonth} / day avg</span>
    </div>

    <div class="stat-card">
      <span class="stat-label">This Year</span>
      <span class="stat-value">{formatNumber(stats.thisYear.contributions)}</span>
      <span class="stat-detail">Peak: {peakDay.count} on {peakDateFormatted}</span>
    </div>

    <div class="stat-card">
      <span class="stat-label">All Time</span>
      <span class="stat-value">{formatNumber(stats.allTime.contributions)}</span>
      <span class="stat-detail">{yearsActive} years · since {startYear}</span>
    </div>
  </div>

  {/* Heatmap Card */}
  <div class="heatmap-card">
    <div class="heatmap-scroll" tabindex="0" role="region" aria-label="GitHub contribution calendar">
      <svg
        viewBox={`0 0 ${svgWidth} ${svgHeight}`}
        class="heatmap-svg"
        role="img"
        aria-label={`GitHub contribution heatmap for @${username}`}
      >
        {/* Month labels */}
        {
          monthLabels.map((m) => (
            <text x={m.x} y={12} class="label-month">
              {m.name}
            </text>
          ))
        }

        {/* Day of week labels: Mon (1), Wed (3), Fri (5) */}
        <text x={2} y={Y_OFFSET + 1 * STEP + 8} class="label-weekday">
          Mon
        </text>
        <text x={2} y={Y_OFFSET + 3 * STEP + 8} class="label-weekday">
          Wed
        </text>
        <text x={2} y={Y_OFFSET + 5 * STEP + 8} class="label-weekday">
          Fri
        </text>

        {/* Contribution cells */}
        {
          weeks.map((week, wIndex) => {
            const x = X_OFFSET + wIndex * STEP;
            const weekTotal = week.contributionDays.reduce((sum, d) => sum + d.contributionCount, 0);
            const weekMaxLevel = week.contributionDays.reduce((max, d) => {
              const lvlNum = d.contributionLevel === 'FOURTH_QUARTILE' ? 4 :
                             d.contributionLevel === 'THIRD_QUARTILE' ? 3 :
                             d.contributionLevel === 'SECOND_QUARTILE' ? 2 :
                             d.contributionLevel === 'FIRST_QUARTILE' ? 1 : 0;
              return Math.max(max, lvlNum);
            }, 0);
            return (
              <g
                class="heatmap-week"
                data-week-index={wIndex}
                data-total={weekTotal}
                data-max-level={weekMaxLevel}
              >
                {/* Full column hitbox for effortless scrubbing */}
                <rect
                  x={x - 1.5}
                  y={Y_OFFSET}
                  width={STEP}
                  height={7 * STEP}
                  fill="transparent"
                  class="heatmap-column-hitbox"
                  aria-hidden="true"
                />
                {week.contributionDays.map((day) => {
                  const y = Y_OFFSET + day.weekday * STEP;
                  const levelClass = levelClassMap[day.contributionLevel] || 'gh-cell-0';
                  const levelNum = day.contributionLevel === 'FOURTH_QUARTILE' ? 4 :
                                 day.contributionLevel === 'THIRD_QUARTILE' ? 3 :
                                 day.contributionLevel === 'SECOND_QUARTILE' ? 2 :
                                 day.contributionLevel === 'FIRST_QUARTILE' ? 1 : 0;
                  const titleText = `${day.contributionCount} contribution${day.contributionCount === 1 ? '' : 's'} on ${formatDate(day.date)}`;
                  return (
                    <rect
                      x={x}
                      y={y}
                      width={CELL_SIZE}
                      height={CELL_SIZE}
                      rx={2}
                      ry={2}
                      class={`gh-cell ${levelClass}`}
                      data-week={wIndex}
                      data-day={day.weekday}
                      data-date={day.date}
                      data-count={day.contributionCount}
                      data-level={levelNum}
                    >
                      <title>{titleText}</title>
                    </rect>
                  );
                })}
              </g>
            );
          })
        }
      </svg>
    </div>

    {/* Footer: Explanatory note & Legend */}
    <div class="heatmap-footer">
      <span class="footer-note">
        Verified GitHub activity across public and client repositories. None of this measures code quality.
      </span>
      <div class="heatmap-legend" role="group" aria-label="Activity legend">
        <span class="legend-text">Out of tokens</span>
        <div class="legend-cells" aria-hidden="true">
          <span class="legend-cell gh-cell-0"></span>
          <span class="legend-cell gh-cell-1"></span>
          <span class="legend-cell gh-cell-2"></span>
          <span class="legend-cell gh-cell-3"></span>
          <span class="legend-cell gh-cell-4"></span>
        </div>
        <span class="legend-text">Approaching deadline</span>
      </div>
    </div>
  </div>

  <script>
    // Maintain initial scroll position at the recent right edge
    const scroll = document.querySelector('.heatmap-scroll');
    if (scroll) {
      scroll.scrollLeft = scroll.scrollWidth;
    }

    // Extended pentatonic scale across 5 octaves (zero dissonance, beautiful chime timbre)
    const PENTATONIC = [
      130.81, // C3
      146.83, // D3
      164.81, // E3
      196.00, // G3
      220.00, // A3
      261.63, // C4
      293.66, // D4
      329.63, // E4
      392.00, // G4
      440.00, // A4
      523.25, // C5
      587.33, // D5
      659.25, // E5
      783.99, // G5
      880.00, // A5
      1046.50, // C6
      1174.66, // D6
      1318.51, // E6
      1567.98, // G6
      1760.00, // A6
      2093.00, // C7
      2349.32, // D7
      2637.02  // E7
    ];

    class HeatmapSoundEngine {
      private ctx: AudioContext | null = null;
      private compressor: DynamicsCompressorNode | null = null;
      private muted: boolean;

      constructor() {
        const reducedMotion = typeof window !== 'undefined' && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.muted = reducedMotion || (typeof window !== 'undefined' && localStorage.getItem('heatmap_sound') === 'muted');
      }

      public initContext(): AudioContext | null {
        if (!this.ctx && typeof window !== 'undefined') {
          const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
          if (AudioCtx) {
            this.ctx = new AudioCtx();
            // Create dynamics compressor to prevent clipping on rapid glissandos
            this.compressor = this.ctx.createDynamicsCompressor();
            this.compressor.threshold.setValueAtTime(-18, this.ctx.currentTime);
            this.compressor.knee.setValueAtTime(12, this.ctx.currentTime);
            this.compressor.ratio.setValueAtTime(8, this.ctx.currentTime);
            this.compressor.attack.setValueAtTime(0.003, this.ctx.currentTime);
            this.compressor.release.setValueAtTime(0.15, this.ctx.currentTime);
            this.compressor.connect(this.ctx.destination);
          }
        }
        if (this.ctx && this.ctx.state === 'suspended') {
          this.ctx.resume().catch(() => {});
        }
        return this.ctx;
      }

      public isMuted(): boolean {
        return this.muted;
      }

      public setMuted(muted: boolean) {
        this.muted = muted;
        try {
          localStorage.setItem('heatmap_sound', muted ? 'muted' : 'unmuted');
        } catch {}
      }

      public playNote(weekIndex: number, weekday: number, count: number, level: number) {
        // Muted or empty cell: pure silence!
        if (this.muted || count === 0 || level === 0) return;

        const ctx = this.initContext();
        if (!ctx || ctx.state === 'suspended' || !this.compressor) return;

        try {
          const now = ctx.currentTime;

          // 2D harmonious pentatonic mapping:
          // - Horizontal (week 0..52): base scale traversal across time (~14 steps)
          // - Vertical (weekday 0..6: Sun=0 to Sat=6): steps scale degrees vertically (bottom = lower, top = higher)
          const weekBase = Math.round((weekIndex / 52) * 14);
          const dayOffset = 6 - weekday;
          const noteIndex = Math.min(PENTATONIC.length - 1, Math.max(0, weekBase + dayOffset));
          const baseFreq = PENTATONIC[noteIndex] || 440;

          // Velocity and envelope based on contribution level
          const baseVol = 0.04 + (level / 4) * 0.12;
          const decay = 0.24 + level * 0.035;

          // Primary sine wave fundamental
          const osc1 = ctx.createOscillator();
          const gain1 = ctx.createGain();
          osc1.type = 'sine';
          osc1.frequency.setValueAtTime(baseFreq, now);

          gain1.gain.setValueAtTime(0.0001, now);
          gain1.gain.exponentialRampToValueAtTime(baseVol, now + 0.004);
          gain1.gain.exponentialRampToValueAtTime(0.0001, now + decay);

          osc1.connect(gain1);
          gain1.connect(this.compressor);
          osc1.start(now);
          osc1.stop(now + decay + 0.02);

          // Warm harmonic overtone (octave chime) for medium+ activity
          if (level >= 2) {
            const osc2 = ctx.createOscillator();
            const gain2 = ctx.createGain();
            osc2.type = 'triangle';
            osc2.frequency.setValueAtTime(baseFreq * 2, now);

            gain2.gain.setValueAtTime(0.0001, now);
            gain2.gain.exponentialRampToValueAtTime(baseVol * 0.3, now + 0.003);
            gain2.gain.exponentialRampToValueAtTime(0.0001, now + decay * 0.7);

            osc2.connect(gain2);
            gain2.connect(this.compressor);
            osc2.start(now);
            osc2.stop(now + decay * 0.7 + 0.02);
          }

          // High activity fifth harmonic (sparkling chime chord) for peak weeks
          if (level === 4) {
            const osc3 = ctx.createOscillator();
            const gain3 = ctx.createGain();
            osc3.type = 'sine';
            osc3.frequency.setValueAtTime(baseFreq * 1.5, now);

            gain3.gain.setValueAtTime(0.0001, now);
            gain3.gain.exponentialRampToValueAtTime(baseVol * 0.22, now + 0.005);
            gain3.gain.exponentialRampToValueAtTime(0.0001, now + decay * 0.85);

            osc3.connect(gain3);
            gain3.connect(this.compressor);
            osc3.start(now);
            osc3.stop(now + decay * 0.85 + 0.02);
          }
        } catch {}
      }
    }

    function initHeatmapAudio() {
      const sound = new HeatmapSoundEngine();
      const soundBtn = document.getElementById('heatmap-sound-toggle');

      const updateSoundUI = () => {
        const isMuted = sound.isMuted();
        const iconOn = soundBtn?.querySelector('.sound-icon-on') as HTMLElement | null;
        const iconOff = soundBtn?.querySelector('.sound-icon-off') as HTMLElement | null;
        if (iconOn && iconOff) {
          iconOn.style.display = isMuted ? 'none' : 'inline';
          iconOff.style.display = isMuted ? 'inline' : 'none';
        }
        if (soundBtn) {
          soundBtn.classList.toggle('is-muted', isMuted);
          soundBtn.setAttribute('aria-label', isMuted ? 'Unmute contribution chime sounds' : 'Mute contribution chime sounds');
          soundBtn.setAttribute('title', isMuted ? 'Unmute contribution chime sounds' : 'Mute contribution chime sounds');
        }
      };

      updateSoundUI();

      soundBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        sound.setMuted(!sound.isMuted());
        updateSoundUI();
        if (!sound.isMuted()) {
          sound.initContext();
        }
      });

      // Unlock audio on initial user interaction
      const unlockAudio = () => {
        sound.initContext();
        window.removeEventListener('pointerdown', unlockAudio);
        window.removeEventListener('keydown', unlockAudio);
      };
      window.addEventListener('pointerdown', unlockAudio, { passive: true });
      window.addEventListener('keydown', unlockAudio, { passive: true });

      // 2D cell hover handling (horizontal + vertical + diagonal)
      let lastCellKey = '';

      const handleCellTrigger = (target: EventTarget | null) => {
        const cell = (target as Element | null)?.closest?.('.gh-cell');
        if (!cell) return;

        const wIndex = parseInt(cell.getAttribute('data-week') || '-1', 10);
        const dayIndex = parseInt(cell.getAttribute('data-day') || '-1', 10);
        const count = parseInt(cell.getAttribute('data-count') || '0', 10);
        const level = parseInt(cell.getAttribute('data-level') || '0', 10);

        if (wIndex < 0 || dayIndex < 0) return;

        const cellKey = `${wIndex}-${dayIndex}`;
        if (cellKey === lastCellKey) return;
        lastCellKey = cellKey;

        sound.playNote(wIndex, dayIndex, count, level);
      };

      const heatmapSvg = document.querySelector('.heatmap-svg');
      if (heatmapSvg) {
        heatmapSvg.addEventListener('pointerover', (e: Event) => {
          handleCellTrigger(e.target);
        });

        // Smooth scrubbing on mobile touch
        heatmapSvg.addEventListener('pointermove', (e: Event) => {
          handleCellTrigger(e.target);
        });

        heatmapSvg.addEventListener('pointerleave', () => {
          lastCellKey = '';
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeatmapAudio);
    } else {
      initHeatmapAudio();
    }
  </script>
</section>

<style>
  :root {
    --gh-level-0: #dfd8cc;
    --gh-level-1: #f0a389;
    --gh-level-2: #d65d3a;
    --gh-level-3: #a33314;
    --gh-level-4: #5e1906;
  }

  :global(html.dark) {
    --gh-level-0: #222428;
    --gh-level-1: #3d231b;
    --gh-level-2: #733725;
    --gh-level-3: #c05435;
    --gh-level-4: #e06b47;
  }

  .github-activity {
    margin-top: 48px;
  }

  .activity-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }

  .activity-header h2 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.25;
    margin: 4px 0 0;
    color: var(--ink);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0;
  }
  .activity-header-actions {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .heatmap-sound-btn,
  .profile-link {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 28px;
    box-sizing: border-box;
    padding: 0 10px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    color: var(--ink-muted);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 4px;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .heatmap-sound-btn:hover,
  .profile-link:hover {
    color: var(--accent);
    border-color: var(--accent-soft);
  }

  .heatmap-sound-btn.is-muted {
    opacity: 0.65;
  }

  .sound-icon {
    font-size: 0.75rem;
    line-height: 1;
  }

  .sound-label {
    font-size: 0.75rem;
    line-height: 1;
  }

  .github-icon {
    flex-shrink: 0;
  }

  .external-arrow {
    font-size: 0.75rem;
    line-height: 1;
  }
  /* Stats grid */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 16px;
  }

  @media (max-width: 860px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }
  }

  @media (max-width: 480px) {
    .stats-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    padding: 14px 16px;
    background: var(--sunk);
    border: 1px solid var(--rule);
    border-radius: 4px;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 4px;
  }

  .stat-value {
    font-family: var(--font-mono);
    font-size: 1.625rem;
    font-weight: 600;
    line-height: 1.15;
    color: var(--ink);
    letter-spacing: -0.02em;
  }
  .stat-detail {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--ink-muted);
    margin-top: 6px;
  }
  /* Heatmap card container */
  .heatmap-card {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 16px;
  }

  .heatmap-scroll {
    overflow-x: auto;
    padding-bottom: 6px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: var(--rule) transparent;
  }

  .heatmap-svg {
    display: block;
    width: 100%;
    min-width: 680px;
    height: auto;
  }

  .label-month,
  .label-weekday {
    font-family: var(--font-mono);
    font-size: 9px;
    fill: var(--ink-muted);
    user-select: none;
  }

  .heatmap-week {
    cursor: pointer;
  }

  .heatmap-column-hitbox {
    pointer-events: none;
  }

  .gh-cell {
    transition: opacity 0.1s ease, filter 0.1s ease;
    cursor: pointer;
  }

  .gh-cell:hover {
    stroke: var(--ink);
    stroke-width: 1px;
