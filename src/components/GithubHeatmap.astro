---
import githubData from '../data/github-contributions.json';
import { formatShortDate } from '../lib/format-date';
import { computeHeatmapStats, formatNumber } from '../lib/heatmap-stats';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
const { stats, calendar, username } = githubData;

const CELL_SIZE = 10;
const STEP = 13;
const X_OFFSET = 30;
const Y_OFFSET = 20;
const ROWS = 7;
const MOBILE_WEEKS = 21;
const MONTH_LABEL_WIDTH = 24;
const FIRST_ACTIVE_YEAR = 2013;
const MONTH_NAMES = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const WEEKDAY_LABELS: [string, number][] = [['Mon', 1], ['Wed', 3], ['Fri', 5]];
const LEVELS: Record<string, number> = {
  NONE: 0,
  FIRST_QUARTILE: 1,
  SECOND_QUARTILE: 2,
  THIRD_QUARTILE: 3,
  FOURTH_QUARTILE: 4,
};

const PRESET_OPTIONS = [
  { id: 'chimes', label: 'Chimes' },
  { id: 'bit', label: '8-Bit' },
  { id: 'pad', label: 'Pad' },
  { id: 'cosmic', label: 'Cosmic' },
];
const MOOD_OPTIONS = [
  { id: 'bright', label: 'Bright' },
  { id: 'moody', label: 'Moody' },
  { id: 'mystic', label: 'Mystic' },
];

const formatDate = (dateStr: string) => formatShortDate(new Date(dateStr));

const weeks = calendar.weeks;
const days = weeks.flatMap((week) => week.contributionDays);
const initialStats = computeHeatmapStats(days.map((day) => ({ date: day.date, count: day.contributionCount })));
const yearsActive = Number(days.at(-1)!.date.slice(0, 4)) - FIRST_ACTIVE_YEAR;

type Week = (typeof weeks)[number];

function monthLabelsFor(layoutWeeks: Week[], width: number) {
  const labels: { name: string; x: number }[] = [];

  layoutWeeks.forEach((week, index) => {
    const firstOfMonth = week.contributionDays.find((day) => day.date.endsWith('-01'));
    const x = X_OFFSET + index * STEP;
    const previous = labels.at(-1);
    const hasRoom = x + MONTH_LABEL_WIDTH <= width && (!previous || x - previous.x >= MONTH_LABEL_WIDTH);

    if (firstOfMonth && hasRoom) {
      labels.push({ name: MONTH_NAMES[Number(firstOfMonth.date.slice(5, 7)) - 1]!, x });
    }
  });

  return labels;
}

const layouts = [
  { id: 'desktop', weeks, firstWeek: 0, label: `GitHub contribution heatmap for @${username}` },
  {
    id: 'mobile',
    weeks: weeks.slice(-MOBILE_WEEKS),
    firstWeek: weeks.length - MOBILE_WEEKS,
    label: `GitHub contribution heatmap for @${username} (recent activity)`,
  },
].map((layout) => {
  const width = X_OFFSET + layout.weeks.length * STEP;

  return { ...layout, width, monthLabels: monthLabelsFor(layout.weeks, width) };
});

const svgHeight = Y_OFFSET + ROWS * STEP;

// Which key centre a week plays in is picked from its middle day's month.
const chordOf = (week: Week) => Number((week.contributionDays[3] ?? week.contributionDays[0])!.date.slice(5, 7)) % 4;
---

<section class={`github-activity section-block ${className}`}>
  <div class="activity-header">
    <p class="eyebrow">Vanity Metrics</p>
    <h2><span data-stat="total"><span class="stat-number">{formatNumber(initialStats.values.total)}</span></span> contributions in the last year</h2>
  </div>

  <div class="stats-grid" data-all-time={stats.allTime.contributions}>
    <div class="stat-card">
      <span class="stat-label">Last 7 days</span>
      <span class="stat-value" data-stat="last7"><span class="stat-number">{formatNumber(initialStats.values.last7)}</span></span>
      <span class="stat-detail" data-stat-detail="streak">{initialStats.details.streak}</span>
    </div>

    <div class="stat-card">
      <span class="stat-label">This Month</span>
      <span class="stat-value" data-stat="month"><span class="stat-number">{formatNumber(initialStats.values.month)}</span></span>
      <span class="stat-detail" data-stat-detail="average">{initialStats.details.average}</span>
    </div>

    <div class="stat-card">
      <span class="stat-label">This Year</span>
      <span class="stat-value" data-stat="year"><span class="stat-number">{formatNumber(initialStats.values.year)}</span></span>
      <span class="stat-detail" data-stat-detail="peak">{initialStats.details.peak}</span>
    </div>

    <div class="stat-card">
      <span class="stat-label">All Time</span>
      <span class="stat-value" data-stat="all"><span class="stat-number">{formatNumber(stats.allTime.contributions)}</span></span>
      <span class="stat-detail">{yearsActive} years · since {FIRST_ACTIVE_YEAR}</span>
    </div>
  </div>

  <div
    class="heatmap-card"
    data-step={STEP}
    data-x-offset={X_OFFSET}
    data-y-offset={Y_OFFSET}
    data-cell-size={CELL_SIZE}
    data-mobile-first-week={layouts[1]!.firstWeek}
  >
    <div class="heatmap-stage">
      <div class="heatmap-scroll" tabindex="0" role="region" aria-label="GitHub contribution calendar">
        {
          layouts.map((layout) => (
            <svg
              viewBox={`0 0 ${layout.width} ${svgHeight}`}
              class={`heatmap-svg heatmap-svg--${layout.id}`}
              role="img"
              aria-label={layout.label}
              data-first-week={layout.firstWeek}
            >
              <rect
                class="playhead"
                x={X_OFFSET - 1.5}
                y={Y_OFFSET - 1.5}
                width={STEP}
                height={ROWS * STEP}
                rx="3"
                aria-hidden="true"
              />

              {layout.monthLabels.map((month) => (
                <text x={month.x} y={12} class="label-axis">
                  {month.name}
                </text>
              ))}

              {WEEKDAY_LABELS.map(([name, weekday]) => (
                <text x={2} y={Y_OFFSET + weekday * STEP + 8} class="label-axis">
                  {name}
                </text>
              ))}

              {layout.weeks.map((week, index) => {
                const x = X_OFFSET + index * STEP;
                const weekIndex = layout.firstWeek + index;
                const chord = chordOf(week);

                return week.contributionDays.map((day) => {
                  const level = LEVELS[day.contributionLevel] ?? 0;
                  const noun = day.contributionCount === 1 ? 'contribution' : 'contributions';

                  return (
                    <rect
                      x={x}
                      y={Y_OFFSET + day.weekday * STEP}
                      width={CELL_SIZE}
                      height={CELL_SIZE}
                      rx="2"
                      class={`gh-cell gh-cell-${level}`}
                      data-week={weekIndex}
                      data-day={day.weekday}
                      data-level={level}
                      data-chord={chord}
                      data-count={day.contributionCount}
                      data-date={day.date}
                    >
                      <title>{`${day.contributionCount} ${noun} on ${formatDate(day.date)}`}</title>
                    </rect>
                  );
                });
              })}

              <g class="game-layer" aria-hidden="true"></g>
            </svg>
          ))
        }
      </div>

      <div class="game-overlay" data-state="idle" hidden>
        <p class="game-title" data-game="title"></p>
        <p class="game-summary" data-game="summary"></p>
        <button type="button" class="btn btn--primary" data-action="game-primary">
          <svg class="game-icon-play" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 3.5v17L21 12z"></path></svg>
          <span data-game="primary-label">Start</span>
        </button>
        <p class="game-instruction">
          <span class="game-instruction--pointer"></span>
          <span class="game-instruction--touch"></span>
        </p>
      </div>

      <p class="game-announcer" data-game="announcer" aria-live="polite"></p>
    </div>
    <div class="heatmap-bar">
      <div class="game-hud">
        <span class="game-score">Score <strong data-game="score">0</strong> · Best <strong data-game="best">0</strong><span class="game-lives"> · <strong data-game="lives" role="img">●●●</strong></span></span>
        <button type="button" class="btn btn--icon game-pause" data-game="pause" aria-label="Pause">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="5" y="4" width="4.5" height="16" rx="1"></rect><rect x="14.5" y="4" width="4.5" height="16" rx="1"></rect></svg>
        </button>
        <button type="button" class="btn btn--icon" data-action="sound" aria-pressed="true" aria-label="Sound">
          <svg class="icon-sound-on" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4z"></path><path d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14"></path></svg>
          <svg class="icon-sound-off" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4z"></path><path d="m22 9-6 6M16 9l6 6"></path></svg>
        </button>
      </div>

      <button id="breakout-toggle" class="btn" type="button" aria-pressed="false">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 20h10"></path>
          <circle cx="17" cy="6" r="1.8" fill="currentColor"></circle>
          <path d="M15.6 8.4 12 14"></path>
        </svg>
        <span>Breakout</span>
      </button>

      <button id="snake-toggle" class="btn" type="button" aria-pressed="false">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 5H10a4 4 0 0 0 0 8h4a4 4 0 0 1 0 8H5"></path>
          <circle cx="19" cy="5" r="1.4" fill="currentColor"></circle>
        </svg>
        <span>Snake</span>
      </button>

      <button id="synth-toggle" class="btn" type="button" aria-expanded="false" aria-controls="synth-panel">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"></path>
        </svg>
        <span>Synth</span>
        <span class="chevron" aria-hidden="true">▾</span>
      </button>

      <a href={`https://github.com/${username}`} target="_blank" rel="noopener noreferrer" class="btn btn--github" aria-label={`View @${username} on GitHub`}>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"></path>
        </svg>
        <span class="github-name">@{username}</span>
        <span class="github-name" aria-hidden="true">↗</span>
      </a>
    </div>

    <div id="synth-panel" class="synth-panel" role="region" aria-label="Tone synthesizer" hidden>
      <div class="synth-actions">
        <button type="button" class="btn btn--primary" data-action="play" aria-label="Play the year">
          <svg class="icon-play" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 3.5v17L21 12z"></path></svg>
          <svg class="icon-stop" width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="5" y="5" width="14" height="14" rx="1.5"></rect></svg>
          <span data-play-label>Play</span>
        </button>
        <button type="button" class="btn" data-action="sound" aria-pressed="true">
          <span class="sound-dot" aria-hidden="true"></span>
          <span data-sound-label>Sound on</span>
        </button>
        <span class="synth-progress" data-progress aria-hidden="true"></span>
        <button type="button" class="synth-close" data-action="close" aria-label="Close synthesizer">✕</button>
      </div>

      <div class="synth-controls">
        <fieldset class="synth-group">
          <legend>Preset</legend>
          {
            PRESET_OPTIONS.map((option) => (
              <label class="chip">
                <input type="radio" name="preset" value={option.id} />
                <span>{option.label}</span>
              </label>
            ))
          }
        </fieldset>

        <fieldset class="synth-group">
          <legend>Mood</legend>
          {
            MOOD_OPTIONS.map((option) => (
              <label class="chip">
                <input type="radio" name="mood" value={option.id} />
                <span>{option.label}</span>
              </label>
            ))
          }
        </fieldset>

        <label class="synth-slider">
          <span class="synth-slider-name">Tempo</span>
          <output data-output="tempo"></output>
          <input type="range" name="tempo" min="60" max="180" step="5" />
        </label>

        <label class="synth-slider">
          <span class="synth-slider-name">Space</span>
          <output data-output="space"></output>
          <input type="range" name="space" min="0" max="1" step="0.05" />
        </label>
      </div>

      <p class="synth-hint">Hover or drag across the grid to play days. Rows are notes, darker days sound brighter. Press Play to hear the whole year.</p>
    </div>

    <div class="heatmap-footer">
      <span class="footer-note">
        Verified GitHub activity across public and client repositories. None of this measures code quality.
      </span>
      <div class="heatmap-legend" role="group" aria-label="Activity legend">
        <span>Out of tokens</span>
        <div class="legend-cells" aria-hidden="true">
          {[0, 1, 2, 3, 4].map((level) => <span class={`legend-cell gh-cell-${level}`}></span>)}
        </div>
        <span>Approaching deadline</span>
      </div>
    </div>
  </div>

  <script>
    import { initHeatmap } from '../scripts/heatmap';

    initHeatmap(document.querySelector<HTMLElement>('.heatmap-card')!);
  </script>
</section>

<style>
  :root {
    --gh-level-0: #dfd8cc;
    --gh-level-1: #f0a389;
    --gh-level-2: #d65d3a;
    --gh-level-3: #a33314;
    --gh-level-4: #5e1906;
    --snake-body: #4f8f2f;
    --snake-outline: #2f5e1a;
    --snake-marks: #356b20;
    --snake-eye: #ffffff;
    --snake-pupil: #151515;
    --snake-tongue: #d6342c;
  }

  :global(html.dark) {
    --gh-level-0: #222428;
    --gh-level-1: #3d231b;
    --gh-level-2: #733725;
    --gh-level-3: #c05435;
    --gh-level-4: #e06b47;
    --snake-body: #66b13a;
    --snake-outline: #25521a;
    --snake-marks: #3f8a24;
  }

  .gh-cell-0 { --level: var(--gh-level-0); }
  .gh-cell-1 { --level: var(--gh-level-1); }
  .gh-cell-2 { --level: var(--gh-level-2); }
  .gh-cell-3 { --level: var(--gh-level-3); }
  .gh-cell-4 { --level: var(--gh-level-4); }

  .github-activity {
    margin-top: 48px;
    font-family: var(--font-mono);
  }

  .activity-header {
    margin-bottom: 20px;
  }

  .activity-header h2 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.25;
    margin: 4px 0 0;
    color: var(--ink);
  }

  .eyebrow {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin: 0;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 16px;
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    padding: 14px 16px;
    background: var(--sunk);
    border: 1px solid var(--rule);
    border-radius: 4px;
  }

  .stat-label {
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 4px;
  }

  [data-stat] {
    position: relative;
  }

  .stat-value {
    align-self: flex-start;
    font-size: 1.625rem;
    font-weight: 600;
    line-height: 1.15;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .stat-detail {
    font-size: 0.6875rem;
    color: var(--ink-muted);
    margin-top: 6px;
  }

  .heatmap-card {
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 16px;
  }

  .heatmap-scroll {
    overflow-x: auto;
    padding-bottom: 6px;
    scrollbar-width: thin;
    scrollbar-color: var(--rule) transparent;
  }

  /* While a game runs a finger swipes the grid to steer, so the page must not pan under it. */
  .is-game-running .heatmap-scroll {
    touch-action: none;
  }

  /* While the synth is open a finger drags across cells to play them. Only vertical panning stays native. */
  .is-synth-open .heatmap-scroll {
    touch-action: pan-y;
  }

  .heatmap-svg {
    width: 100%;
    height: auto;
  }

  .heatmap-svg--desktop {
    display: block;
    min-width: 680px;
  }

  .heatmap-svg--mobile {
    display: none;
  }

  /* Breakout needs both walls on screen, so the desktop board shrinks to the card instead of scrolling. */
  .heatmap-card[data-active-game="breakout"] .heatmap-svg--desktop {
    min-width: 0;
  }

  .label-axis {
    font-family: var(--font-mono);
    font-size: 9px;
    fill: var(--ink-muted);
    user-select: none;
  }

  .gh-cell {
    fill: var(--level);
    transform-box: fill-box;
    transform-origin: center;
  }

  .gh-cell:hover {
    stroke: var(--ink);
    stroke-width: 1px;
  }

  .playhead {
    fill: var(--accent);
    opacity: 0;
  }

  .game-layer {
    pointer-events: none;
  }

  .game-layer :global(.breakout-paddle) {
    fill: var(--ink);
  }

  .game-layer :global(.breakout-ball) {
    fill: var(--accent);
    stroke: var(--paper);
    stroke-width: 0.8px;
  }

  .game-layer :global(path) {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .game-layer :global(.snake-outline) {
    stroke: var(--snake-outline);
    stroke-width: 9.5px;
  }

  .game-layer :global(.snake-body) {
    stroke: var(--snake-body);
    stroke-width: 8px;
  }

  /* A dash period equal to the step puts one marking on every segment. */
  .game-layer :global(.snake-marks) {
    stroke: var(--snake-marks);
    stroke-width: 4px;
    stroke-dasharray: 3px 10px;
    stroke-dashoffset: 1.5px;
  }

  .game-layer :global(.snake-tail-outline) {
    stroke: var(--snake-outline);
    stroke-width: 7px;
  }

  .game-layer :global(.snake-tail-body) {
    stroke: var(--snake-body);
    stroke-width: 5.5px;
  }

  .game-layer :global(.snake-lump-outlines .snake-lump) {
    fill: var(--snake-outline);
  }

  .game-layer :global(.snake-lump-fills .snake-lump) {
    fill: var(--snake-body);
  }

  .game-layer :global(.snake-head-shape) {
    fill: var(--snake-body);
    stroke: var(--snake-outline);
    stroke-width: 1.2px;
  }

  .game-layer :global(.snake-jaw) {
    transform-box: fill-box;
    transform-origin: center;
  }

  .game-layer :global(.snake-eye) {
    fill: var(--snake-eye);
    stroke: var(--snake-outline);
    stroke-width: 0.4px;
  }

  .game-layer :global(.snake-pupil) {
    fill: var(--snake-pupil);
  }

  .game-layer :global(.snake-tongue) {
    stroke: var(--snake-tongue);
    stroke-width: 1.1px;
    transform-box: fill-box;
    transform-origin: left center;
  }

  .is-game-over .heatmap-svg {
    filter: grayscale(1);
    opacity: 0.45;
  }

  /* Created on the body while a touch run is going, so a finger anywhere steers and the page cannot scroll. */
  :global(.game-touch-pad) {
    position: fixed;
    inset: 0;
    z-index: 100;
    touch-action: none;
    overscroll-behavior: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    -webkit-tap-highlight-color: transparent;
  }

  :global(.stat-float) {
    position: absolute;
    top: 0;
    left: 100%;
    margin-left: 6px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--accent);
    white-space: nowrap;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .playhead {
      transition: transform 0.12s linear, opacity 0.2s ease;
    }

    .is-playing .playhead {
      opacity: 0.2;
    }

    .gh-cell.is-eaten {
      animation: eat-pop 0.35s ease-out;
    }

    .game-layer :global(.snake-tongue) {
      animation: tongue-flick 2.4s ease-in-out infinite;
    }

    .game-layer.is-dying {
      animation: snake-blink 0.6s step-end;
    }

    .heatmap-svg {
      transition: filter 0.3s ease, opacity 0.3s ease;
    }
  }

  @keyframes tongue-flick {
    0%,
    78%,
    100% {
      transform: scaleX(0);
    }

    84%,
    92% {
      transform: scaleX(1);
    }
  }

  @keyframes snake-blink {
    0%,
    33.3%,
    66.6%,
    100% {
      opacity: 1;
    }

    16.6%,
    50%,
