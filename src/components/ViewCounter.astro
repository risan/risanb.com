---
interface Props {
  slug: string;
}

const { slug } = Astro.props;
---

<span class="post-views post-meta-pill" data-slug={slug} title="Total page views">
  <svg
    class="view-eye-svg"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
    <circle cx="12" cy="12" r="3"></circle>
  </svg>
  <span class="view-count-text"></span>
</span>

<script>
  import { fetchStats, postStatsEvent } from '../lib/stats-api';

  async function initViewCounter() {
    const el = document.querySelector<HTMLElement>('.post-views[data-slug]');
    const textEl = el?.querySelector<HTMLElement>('.view-count-text');
    const slug = el?.dataset.slug;

    if (!el || !textEl || !slug) {
      return;
    }

    // One recorded view per browser session, so reloads don't inflate the count.
    const sessionKey = `viewed:${slug}`;
    let alreadyViewed = false;

    try {
      alreadyViewed = sessionStorage.getItem(sessionKey) !== null;
    } catch {}

    const stats = alreadyViewed
      ? await fetchStats(slug)
      : await postStatsEvent('views', { slug, referrer: document.referrer });

    if (!stats?.views || stats.views <= 0) {
      return;
    }

    textEl.textContent = `${stats.views.toLocaleString('en-US')} view${stats.views === 1 ? '' : 's'}`;
    el.classList.add('is-loaded');

    try {
      sessionStorage.setItem(sessionKey, '1');
    } catch {}
  }

  initViewCounter();
</script>

<style>
  .post-views {
    display: none;
    gap: 6px;
    cursor: default;
  }

  .post-views.is-loaded {
    display: inline-flex;
    align-items: center;
  }

  .view-eye-svg {
    color: var(--ink-muted);
    flex-shrink: 0;
  }
</style>
