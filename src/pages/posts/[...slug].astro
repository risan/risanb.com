---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getPosts, postSlug } from '../../lib/posts';

export async function getStaticPaths() {
  // Newest first — this ordering defines prev/next navigation.
  const posts = await getPosts();

  return posts.map((post, i) => ({
    params: { slug: postSlug(post) },
    props: {
      post,
      // Array is newest-first, so the previous post in time is at i + 1.
      prev: posts[i + 1],
      next: posts[i - 1],
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);

// Reading time from the raw markdown body rather than the rendered HTML, so the
// estimate doesn't count code blocks' markup as prose.
const wordCount = post.body?.split(/\s+/).filter(Boolean).length ?? 0;
---

<PostLayout {post} {headings} {wordCount} {prev} {next}>
  <Content />
</PostLayout>
