---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, type Post } from '../../lib/posts';

const posts = await getPosts();

const byYear = new Map<number, Post[]>();
for (const post of posts) {
  const year = post.data.date.getUTCFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
---

<BaseLayout
  title="Archive | Risan Bagja"
  description="Tutorials and notes on web development, tooling, and the things I break along the way."
>
  <div class="page-head">
    <h1>Archive</h1>
    <p class="lede">
      All notes, tutorials, and articles on web development, tooling, and programming.{' '}
      {posts.length} posts published.
    </p>
  </div>

  {
    [...byYear.entries()].map(([year, yearPosts]) => (
      <section class="year-group">
        <h2>{year}</h2>
        <PostList posts={yearPosts} />
      </section>
    ))
  }
</BaseLayout>
