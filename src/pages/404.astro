---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | Risan Bagja" description="That page does not exist.">
  <div class="notfound">
    <p class="code">404</p>
    <h1>That page isn’t here</h1>
    <p style="margin-top:22px;color:var(--ink-muted)">
      The link may be out of date, or I may have moved something without leaving a note.
    </p>
    <p class="eyebrow" style="margin-top:32px">
      <a href="/">Home</a>
      <span class="dot">·</span>
      <a href="/code/">All posts</a>
      <span class="dot">·</span>
      <a href="/tags/">Tags</a>
    </p>
  </div>
</BaseLayout>
