---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, groupByTerm } from '../../lib/posts';

export async function getStaticPaths() {
  const groups = groupByTerm(await getPosts(), 'categories');

  return [...groups.entries()].map(([category, entries]) => ({
    params: { category },
    props: { category, entries },
  }));
}

const { category, entries } = Astro.props;
const categoryName = category.charAt(0).toUpperCase() + category.slice(1);

const categoryHooks: Record<string, string> = {
  tutorial:
    'Hands-on, step-by-step guides and deep dives into tools, libraries, and architecture. Designed to take you from concept to working software.',
  log: 'Field notes from the workshop—tool migrations, configuration experiments, and postmortems of bugs that took a little too long to solve.',
  snippet:
    'Concise, battle-tested solutions to specific problems—the handy tricks and snippets you write once and keep reaching back for.',
};
---

<BaseLayout title={`${categoryName} | Risan Bagja`} description={`Posts filed under ${categoryName}.`}>
  <div class="page-head">
    <h1>{categoryName}</h1>
    {categoryHooks[category] && <p class="category-hook">{categoryHooks[category]}</p>}
    <p class="lede">{entries.length} {entries.length === 1 ? 'post' : 'posts'}.</p>
  </div>
  <section class="section-block">
    <PostList posts={entries} />
  </section>
</BaseLayout>
