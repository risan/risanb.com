---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, groupByTerm } from '../../lib/posts';

const groups = groupByTerm(await getPosts(), 'categories');
const sorted = [...groups.entries()].sort(
  (a, b) => b[1].length - a[1].length || a[0].localeCompare(b[0]),
);
---

<BaseLayout title="Categories | Risan Bagja" description="Browse posts by category.">
  <div class="page-head">
    <h1>Categories</h1>
  </div>

  <section class="section-block">
    <h2>{sorted.length} categories</h2>
    <ul class="entry-list">
      {
        sorted.map(([name, posts]) => (
          <li>
            <a href={`/categories/${name}/`}>
              <span class="title">{name}</span>
              <span class="meta">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
