---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('code');

const terms = new Map<string, number>();
for (const post of posts) {
  for (const t of post.data.tags) terms.set(t, (terms.get(t) ?? 0) + 1);
}
const sorted = [...terms.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<BaseLayout title="Tags | Risan Bagja" description="Browse posts by tag.">
  <div class="page-head">
    <h1>Tags</h1>
    <p class="lede">{sorted.length} tags across all posts.</p>
  </div>

  <section class="section-block">
    <div class="tag-cloud">
      {
        sorted.map(([name, count]) => (
          <a href={`/tags/${name}/`} class="tag-pill tag-pill--lg">
            <span class="tag-name">#{name}</span>
            <span class="tag-count">{count}</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
