---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('code');

const terms = new Map<string, number>();
for (const post of posts) {
  for (const t of post.data.tags) terms.set(t, (terms.get(t) ?? 0) + 1);
}
const sorted = [...terms.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title="Tags | Risan Bagja" description="Browse posts by tag.">
  <div class="page-head">
    <h1>Tags</h1>
  </div>

  <section class="section-block">
    <h2>{sorted.length} tags</h2>
    <ul class="entry-list">
      {
        sorted.map(([name, count]) => (
          <li>
            <a href={`/tags/${name}/`}>
              <span class="title">{name}</span>
              <span class="meta">{count} {count === 1 ? 'post' : 'posts'}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
