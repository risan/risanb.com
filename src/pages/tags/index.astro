---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TagCloud from '../../components/TagCloud.astro';
import { getPosts, groupByTerm } from '../../lib/posts';

const tags = groupByTerm(await getPosts(), 'tags');
---

<BaseLayout title="Tags | Risan Bagja" description="Browse posts by tag.">
  <div class="page-head">
    <h1>Tags</h1>
    <p class="lede">{tags.size} tags across all posts.</p>
  </div>

  <section class="section-block">
    <TagCloud groups={tags} />
  </section>
</BaseLayout>
