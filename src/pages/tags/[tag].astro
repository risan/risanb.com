---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TechIcon from '../../components/TechIcon.astro';
import { getPostIcon } from '../../lib/tech-icons';

type Post = CollectionEntry<'code'>;

export async function getStaticPaths() {
  const posts = await getCollection('code');

  const terms = new Map<string, Post[]>();
  for (const post of posts) {
    for (const t of post.data.tags) {
      const bucket = terms.get(t);
      if (bucket) bucket.push(post);
      else terms.set(t, [post]);
    }
  }

  return [...terms.entries()].map(([tag, entries]) => ({
    params: { tag },
    props: {
      tag,
      entries: entries.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }));
}

const { tag, entries } = Astro.props;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout title={`${tag} | Risan Bagja`} description={`Posts tagged ${tag}.`}>
  <div class="page-head">
    <p class="eyebrow">
      <a href="/tags/">← All tags</a>
    </p>
    <h1>{tag}</h1>
    <p class="lede">{entries.length} {entries.length === 1 ? 'post' : 'posts'}.</p>
  </div>

  <section class="section-block">
    <ul class="entry-list entry-list--compact">
      {
        entries.map((post) => (
          <li>
            <a href={`/posts/${post.id.replace(/\/index$/, '')}/`}>
              <span class="title"><TechIcon name={getPostIcon(post)} />{post.data.title}</span>
              <span class="meta">{fmt(post.data.date)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
