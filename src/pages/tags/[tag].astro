---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, groupByTerm } from '../../lib/posts';

export async function getStaticPaths() {
  const groups = groupByTerm(await getPosts(), 'tags');

  return [...groups.entries()].map(([tag, entries]) => ({
    params: { tag },
    props: { tag, entries },
  }));
}

const { tag, entries } = Astro.props;
---

<BaseLayout title={`${tag} | Risan Bagja`} description={`Posts tagged ${tag}.`}>
  <div class="page-head">
    <p class="eyebrow">
      <a href="/tags/">← All tags</a>
    </p>
    <h1>{tag}</h1>
    <p class="lede">{entries.length} {entries.length === 1 ? 'post' : 'posts'}.</p>
  </div>

  <section class="section-block">
    <PostList posts={entries} />
  </section>
</BaseLayout>
