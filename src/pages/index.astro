---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('code')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const featured = posts.filter((p) => p.data.featured).slice(0, 6);
const recent = posts.slice(0, 6);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });

const href = (id: string) => `/posts/${id.replace(/\/index$/, '')}/`;
---

<BaseLayout
  title="Risan Bagja"
  description="Tutorials and notes on web development, tooling, and the things I break along the way."
>
  <div class="home-intro">
    <h1>Notes on building for the web</h1>
    <p>
      Hi, I’m Risan. I build software for a living. It started in junior high, when I got bored of
      Flash games and picked up a Borland Delphi 6 book. I followed the tutorials and made a simple
      text editor. Then I wanted to make something else.
    </p>
    <p>
      I published my early software as RdF, short for &ldquo;Reason da Freak.&rdquo; It was
      supposed to sound like &ldquo;Risan the Freak.&rdquo; Don&rsquo;t judge me.
    </p>
    <p>
      Since then, I’ve built websites for clients, worked with startups on their products, and
      helped companies make sense of their data. I enjoy turning a rough idea into working
      software, including figuring out the details that didn’t come up in the first conversation.
      I also take care of getting it deployed and keeping it running.
    </p>
    <p>
      These days, AI agents do most of the typing. I work out what to build, make the architectural
      decisions, and check that the result does what it’s supposed to. I also build workflows for
      agents to plan, code, test, and review each other’s work. Years of building and maintaining
      software help me spot missing requirements, question unnecessary complexity, and decide
      where a closer look is needed. Sometimes the most useful contribution is asking whether we
      need another moving part.
    </p>
    <p>
      I still love playing with the computer. This site is where I write down what I learn: web
      development tutorials, experiments with agents, and things that took longer to figure out
      than I’d like to admit. Hopefully, something here saves you an afternoon.
    </p>
  </div>

  <div class="home-columns">
    {
      featured.length > 0 && (
        <section class="section-block">
          <h2>Featured</h2>
          <ul class="entry-list entry-list--compact">
            {featured.map((post) => (
              <li>
                <a href={href(post.id)}>
                  <span class="title">{post.data.title}</span>
                  <span class="meta">{fmt(post.data.date)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="section-block">
      <h2>Recent</h2>
      <ul class="entry-list entry-list--compact">
        {
          recent.map((post) => (
            <li>
              <a href={href(post.id)}>
                <span class="title">{post.data.title}</span>
                <span class="meta">{fmt(post.data.date)}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="eyebrow" style="margin-top: 20px;">
        <a href="/posts/">All {posts.length} posts →</a>
      </p>
    </section>
  </div>
</BaseLayout>
