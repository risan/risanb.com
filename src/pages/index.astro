---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('code')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const featured = posts.filter((p) => p.data.featured);
const recent = posts.slice(0, 8);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });

const href = (id: string) => `/code/${id.replace(/\/index$/, '')}/`;
---

<BaseLayout
  title="Risan Bagja"
  description="Tutorials and notes on web development, tooling, and the things I break along the way."
>
  <div class="home-intro">
    <h1>Notes on building for the web</h1>
    <p>
      I write code for a living and break things on purpose to learn how they work. This is
      where the technical notes live — mostly JavaScript, PHP, and the tooling in between.
      {posts.length} articles and tutorials published so far.
    </p>
  </div>

  <div class="home-columns">
    {
      featured.length > 0 && (
        <section class="section-block">
          <h2>Featured</h2>
          <ul class="entry-list entry-list--compact">
            {featured.map((post) => (
              <li>
                <a href={href(post.id)}>
                  <span class="title">{post.data.title}</span>
                  <span class="meta">{fmt(post.data.date)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="section-block">
      <h2>Recent</h2>
      <ul class="entry-list entry-list--compact">
        {
          recent.map((post) => (
            <li>
              <a href={href(post.id)}>
                <span class="title">{post.data.title}</span>
                <span class="meta">{fmt(post.data.date)}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="eyebrow" style="margin-top: 20px;">
        <a href="/code/">All {posts.length} posts →</a>
      </p>
    </section>
  </div>
</BaseLayout>
