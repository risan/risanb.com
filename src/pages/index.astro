---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import GithubHeatmap from '../components/GithubHeatmap.astro';
import Clippy from '../components/Clippy.astro';
import TechIcon from '../components/TechIcon.astro';
import risanPhoto from '../assets/risan.webp';
const posts = (await getCollection('code')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const featured = posts.filter((p) => p.data.featured).slice(0, 6);
const recent = posts.slice(0, 6);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'UTC' });

const href = (id: string) => `/posts/${id.replace(/\/index$/, '')}/`;

const terms = new Map<string, number>();
for (const post of posts) {
  for (const t of post.data.tags) terms.set(t, (terms.get(t) ?? 0) + 1);
}
const sortedTags = [...terms.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<BaseLayout
  title="Risan Bagja"
  description="Tutorials and notes on web development, tooling, and the things I break along the way."
>
  <div class="home-intro">
    <h1>Code, <span id="curiosity-trigger" class="curiosity-trigger is-shimmering" role="button" tabindex="0" aria-label="Curiosity (click to summon Clippy)" title="Click to summon something curious...">curiosity</span>, and a questionable number of agents</h1>

    <div class="home-intro-spread">
      <p>
        Hi, I’m Risan. I build software for a living. It started in junior high, when I got bored with
        Flash games and picked up a book about Borland Delphi 6. I followed the tutorials and made a simple
        text editor. Then I wanted to make something else.
      </p>
      <p>
        I published some of my early software as RdF, short for &ldquo;Reason da Freak.&rdquo; It was
        supposed to sound like &ldquo;Risan the Freak.&rdquo; Don&rsquo;t judge me.
      </p>
      <p>
        Since then, I’ve built websites for clients, worked with startups on their products, and
        helped companies make sense of their data. I enjoy turning a rough idea into working software
        and sorting out all the details that never make it into the first conversation. I usually
        stay with a project through deployment and whatever happens once real people start using it.
      </p>
      <p>
        These days, building software feels less like sitting at an editor and more like running a very
        busy control room. AI agents research the problem, argue over the approach, write the code,
        test it, and review one another’s work. I designed the rules and checkpoints that keep the whole
        thing moving in the right direction. Most of the time, I watch it unfold, provide context when
        needed, and adjust the workflow based on what goes wrong. It’s a strange way to build software,
        and I’m having a lot of fun figuring it out.
      </p>

      <figure class="home-intro-figure">
        <Image
          src={risanPhoto}
          alt="Risan Bagja looking out the train window"
          class="home-intro-photo"
          loading="eager"
          fetchpriority="high"
          widths={[380, 520, 760, 1176]}
          sizes="(max-width: 768px) 100vw, 540px"
        />
        <figcaption class="home-intro-caption">I only go out when my Claude Code usage has drained out completely.</figcaption>
      </figure>

      <p>
        I’m usually tinkering with something on the side too: maps, small web apps, ESP32 boards,
        sensors, or whatever else has caught my attention. This site is where I write down what I learn,
        including the things that took longer to figure out than I’d like to admit. Hopefully, something
        here saves you an afternoon.
      </p>
    </div>
  </div>

  <div class="home-columns">
    {
      featured.length > 0 && (
        <section class="section-block">
          <h2>Featured</h2>
          <ul class="entry-list entry-list--compact">
            {featured.map((post) => (
              <li>
                <a href={href(post.id)}>
                  <span class="title">{post.data.title}</span>
                  <span class="meta">{fmt(post.data.date)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="section-block">
      <h2>Recent</h2>
      <ul class="entry-list entry-list--compact">
        {
          recent.map((post) => (
            <li>
              <a href={href(post.id)}>
                <span class="title">{post.data.title}</span>
                <span class="meta">{fmt(post.data.date)}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="eyebrow" style="margin-top: 20px;">
        <a href="/posts/">All {posts.length} posts →</a>
      </p>

    </section>
  </div>

  <section class="section-block">
    <h2>Tag Clouds</h2>
    <div class="tag-cloud">
      {
        sortedTags.map(([name, count]) => (
          <a href={`/tags/${name}/`} class="tag-pill tag-pill--lg">
            <TechIcon name={name} />
            <span class="tag-name">#{name}</span>
            <span class="tag-count">{count}</span>
          </a>
        ))
      }
    </div>
  </section>

  <GithubHeatmap />
  <Clippy />

<style>
  .home-intro-spread {
    margin-top: 28px;
  }

  @media (min-width: 768px) {
    .home-intro-spread {
      columns: 2;
      column-gap: 52px;
      margin-top: 36px;
    }
  }

  .home-intro-spread p {
    margin: 20px 0 0;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--ink);
  }

  .home-intro-spread p:first-of-type {
    margin-top: 0;
  }

  .home-intro-spread p:first-of-type::first-letter {
    initial-letter: 2;
    -webkit-initial-letter: 2;
    float: left;
    font-family: var(--font-serif);
    font-size: 3.4rem;
    line-height: 0.85;
    font-weight: 500;
    color: var(--accent);
    margin: 0.04em 0.14em 0 0;
  }

  .home-intro-figure {
    break-inside: avoid;
    margin: 24px 0;
  }

  .home-intro-photo {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: center 63%;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--sunk);
  }

  .home-intro-caption {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--ink-muted);
    text-align: center;
    margin-top: 10px;
    padding: 0 8px;
  }

  .curiosity-trigger {
    position: relative;
    display: inline-block;
    cursor: pointer;
    font-weight: inherit;
    font-family: inherit;
    user-select: none;
    border-radius: 4px;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), text-shadow 0.2s ease;
  }

  .curiosity-trigger:focus-visible {
    outline: 2px solid var(--accent, #c8502e);
    outline-offset: 4px;
  }

  .curiosity-trigger.is-shimmering {
    color: var(--accent, #c8502e);
    background: linear-gradient(
      110deg,
      var(--accent, #c8502e) 0%,
      var(--accent, #c8502e) 26%,
      #e8734e 38%,
      #f5b842 50%,
      #e8734e 62%,
      var(--accent, #c8502e) 74%,
      var(--accent, #c8502e) 100%
    );
    background-size: 240% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: curiosity-shimmer 3s infinite linear;
    text-decoration: none;
  }

  :global(.dark) .curiosity-trigger.is-shimmering {
    color: var(--accent, #e06b47);
    background: linear-gradient(
      110deg,
      var(--accent, #e06b47) 0%,
      var(--accent, #e06b47) 26%,
      #f08b68 38%,
      #ffd166 50%,
      #f08b68 62%,
      var(--accent, #e06b47) 74%,
      var(--accent, #e06b47) 100%
    );
    background-size: 240% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .curiosity-trigger.is-shimmering:hover {
    transform: translateY(-1px);
    filter: drop-shadow(0 2px 8px rgba(200, 80, 46, 0.3));
  }
  .curiosity-trigger.is-active {
    background: none !important;
    -webkit-text-fill-color: currentColor !important;
    animation: none !important;
    text-shadow: none !important;
    cursor: default !important;
    text-decoration: none !important;
    transform: none !important;
  }

  @keyframes curiosity-shimmer {
    0% {
      background-position: 140% 0;
    }
    100% {
      background-position: -140% 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .curiosity-trigger.is-shimmering {
      animation: none !important;
      background: none !important;
      -webkit-text-fill-color: var(--accent, #c8502e) !important;
    }
  }
</style>
</BaseLayout>
