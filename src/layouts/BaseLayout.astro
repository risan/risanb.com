---
import '../styles/global.css';
import SearchModal from '../components/SearchModal.vue';
interface Props {
  title: string;
  description?: string | undefined;
  lang?: string | undefined;
  /** Social/OG image, absolute site path. */
  ogImage?: string | undefined;
  /** Page type for OG. */
  ogType?: 'article' | 'website' | undefined;
  /** ISO date, for article:published_time. */
  published?: string | undefined;
  /** Explicit active nav path (e.g. for post matching category). */
  activeNav?: string | undefined;
}

const DEFAULT_OG_IMAGE = '/img/risan-og.jpg';

const {
  title,
  description,
  lang = 'en',
  ogImage = DEFAULT_OG_IMAGE,
  ogType = 'website',
  published,
  activeNav,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(ogImage, Astro.site);
const nav = [
  { href: '/categories/tutorial/', label: 'Tutorial' },
  { href: '/categories/log/', label: 'Log' },
  { href: '/categories/snippet/', label: 'Snippet' },
  { href: '/about/', label: 'About' },
  { href: '/posts/', label: 'Archive' },
] as const;
const isCurrent = (href: string) => {
  if (activeNav) {
    return activeNav === href;
  }

  return Astro.url.pathname === href;
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Risan Bagja" />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonical} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={socialImage} />
    {published && <meta property="article:published_time" content={published} />}

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Risan Bagja"
      href={new URL('/rss.xml', Astro.site)}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script is:inline>
      (() => {
        let stored = null;

        try {
          stored = localStorage.getItem('theme');
        } catch {}

        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

        if (stored ? stored === 'dark' : prefersDark) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body>
    <div id="reading-progress" class="reading-progress" aria-hidden="true"></div>

    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site">
      <div class="wrap bar">
        <a class="brand" href="/">
          <span>Risan Bagja</span>
        </a>
        <div class="bar-right">
          <nav class="top" aria-label="Primary">
            {
              nav.map((item) => (
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              ))
            }
            <a href="https://blog.risanb.com">Blog</a>
            <a href="/rss.xml">RSS</a>
          </nav>

          <div class="nav-actions">
            <button
              class="search-btn"
              type="button"
              data-search-open
              aria-label="Search (Command K)"
              title="Search (⌘K)"
            >
              <svg
                class="search-icon"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <span class="search-kbd">⌘K</span>
            </button>

            <button
              class="theme-toggle"
              type="button"
              id="theme-toggle"
              aria-label="Toggle color theme"
              title="Toggle color theme"
            >
              <svg
                class="sun-icon"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2"></path>
                <path d="M12 20v2"></path>
                <path d="m4.93 4.93 1.41 1.41"></path>
                <path d="m17.66 17.66 1.41 1.41"></path>
                <path d="M2 12h2"></path>
                <path d="M20 12h2"></path>
                <path d="m6.34 17.66-1.41 1.41"></path>
                <path d="m19.07 4.93-1.41 1.41"></path>
              </svg>
              <svg
                class="moon-icon"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
              </svg>
            </button>

            <button
              class="menu-toggle"
              type="button"
              id="menu-toggle"
              aria-expanded="false"
              aria-controls="mobile-nav"
              aria-label="Toggle navigation menu"
            >
              <svg
                class="menu-icon-bars"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
              <svg
                class="menu-icon-close"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div id="mobile-nav" class="mobile-nav" hidden>
        <div class="wrap">
          <nav class="mobile-nav-links" aria-label="Mobile Navigation">
            {
              nav.map((item) => (
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              ))
            }
            <a href="https://blog.risanb.com">Blog</a>
            <a href="/rss.xml">RSS</a>
          </nav>
        </div>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap bar">
        <span>© Risan Bagja {new Date().getFullYear()}</span>
        <nav aria-label="Elsewhere">
          <a href="https://github.com/risan">GitHub</a>
          <a href="https://blog.risanb.com">Blog</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </footer>

    {/* client:idle, not client:load: the index is fetched on first open, so
        hydration only has to register the keyboard shortcut. */}
    <SearchModal client:idle />

    <script>
      document.getElementById('theme-toggle')?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');

        try {
          localStorage.setItem('theme', isDark ? 'dark' : 'light');
        } catch {}
      });

      const menuButton = document.getElementById('menu-toggle');
      const mobileNav = document.getElementById('mobile-nav');

      if (menuButton && mobileNav) {
        const setMenuOpen = (isOpen: boolean) => {
          menuButton.setAttribute('aria-expanded', String(isOpen));
          menuButton.classList.toggle('is-active', isOpen);
          mobileNav.hidden = !isOpen;
        };

        menuButton.addEventListener('click', () => {
          setMenuOpen(menuButton.getAttribute('aria-expanded') !== 'true');
        });

        mobileNav.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => setMenuOpen(false));
        });
      }

      // Easter egg: the Windows XP startup sound when hovering the Windows tag.
      const XP_SOUND_COOLDOWN_MS = 2500;
      let xpSound: HTMLAudioElement | null = null;
      let lastPlayedAt = 0;

      const getXpSound = () => {
        if (!xpSound) {
          xpSound = new Audio('/sounds/windows-xp-startup.mp3');
          xpSound.volume = 0.5;
        }

        return xpSound;
      };

      const playXpSound = () => {
        const now = Date.now();

        if (now - lastPlayedAt < XP_SOUND_COOLDOWN_MS) {
          return;
        }

        lastPlayedAt = now;

        const sound = getXpSound();
        sound.currentTime = 0;
        sound.play().catch(() => {});
      };

      document
        .querySelectorAll('a[href*="/tags/windows"], .tech-icon[data-tech="windows"]')
        .forEach((el) => {
          el.addEventListener('mouseenter', playXpSound);
          el.addEventListener('pointerenter', () => getXpSound().load(), { once: true });
        });

      const progressBar = document.getElementById('reading-progress');

      if (progressBar) {
        const updateProgress = () => {
          const doc = document.documentElement;
          const scrollable = doc.scrollHeight - doc.clientHeight;
          const ratio = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
          progressBar.style.transform = `scaleX(${ratio})`;
        };

        window.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();
      }
    </script>
  </body>
</html>
