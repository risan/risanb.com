---
import '../styles/global.css';
import SearchModal from '../components/SearchModal.vue';

interface Props {
  title: string;
  description?: string | undefined;
  lang?: string | undefined;
  /** Social/OG image, absolute site path (Hugo's `images:` frontmatter). */
  ogImage?: string | undefined;
  /** Page type for OG. */
  ogType?: 'article' | 'website' | undefined;
  /** ISO date, for article:published_time. */
  published?: string | undefined;
}

const {
  title,
  description,
  lang = 'en',
  ogImage,
  ogType = 'website',
  published,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = ogImage ? new URL(ogImage, Astro.site) : undefined;
const nav = [
  { href: '/categories/tutorial/', label: 'Tutorial' },
  { href: '/categories/log/', label: 'Log' },
  { href: '/categories/snippet/', label: 'Snippet' },
  { href: '/tags/', label: 'Tags' },
  { href: '/about/', label: 'About' },
  { href: '/posts/', label: 'Archive' },
] as const;
const isCurrent = (href: string) => Astro.url.pathname.startsWith(href);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonical} />
    {description && <meta property="og:description" content={description} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {published && <meta property="article:published_time" content={published} />}

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Risan Bagja"
      href={new URL('/rss.xml', Astro.site)}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const theme =
          stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body>
    <div id="reading-progress" class="reading-progress" aria-hidden="true"></div>

    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site">
      <div class="wrap bar">
        <a class="brand" href="/">
          <svg class="brand-logo" width="22" height="22" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M4 4C4 2.89543 4.89543 2 6 2H23.5L29 7.5V28C29 29.1046 28.1046 30 27 30H6C4.89543 30 4 29.1046 4 28V4Z" fill="#C8502E"/>
            <rect x="25" y="25.5" width="2" height="2.5" rx="0.5" fill="#141517" opacity="0.4"/>
            <rect x="8" y="2" width="14" height="11" rx="1" fill="#E8E2D5"/>
            <rect x="11.5" y="4.5" width="3.5" height="6.5" rx="0.5" fill="#2C2A26"/>
            <rect x="7" y="16" width="18" height="13" rx="1.5" fill="#FDFBF7"/>
            <path d="M7 17.5C7 16.6716 7.67157 16 8.5 16H23.5C24.3284 16 25 16.6716 25 17.5V19H7V17.5Z" fill="#E28971"/>
            <path d="M11.5 22L9.5 24L11.5 26" stroke="#2C2A26" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M20.5 22L22.5 24L20.5 26" stroke="#2C2A26" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
            <line x1="17" y1="21.5" x2="15" y2="26.5" stroke="#C8502E" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
          <span>Risan Bagja</span>
        </a>
        <nav class="top" aria-label="Primary">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <a href="https://blog.risanb.com">Blog</a>
          <a href="/rss.xml">RSS</a>
          <button class="kbd" type="button" data-search-open aria-label="Search (Command K)">
            ⌘K
          </button>
          <button
            class="theme-toggle"
            type="button"
            id="theme-toggle"
            aria-label="Toggle color theme"
          >
            <svg
              class="sun-icon"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path>
              <path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m6.34 17.66-1.41 1.41"></path>
              <path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
            <svg
              class="moon-icon"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap bar">
        <span>© Risan Bagja {new Date().getFullYear()}</span>
        <nav aria-label="Elsewhere">
          <a href="https://github.com/risan">GitHub</a>
          <a href="https://blog.risanb.com">Blog</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </footer>

    {/* client:idle, not client:load: the palette is worth ~0ms until someone
        actually searches, and the index is fetched on first open rather than on
        hydrate. Astro hydrates this once the browser goes idle. */}
    <SearchModal client:idle />

    <script>
      const themeBtn = document.getElementById('theme-toggle');
      themeBtn?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });

      const progressBar = document.getElementById('reading-progress');
      if (progressBar) {
        const updateProgress = () => {
          const doc = document.documentElement;
          const scrollable = doc.scrollHeight - doc.clientHeight;
          const ratio = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
          progressBar.style.transform = `scaleX(${ratio})`;
        };
        window.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();
      }
    </script>
  </body>
</html>
