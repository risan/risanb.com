---
import '../styles/global.css';
import SearchModal from '../components/SearchModal.vue';

interface Props {
  title: string;
  description?: string | undefined;
  lang?: string | undefined;
  /** Social/OG image, absolute site path (Hugo's `images:` frontmatter). */
  ogImage?: string | undefined;
  /** Page type for OG. */
  ogType?: 'article' | 'website' | undefined;
  /** ISO date, for article:published_time. */
  published?: string | undefined;
}

const {
  title,
  description,
  lang = 'en',
  ogImage,
  ogType = 'website',
  published,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = ogImage ? new URL(ogImage, Astro.site) : undefined;
const nav = [
  { href: '/categories/tutorial/', label: 'Tutorial' },
  { href: '/categories/log/', label: 'Log' },
  { href: '/categories/snippet/', label: 'Snippet' },
  { href: '/tags/', label: 'Tags' },
  { href: '/about/', label: 'About' },
  { href: '/posts/', label: 'Archive' },
] as const;
const isCurrent = (href: string) => Astro.url.pathname.startsWith(href);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonical} />
    {description && <meta property="og:description" content={description} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {published && <meta property="article:published_time" content={published} />}

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Risan Bagja"
      href={new URL('/rss.xml', Astro.site)}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const theme =
          stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body>
    <div id="reading-progress" class="reading-progress" aria-hidden="true"></div>

    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site">
      <div class="wrap bar">
        <a class="brand" href="/">
          <svg class="brand-logo" width="22" height="25" viewBox="0 0 32 36" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
              <linearGradient id="brandClipGrad" x1="6" y1="2" x2="26" y2="34" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#D4DAE3" />
                <stop offset="40%" stop-color="#9BA6B5" />
                <stop offset="70%" stop-color="#BAC3D0" />
                <stop offset="100%" stop-color="#737E8E" />
              </linearGradient>
            </defs>
            <path d="M12 25V13C12 10.7909 13.7909 9 16 9C18.2091 9 20 10.7909 20 13V26C20 29.3137 17.3137 32 14 32C10.6863 32 8 29.3137 8 26V7C8 3.68629 10.6863 1 14 1C17.3137 1 20 3.68629 20 7V22" stroke="url(#brandClipGrad)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M8.8 24V7C8.8 4.1 11.1 1.8 14 1.8C16.9 1.8 19.2 4.1 19.2 7V20" stroke="#FFFFFF" stroke-width="0.8" stroke-linecap="round" opacity="0.85"/>
            <g class="clippy-brows">
              <path d="M10 7.5C11 6.2 13 6.4 14.5 7.2" stroke="#1A1918" stroke-width="1.6" stroke-linecap="round"/>
              <path d="M17.5 6.2C19 5.2 21.2 5.6 22.5 7" stroke="#1A1918" stroke-width="1.6" stroke-linecap="round"/>
            </g>
            <g class="clippy-eyes">
              <ellipse cx="12.5" cy="12.5" rx="3.5" ry="4.2" fill="#FFFFFF" stroke="#1A1918" stroke-width="1"/>
              <circle cx="13" cy="12.8" r="1.8" fill="#1A1918"/>
              <circle cx="12.2" cy="11.8" r="0.65" fill="#FFFFFF"/>
              <ellipse cx="19.5" cy="12" rx="3.5" ry="4.2" fill="#FFFFFF" stroke="#1A1918" stroke-width="1"/>
              <circle cx="19" cy="12.2" r="1.8" fill="#1A1918"/>
              <circle cx="18.2" cy="11.2" r="0.65" fill="#FFFFFF"/>
            </g>
          </svg>
          <span>Risan Bagja</span>
        </a>
        <nav class="top" aria-label="Primary">
          {
            nav.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
          <a href="https://blog.risanb.com">Blog</a>
          <a href="/rss.xml">RSS</a>
          <button class="kbd" type="button" data-search-open aria-label="Search (Command K)">
            ⌘K
          </button>
          <button
            class="theme-toggle"
            type="button"
            id="theme-toggle"
            aria-label="Toggle color theme"
          >
            <svg
              class="sun-icon"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2"></path>
              <path d="M12 20v2"></path>
              <path d="m4.93 4.93 1.41 1.41"></path>
              <path d="m17.66 17.66 1.41 1.41"></path>
              <path d="M2 12h2"></path>
              <path d="M20 12h2"></path>
              <path d="m6.34 17.66-1.41 1.41"></path>
              <path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
            <svg
              class="moon-icon"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap bar">
        <span>© Risan Bagja {new Date().getFullYear()}</span>
        <nav aria-label="Elsewhere">
          <a href="https://github.com/risan">GitHub</a>
          <a href="https://blog.risanb.com">Blog</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </footer>

    {/* client:idle, not client:load: the palette is worth ~0ms until someone
        actually searches, and the index is fetched on first open rather than on
        hydrate. Astro hydrates this once the browser goes idle. */}
    <SearchModal client:idle />

    <script>
      const themeBtn = document.getElementById('theme-toggle');
      themeBtn?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });

      const progressBar = document.getElementById('reading-progress');
      if (progressBar) {
        const updateProgress = () => {
          const doc = document.documentElement;
          const scrollable = doc.scrollHeight - doc.clientHeight;
          const ratio = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
          progressBar.style.transform = `scaleX(${ratio})`;
        };
        window.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();
      }
    </script>
  </body>
</html>
