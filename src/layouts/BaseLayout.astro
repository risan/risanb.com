---
import '../styles/global.css';
import SearchModal from '../components/SearchModal.vue';
interface Props {
  title: string;
  description?: string | undefined;
  lang?: string | undefined;
  /** Social/OG image, absolute site path (Hugo's `images:` frontmatter). */
  ogImage?: string | undefined;
  /** Page type for OG. */
  ogType?: 'article' | 'website' | undefined;
  /** ISO date, for article:published_time. */
  published?: string | undefined;
  /** Explicit active nav path (e.g. for post matching category). */
  activeNav?: string | undefined;
}

const {
  title,
  description,
  lang = 'en',
  ogImage,
  ogType = 'website',
  published,
  activeNav,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = ogImage ? new URL(ogImage, Astro.site) : undefined;
const nav = [
  { href: '/categories/tutorial/', label: 'Tutorial' },
  { href: '/categories/log/', label: 'Log' },
  { href: '/categories/snippet/', label: 'Snippet' },
  { href: '/about/', label: 'About' },
  { href: '/posts/', label: 'Archive' },
] as const;
const isCurrent = (href: string) => {
  if (activeNav) return activeNav === href;
  if (href === '/posts/') {
    return Astro.url.pathname === '/posts/' || Astro.url.pathname.startsWith('/posts/page/');
  }
  return Astro.url.pathname.startsWith(href);
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonical} />
    {description && <meta property="og:description" content={description} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    {published && <meta property="article:published_time" content={published} />}

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Risan Bagja"
      href={new URL('/rss.xml', Astro.site)}
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const theme =
          stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body>
    <div id="reading-progress" class="reading-progress" aria-hidden="true"></div>

    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site">
      <div class="wrap bar">
        <a class="brand" href="/">
          <span>Risan Bagja</span>
        </a>
        <div class="bar-right">
          <nav class="top" aria-label="Primary">
            {
              nav.map((item) => (
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              ))
            }
            <a href="https://blog.risanb.com">Blog</a>
            <a href="/rss.xml">RSS</a>
          </nav>

          <div class="nav-actions">
            <button
              class="search-btn"
              type="button"
              data-search-open
              aria-label="Search (Command K)"
              title="Search (⌘K)"
            >
              <svg
                class="search-icon"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              <span class="search-kbd">⌘K</span>
            </button>

            <button
              class="theme-toggle"
              type="button"
              id="theme-toggle"
              aria-label="Toggle color theme"
              title="Toggle color theme"
            >
              <svg
                class="sun-icon"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2"></path>
                <path d="M12 20v2"></path>
                <path d="m4.93 4.93 1.41 1.41"></path>
                <path d="m17.66 17.66 1.41 1.41"></path>
                <path d="M2 12h2"></path>
                <path d="M20 12h2"></path>
                <path d="m6.34 17.66-1.41 1.41"></path>
                <path d="m19.07 4.93-1.41 1.41"></path>
              </svg>
              <svg
                class="moon-icon"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
              </svg>
            </button>

            <button
              class="menu-toggle"
              type="button"
              id="menu-toggle"
              aria-expanded="false"
              aria-controls="mobile-nav"
              aria-label="Toggle navigation menu"
            >
              <svg
                class="menu-icon-bars"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
              </svg>
              <svg
                class="menu-icon-close"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <div id="mobile-nav" class="mobile-nav" hidden>
        <div class="wrap">
          <nav class="mobile-nav-links" aria-label="Mobile Navigation">
            {
              nav.map((item) => (
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              ))
            }
            <a href="https://blog.risanb.com">Blog</a>
            <a href="/rss.xml">RSS</a>
          </nav>
        </div>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap bar">
        <span>© Risan Bagja {new Date().getFullYear()}</span>
        <nav aria-label="Elsewhere">
          <a href="https://github.com/risan">GitHub</a>
          <a href="https://blog.risanb.com">Blog</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </footer>

    {/* client:idle, not client:load: the palette is worth ~0ms until someone
        actually searches, and the index is fetched on first open rather than on
        hydrate. Astro hydrates this once the browser goes idle. */}
    <SearchModal client:idle />

    <script>
      const themeBtn = document.getElementById('theme-toggle');
      themeBtn?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });

      // Mobile navbar menu toggle
      const menuBtn = document.getElementById('menu-toggle');
      const mobileNav = document.getElementById('mobile-nav');
      if (menuBtn && mobileNav) {
        menuBtn.addEventListener('click', () => {
          const isOpen = menuBtn.getAttribute('aria-expanded') === 'true';
          menuBtn.setAttribute('aria-expanded', String(!isOpen));
          menuBtn.classList.toggle('is-active', !isOpen);
          mobileNav.hidden = isOpen;
        });

        // Auto-close menu on link click
        mobileNav.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            menuBtn.setAttribute('aria-expanded', 'false');
            menuBtn.classList.remove('is-active');
            mobileNav.hidden = true;
          });
        });
      }

      // Windows XP startup sound on hover
      let xpAudio: HTMLAudioElement | null = null;
      let lastPlayTime = 0;
      const playWindowsXpSound = () => {
        const now = Date.now();
        if (now - lastPlayTime < 2500) return;
        lastPlayTime = now;
        try {
          if (!xpAudio) {
            xpAudio = new Audio('/sounds/windows-xp-startup.mp3');
            xpAudio.volume = 0.5;
          } else {
            xpAudio.currentTime = 0;
          }
          xpAudio.play().catch(() => {});
        } catch {}
      };

      const preloadXpAudio = () => {
        if (!xpAudio) {
          xpAudio = new Audio('/sounds/windows-xp-startup.mp3');
          xpAudio.volume = 0.5;
          xpAudio.load();
        }
      };

      const bindWindowsHover = () => {
        const selectors = [
          'a[href*="/tags/windows"]',
          '.tech-icon[data-tech="windows"]'
        ];
        document.querySelectorAll(selectors.join(',')).forEach((el) => {
          el.addEventListener('mouseenter', playWindowsXpSound);
          el.addEventListener('pointerenter', preloadXpAudio, { once: true });
        });
      };
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bindWindowsHover);
      } else {
        bindWindowsHover();
      }

      const progressBar = document.getElementById('reading-progress');
      if (progressBar) {
        const updateProgress = () => {
          const doc = document.documentElement;
          const scrollable = doc.scrollHeight - doc.clientHeight;
          const ratio = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
          progressBar.style.transform = `scaleX(${ratio})`;
        };
        window.addEventListener('scroll', updateProgress, { passive: true });
        updateProgress();
      }
    </script>
  </body>
</html>
